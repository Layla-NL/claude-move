def matches(d, only):
    if not only:
        return True
    title = (d.get("title") or "").lower()
    sid = d.get("sessionId") or ""
    return any(o.lower() in title or sid.startswith(o) or sid.startswith("local_" + o) for o in only)


def cmd_to(args):
    if getattr(args, "app", False) and not args.dry_run:
        args.app = False
        return by_app(args, lambda: cmd_to(args))
    accts = accounts()
    if not accts:
        sys.exit(t("no_root", p=ROOT))
    dst = pick(args.target, accts)
    if args.source:
        src = pick(args.source, accts)
    else:
        others = [a for a in accts if a["dir"] != dst["dir"]]
        if not others:
            sys.exit(t("same"))
        src = max(others, key=lambda a: a["last"])
    if src["dir"] == dst["dir"]:
        sys.exit(t("same"))
    todo = [(f, d) for f, d in active(src, args.days, args.all or bool(args.only)) if matches(d, args.only)]
    print(t("plan", s=show(src), d=show(dst), n=len(todo),
            w="" if (args.all or args.only) else t("window", d=f"{args.days:g}")))
    plan = []
    for f, d in sorted(todo, key=lambda x: x[1].get("lastActivityAt") or 0, reverse=True):
        target = dst["dir"] / f.name
        old = load(target) if target.exists() else None
        title = d.get("title") or t("untitled")
        if isinstance(old, dict) and (old.get("lastActivityAt") or 0) > (d.get("lastActivityAt") or 0) and not old.get("isArchived"):
            print(t("skip", t=title))
            continue
        plan.append((f, target, d))
        print(t("over" if old else "add", t=title, w=when(d.get("lastActivityAt"))))
    arts = []
    for _, _, d in plan:
        for a in d.get("publishedArtifacts") or []:
            if isinstance(a, dict) and a.get("url"):
                arts.append((a.get("title") or a["url"], a["url"]))
    if arts:
        print(t("artifacts"))
        for title, url in dict.fromkeys(arts):
            print(t("art_line", t=title, u=url))
    if args.dry_run:
        print(t("dry"))
        return
    if not plan:
        print(t("nothing"))
        return
    if app_running():
        sys.exit(t("running"))
    BACKUPS.mkdir(parents=True, exist_ok=True)
    bk = BACKUPS / f"{time.strftime('%Y%m%d-%H%M%S')}-{dst['acct'][:8]}"
    shutil.copytree(dst["dir"], bk)
    manifest = {"version": 1, "target": str(dst["dir"]), "account": dst["acct"], "created": int(time.time()),
                "replaced": [tg.name for _, tg, _ in plan if tg.exists()],
                "added": [tg.name for _, tg, _ in plan if not tg.exists()]}
    (bk / MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(t("backed", p=bk))
    for f, target, _ in plan:
        shutil.copy2(f, target)
    print(t("done", n=len(plan)))


def backups():
    if not BACKUPS.is_dir():
        return []
    out = []
    for b in sorted(BACKUPS.iterdir(), reverse=True):
        if b.is_dir():
            out.append((b, load(b / MANIFEST)))
    return out


def cmd_undo(args):
    if getattr(args, "app", False) and not args.dry_run and not args.list:
        args.app = False
        return by_app(args, lambda: cmd_undo(args))
    items = backups()
    if args.list:
        if not items:
            print(t("no_backups"))
        for b, m in items:
            if isinstance(m, dict) and m.get("version") == 1:
                state = " (undone)" if m.get("undone") else ""
                print(t("bk_line", n=b.name, w=time.strftime("%m-%d %H:%M", time.localtime(m.get("created", 0))),
                        c=len(m.get("replaced", [])) + len(m.get("added", [])), a=m.get("account", "")[:8]) + state)
            else:
                print(t("bk_old", n=b.name))
        return
    if args.backup:
        chosen = [(b, m) for b, m in items if b.name == args.backup]
    else:
        chosen = [(b, m) for b, m in items if isinstance(m, dict) and m.get("version") == 1 and not m.get("undone")][:1]
    if not chosen or not isinstance(chosen[0][1], dict):
        sys.exit(t("no_backups"))
    bk, m = chosen[0]
    target = Path(m["target"])
    if not target.is_dir():
        sys.exit(t("undo_gone", p=target))
    replaced = [n for n in m.get("replaced", []) if (bk / n).exists()]
    added = [n for n in m.get("added", []) if (target / n).exists()]
    print(t("undo_plan", n=bk.name, r=len(replaced), d=len(added), a=m.get("account", "")[:8]))
    if args.dry_run:
        print(t("dry"))
        return
    if app_running():
        sys.exit(t("running"))
    snap = BACKUPS / f"{time.strftime('%Y%m%d-%H%M%S')}-{m.get('account', 'x')[:8]}-before-undo"
    shutil.copytree(target, snap)
    for n in replaced:
        shutil.copy2(bk / n, target / n)
    for n in added:
        (target / n).unlink()
    m["undone"] = int(time.time())
    (bk / MANIFEST).write_text(json.dumps(m, indent=2) + "\n", encoding="utf-8")
    print(t("undo_done", p=snap))


def by_app(args, fn):
    """`--app`: quit the desktop app, run fn, open the app again. Started inside the app (its Code page, the cmove
    mod), a copy of claude-move on its own does the work, since quitting the app ends what the app started; that
    copy says how it went in a notification. Either way the log is kept in last-move.json."""
    if not args.detached and inside_desktop_app():
        spawn([sys.executable, str(Path(__file__).resolve())] + sys.argv[1:] + ["--detached"])
        print(t("app_handoff"))
        return
    if args.detached:  # let whoever started it show its answer before the app goes
        time.sleep(float(os.environ.get("CLAUDE_MOVE_HANDOFF_WAIT", "2")))
    ok, out = with_app_closed(fn)
    print(out, end="")
    CONF.mkdir(parents=True, exist_ok=True)
    LAST_MOVE.write_text(json.dumps({"at": int(time.time()), "ok": ok, "log": out}, ensure_ascii=False, indent=1) + "\n",
                         encoding="utf-8")
    if args.detached:
        notify("claude-move", t("app_moved" if ok else "app_move_failed"))
    if not ok:
        sys.exit(1)


def project_dir_name(path):
    return "".join(c if c.isalnum() or c == "-" else "-" for c in str(path))


def first_prompt(jsonl):
    try:
        with open(jsonl, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 400:
                    break
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") == "user" and not rec.get("isMeta"):
                    c = (rec.get("message") or {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                    if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
                        return " ".join(c.split())[:60]
    except OSError:
        pass
    return ""


def cmd_import_cli(args):
