def plan_name(oa):
    """Plan from the account profile the CLI caches in .claude.json, e.g. organizationType claude_max with
    organizationRateLimitTier default_claude_max_20x -> "Max 20x"."""
    import re
    if not isinstance(oa, dict):
        return ""
    tier = (oa.get("organizationRateLimitTier") or oa.get("userRateLimitTier") or "").lower()
    kind = (oa.get("organizationType") or "").lower()
    m = re.search(r"max_(\d+)x", tier)
    if "max" in kind or m:
        return f"Max {m.group(1)}x" if m else "Max"
    for key, label in (("pro", "Pro"), ("team", "Team"), ("enterprise", "Enterprise")):
        if key in kind or key in tier:
            return label
    return ""


