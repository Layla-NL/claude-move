def cli_dir(token, extra=()):
    """The signed-in CLI config folder for an account, by label or id prefix."""
    nm = names()
    found = [(cli_account(c), c) for c in cli_configs(extra)]
    hits = [c for a, c in found if nm.get(a) == token] or [c for a, c in found if a.startswith(token)]
    return hits[0] if token and hits else None


def open_terminal(cfg):
    """A new Terminal window running `claude` with this config folder, so the CLI uses that folder's own login.
    It writes a small .command file and lets macOS open it: no Automation permission, no credentials touched."""
    from shlex import quote
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    env = "unset CLAUDE_CONFIG_DIR\n" if cfg == HOME / ".claude" else f"export CLAUDE_CONFIG_DIR={quote(str(cfg))}\n"
    script = CONF / "term" / (cfg.name.lstrip(".") + ".command")
    script.parent.mkdir(parents=True, exist_ok=True)
    script.write_text(f"#!/bin/sh\ncd ~ || exit 1\n{env}exec {quote(exe)}\n")
    script.chmod(0o700)
    cmd = os.environ.get("CLAUDE_MOVE_TERM_CMD")
    subprocess.run(cmd + " " + quote(str(script)), shell=True) if cmd else subprocess.run(["open", str(script)], check=False)
    return script


