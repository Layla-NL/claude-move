def bar_color(pct):
    return "#9ba2ac" if pct is None else BAR_RAMP[max(0, min(20, round(pct / 5)))]


def bar_lines(now=None):
    """What SwiftBar/xbar shows: a ball for the desktop app's account (else the fullest), and a line per account.
    Only official numbers already saved are read, so it runs in a blink every minute."""
    now = now or time.time()
    official, nm = load(LIMITS) or {}, names()
    accts = []
    for acct, off in official.items():
        rows = official_rows(off) if isinstance(off, dict) and now - off.get("at", 0) < 3 * 86400 else []
        rows = [r for r in rows if not (r.get("resets_at") and r["resets_at"] < now)]  # a window that has reset since
        if rows:
            top = max(rows, key=lambda r: r.get("percent") or 0)
            accts.append((acct, nm.get(acct) or acct[:8], rows, top))
    timeline = signin_timeline()
    signed = timeline[-1][1] if timeline else None
    shown = next((a for a in accts if a[0] == signed), None) or max(accts, key=lambda a: a[3].get("percent") or 0, default=None)
    me, py = bar_q(str(Path(__file__).resolve())), bar_q(sys.executable)
    if shown:
        pct = round(shown[3].get("percent") or 0)
        out = [f"● {pct}% | color={bar_color(pct)}", "---"]
    else:
        out = [f"● | color={bar_color(None)}", "---"]
    for acct, name, rows, top in sorted(accts, key=lambda a: a[1].lower()):
        pct = round(top.get("percent") or 0)
        cool = pct >= 100 and top.get("resets_at")
        text = t("u_back", k=row_label(top), w=clock(top["resets_at"])) if cool else rows_text(rows)
        out.append(f"{'● ' if acct == signed else ''}{name}  {text} | color={bar_color(pct)}")
    out += ["---", f"{t('pp_open')} | bash={py} param1={me} param2=panel terminal=false",
            f"{t('p_refresh')} | bash={py} param1={me} param2=usage param3=--refresh terminal=false refresh=true"]
    return out


