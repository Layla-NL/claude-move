    c = c if isinstance(c, dict) else {}
    lv = c.get("levels")
    levels = sorted(int(x) for x in lv) if isinstance(lv, list) and lv and all(isinstance(x, (int, float)) for x in lv) else list(LEVELS)
    return {"on": c.get("on") is not False, "levels": levels}


def notify(title, body):
    """A system notification (macOS, or a Windows toast). It never fails: the status line recorder calls it too."""
    cmd = os.environ.get("CLAUDE_MOVE_NOTIFY_CMD")
    try:
        if cmd:
            subprocess.run(cmd, shell=True, input=f"{title}\n{body}\n", text=True, encoding="utf-8", timeout=10)
        elif sys.platform == "darwin":
            script = (f"display notification {json.dumps(body, ensure_ascii=False)} "
                      f"with title {json.dumps(title, ensure_ascii=False)}")
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
        elif WIN:  # the text goes in through the environment, so nothing in it needs quoting
            ps = ("$m = [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime]; "
                  "$x = $m::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02); "
                  "$n = $x.GetElementsByTagName('text'); "
                  "[void]$n.Item(0).AppendChild($x.CreateTextNode($env:CLAUDE_MOVE_N_TITLE)); "
                  "[void]$n.Item(1).AppendChild($x.CreateTextNode($env:CLAUDE_MOVE_N_BODY)); "
                  "$m::CreateToastNotifier('{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\WindowsPowerShell\\v1.0\\powershell.exe')"
                  ".Show([Windows.UI.Notifications.ToastNotification]::new($x))")
            subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps], capture_output=True, timeout=15,
                           env=dict(os.environ, CLAUDE_MOVE_N_TITLE=title, CLAUDE_MOVE_N_BODY=body), creationflags=NO_WINDOW)
    except (OSError, subprocess.SubprocessError):
        pass


def check_levels(acct, rows):
    """Notify once per reset window when an official meter passes each level (75/90/95% by default)."""
    conf = notify_conf()
    if not conf["on"] or not acct:
        return
    state = load(NOTIFIED) or {}
    mine = dict(state.get(acct) or {})
    changed = False
    for r in rows:
        p = r.get("percent")
        if p is None:
            continue
        key = f'{r.get("kind", "")}:{r.get("scope") or ""}'
        old = dict(mine.get(key) or {})
        reset = r.get("resets_at") or 0
        if abs(reset - (old.get("reset") or 0)) > 3600:  # a new window; reset times drift by seconds between sources
            old = {"reset": reset, "level": 0}
        hit = max((lv for lv in conf["levels"] if p >= lv), default=0)
        if hit > old.get("level", 0):
            msg = t("n_level", a=names().get(acct, acct[:8]), k=row_label(r), p=f"{p:.0f}")
            msg += " · " + t("n_reset", w=clock(reset)) if reset else ""
            hint = switch_hint(acct) if hit >= 90 and acct == crew_acct() else ""
            notify(t("n_title"), msg + ("\n" + hint if hint else ""))
            old["level"] = hit
        if mine.get(key) != old:
            mine[key], changed = old, True
    if changed:
        state[acct] = mine
        save_json(NOTIFIED, state)


def week_summary(rep):
    """Last week (Monday to Sunday) from the heatmap: (year-week, text), or None when there was no use."""
    h = rep.get("heat")
    if not h:
        return None
    start = datetime.strptime(h["start"], "%Y-%m-%d").date()
    today = datetime.fromtimestamp(rep["now"]).date()
    monday = today - timedelta(days=today.weekday() + 7)
    first = (monday - start).days
    if first < 0:
        return None
    acct = {k: sum(v[first:first + 7]) for k, v in h["cal"].items()}
    days = [sum(v[first + i] for v in h["cal"].values()) for i in range(7)]
    if sum(days) < 1:
        return None
    name = {a["k"]: a["name"] for a in h["accts"]}
    week = "{}-W{:02d}".format(*monday.isocalendar()[:2])
    return week, t("n_week", d=f"${sum(days):,.0f}", a=name.get(max(acct, key=acct.get), "?"),
                   w=t("pp_wdfmt", d=t("pp_wd").split(",")[days.index(max(days))]))


def maybe_week_summary(rep):
    """Once a week, the first time use is read (the panel or `usage`), notify last week's summary."""
    if not notify_conf()["on"]:
        return
    s = week_summary(rep)
    state = load(NOTIFIED) or {}
    if not s or state.get("_week") == s[0]:
        return
    state["_week"] = s[0]
    save_json(NOTIFIED, state)
    notify(t("n_title"), s[1])


def cmd_notify(args):
    conf = notify_conf()
    if args.action == "test":
        notify(t("n_title"), t("n_test"))
