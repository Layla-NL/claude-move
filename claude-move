NO_WINDOW = 0x08000000  # Windows: CREATE_NO_WINDOW, so helper commands do not flash a console
APP_EXE = []  # Windows: where the desktop app ran from, to start it again


def quit_app():
    cmd = os.environ.get("CLAUDE_MOVE_QUIT_CMD")
    if cmd:
        subprocess.run(cmd, shell=True)
    elif WIN:
        # nothing outside it can ask it to quit: its close button and a plain taskkill only hide it in the
        # notification area (tried on Windows 11, Store build), so end its process tree as its tray Quit would
        mains, procs = app_pids()
        APP_EXE[:] = [procs[pid][1] for pid in mains][:1]
        for pid in mains:
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True, creationflags=NO_WINDOW)
    else:
        subprocess.run(["osascript", "-e", 'tell application "Claude" to quit'], check=False)
    for _ in range(60):
        if not app_running():
            return True
        time.sleep(0.5)
    return False


def open_app():
    cmd = os.environ.get("CLAUDE_MOVE_OPEN_CMD")
    if cmd:
        subprocess.run(cmd, shell=True)
    elif WIN:
        stub = Path(os.environ.get("LOCALAPPDATA") or HOME / "AppData/Local") / "AnthropicClaude" / "claude.exe"
        if stub.exists():  # the installer build's launcher, which starts its newest version
            spawn([str(stub)])
            return
        # the Store build has no launcher on disk to run; start it the way the Start menu does
        ps = ("$a = (Get-StartApps | Where-Object { $_.Name -eq 'Claude' } | Select-Object -First 1).AppID; "
              "if ($a) { Start-Process ('shell:AppsFolder\\' + $a); exit 0 }; exit 1")
        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                           capture_output=True, creationflags=NO_WINDOW)
        if r.returncode != 0 and APP_EXE:
            spawn(APP_EXE[:1])
    else:
        subprocess.run(["open", "-a", "Claude"], check=False)


def spawn(cmd):
    """Start cmd on its own, so it outlives this process and the desktop app."""
    kw = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not WIN:
        return subprocess.Popen(cmd, start_new_session=True, **kw)
    flags = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    try:
        return subprocess.Popen(cmd, creationflags=flags | 0x01000000, **kw)  # and out of the app's job
    except OSError:
        return subprocess.Popen(cmd, creationflags=flags, **kw)


def open_path(x):
    """Open a file, folder or URL the way a double-click would."""
    if WIN:
        os.startfile(str(x))
    elif sys.platform == "darwin":
        subprocess.run(["open", str(x)], check=False)


def switch_to(acct, include_all):
    """The panel's button: the desktop app is already signed into `acct`. Quit it, copy the sessions in, reopen."""
    import contextlib
    import io
    timeline = signin_timeline()
    signed = timeline[-1][1] if timeline else None
    buf = io.StringIO()
    if signed != acct:
        return False, t("p_not_signed")
    target = next((a for a in accounts() if a["acct"] == acct), None)
    if not target:
        return False, t("p_no_folder")
    with contextlib.redirect_stdout(buf):
        print(t("p_quitting"))
        if not quit_app():
            return False, buf.getvalue() + t("running")
        try:
            cmd_to(argparse.Namespace(target=acct, source=None, days=3, all=include_all, only=None, dry_run=False))
            ok = True
        except SystemExit as e:
            print(e.code if isinstance(e.code, str) else "")
            ok = False
        print(t("p_opening"))
        open_app()
    return ok, buf.getvalue()


def inside_desktop_app():
    """True when this process descends from the Claude desktop app (its terminal pane, a Code session)."""
    if os.environ.get("CLAUDE_MOVE_SKIP_APP_CHECK") == "1":
        return False
    if WIN:
        try:
            procs = win_procs()
        except (OSError, AttributeError):
            return False
        pid = os.getppid()
        for _ in range(30):
            if pid not in procs:
                return False
            ppid, exe = procs[pid]
            if desktop_exe(exe):
                return True
            pid = ppid
        return False
    pid = os.getppid()
    for _ in range(30):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        except OSError:
            return False
        if not out:
            return False
        ppid, _, comm = out.partition(" ")
        if "/Claude.app/" in comm:
            return True
        if not ppid.strip().isdigit() or int(ppid) <= 1:
            return False
        pid = int(ppid)
    return False


def cmd_panel(args):
    import secrets
    if not args.here and inside_desktop_app():
        # quitting the app from the panel would take this process down with it; run on our own instead
        app = app_path()
        if app.exists():
            open_path(app)
            print(t("p_detached_app"))
            return
        cmd = [sys.executable, str(Path(__file__).resolve()), "panel", "--here", "--idle", str(args.idle or 1800)]
        for c in args.config or ():
            cmd += ["--config", c]
        spawn(cmd)
        print(t("p_detached"))
        return
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse
    import threading
    import urllib.request
    old = load(PANEL)
    if isinstance(old, dict) and old.get("url") and pid_alive(old.get("pid")):
        try:  # one panel at a time: a second launch just brings the running one back
            base, tok = old["url"].split("/?t=")
            req = urllib.request.Request(base + "/state", headers={"X-Token": tok})
            urllib.request.urlopen(req, timeout=3).read()
            print(t("p_url", u=old["url"]), flush=True)
            if not args.no_open:
                open_path(old["url"])
            return
        except (OSError, ValueError):
            pass
    token = secrets.token_urlsafe(18)
    busy = {"on": False}
    seen = {"t": time.time()}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def allowed(self):
            host = self.headers.get("Host", "")
            if host != f"127.0.0.1:{self.server.server_port}":  # no DNS rebinding
                return False
            q = parse_qs(urlparse(self.path).query)
            ok = self.headers.get("X-Token") == token or q.get("t", [""])[0] == token
            if ok:
                seen["t"] = time.time()
            return ok

        def send(self, code, body, kind="application/json"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", kind + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if not self.allowed():
                return self.send(403, "{}")
            path = urlparse(self.path).path
            if path == "/":
                rep_ = usage_report(args.config or ())
                return self.send(200, render_html(rep_, live={"token": token}), "text/html")
            if path == "/state":
                accts = accounts()
                timeline = signin_timeline()
                signed = timeline[-1][1] if timeline else None
                others = [a for a in accts if a["acct"] != signed and a["sessions"]]
                src = max(others, key=lambda a: a["last"]) if others else None
                nm = names()
                claim_logins()
                return self.send(200, json.dumps({
                    "signed": {"acct": signed, "name": nm.get(signed, signed[:8])} if signed else None,
                    "source": {"acct": src["acct"], "name": show(src)} if src else None, "busy": busy["on"],
                    "running": app_running()}))
            if path.startswith("/api/"):
                q = {k: v[0] for k, v in parse_qs(urlparse(self.path).query).items()}
                code, out = panel_api("GET", path, q, {}, args.config or ())
                return self.send(code, json.dumps(out, ensure_ascii=False))
            self.send(404, "{}")

        def do_POST(self):
            if not self.allowed():
                return self.send(403, "{}")
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                body = {}
            path = urlparse(self.path).path
            if path == "/switch":
                if busy["on"]:
                    return self.send(409, json.dumps({"ok": False, "log": t("p_busy")}))
                busy["on"] = True
                try:
                    ok, log = switch_to(str(body.get("to") or ""), bool(body.get("all")))
                finally:
                    busy["on"] = False
                return self.send(200, json.dumps({"ok": ok, "log": log}, ensure_ascii=False))
            if path == "/terminal":  # only an account's own signed-in config folder, only to run `claude`
                acct = str(body.get("acct") or "")
                cfg = next((c for c in cli_configs(args.config or ()) if acct and cli_account(c) == acct), None)
                if not cfg:
                    return self.send(404, json.dumps({"ok": False, "log": t("t_none", t=acct[:8])}, ensure_ascii=False))
                open_terminal(cfg, bool(body.get("rc")), bool(body.get("auto")))
                return self.send(200, json.dumps({"ok": True, "log": ""}))
            if path.startswith("/api/"):
                heavy = path in ("/api/move", "/api/undo") and not body.get("dry")  # these may quit the desktop app
                if heavy and busy["on"]:
                    return self.send(409, json.dumps({"ok": False, "log": t("p_busy")}, ensure_ascii=False))
                busy["on"] = busy["on"] or heavy
                try:
                    code, out = panel_api("POST", path, {}, body if isinstance(body, dict) else {}, args.config or ())
                finally:
                    if heavy:
                        busy["on"] = False
                return self.send(code, json.dumps(out, ensure_ascii=False))
            if path == "/refresh":
                import contextlib
                import io
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    refresh_official(args.config or ())
                return self.send(200, json.dumps({"ok": True, "log": buf.getvalue()}, ensure_ascii=False))
            self.send(404, "{}")

    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{srv.server_port}/?t={token}"
    CONF.mkdir(parents=True, exist_ok=True)
    PANEL.write_text(json.dumps({"pid": os.getpid(), "url": url}) + "\n", encoding="utf-8")
    os.chmod(PANEL, 0o600)
    print(t("p_url", u=url), flush=True)
    if not args.no_open:
        open_path(url)

    def idle_watch():  # the open page polls every few seconds, so this only fires after the tab is gone
        while True:
            time.sleep(5)
            if args.idle and not busy["on"] and time.time() - seen["t"] > args.idle:
                srv.shutdown()
                return

    threading.Thread(target=idle_watch, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        cur = load(PANEL)
        if isinstance(cur, dict) and cur.get("pid") == os.getpid():
            PANEL.unlink()


def pid_alive(pid):
    if WIN:  # os.kill would end the process on Windows; ask whether it is still running instead
        try:
            import ctypes
            k = kernel32()
            h = k.OpenProcess(0x1000, False, int(pid))
            if not h:
                return False
            code = ctypes.c_ulong()
            k.GetExitCodeProcess(h, ctypes.byref(code))
            k.CloseHandle(h)
            return code.value == 259  # STILL_ACTIVE
        except (OSError, TypeError, ValueError, AttributeError):
            return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


