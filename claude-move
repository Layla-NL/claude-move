    ok, log = resume_session(*found, to_cfg=to, here=args.here, extra=args.config or ())
    if not ok:
        sys.exit(log)
    print(log)


def tmux_bin():
    if WIN:
        return None
    v = os.environ.get("CLAUDE_MOVE_TMUX")
    if v is not None:
        return v if v not in ("", "0") else None
    if os.environ.get("CLAUDE_MOVE_TERM_CMD"):  # windows are opened some other way (tests)
        return None
    return shutil.which("tmux") or next((p for p in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux") if os.path.exists(p)), None)


def tmux(*a):
    """Run one tmux command; its output, or None when tmux is missing, not running or says no."""
    tm = tmux_bin()
    if not tm:
        return None
    try:
        r = subprocess.run([tm, *a], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def tmux_panes():
    """pane pid -> (target, the window's name when someone other than tmux or claude-move named it)."""
    panes = {}
    fmt = "#{pane_pid}\t#{session_name}:#{window_index}.#{pane_index}\t#{window_name}\t#{automatic-rename}\t#{@cm_named}"
    for line in (tmux("list-panes", "-a", "-F", fmt) or "").splitlines():
        p = line.split("\t")
        if len(p) == 5 and p[0].isdigit():
            panes[int(p[0])] = (p[1], p[2] if p[3] != "1" and p[4] != "1" else "")
    return panes


def index_titles():
    """session id -> (title the user gave, title Claude Code gave) from the search index, if there is one; read only."""
    import sqlite3
    if not INDEX.exists():
        return {}
    try:
        db = sqlite3.connect(f"file:{INDEX.as_posix()}?mode=ro", uri=True, timeout=2)
        try:
            return {sid: (t1, t2) for sid, t1, t2 in db.execute("SELECT sid, title, ai FROM files")}
        finally:
            db.close()
    except sqlite3.Error:
        return {}


def parent_pids():
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    pp = {}
    for line in out.splitlines():
        a = line.split()
        if len(a) == 2 and a[0].isdigit() and a[1].isdigit():
            pp[int(a[0])] = int(a[1])
    return pp


def live_sessions(extra=()):
    """Claude Code sessions running now, from each CLI login's sessions/<pid>.json (Claude Code's own record of its
    running processes), with the tmux pane each runs in. Busy first, then the most recently active."""
    nm, panes, titles, lb, pin = names(), tmux_panes(), index_titles(), labels(), pins()
    pp = parent_pids() if panes else {}
    out, seen = [], set()
    for cfg in cli_configs(extra):
        acct = cli_account(cfg)
        for f in (cfg / "sessions").glob("*.json"):
            d = load(f)
            pid = d.get("pid") if isinstance(d, dict) else None
            if not isinstance(pid, int) or pid in seen or not pid_alive(pid):
                continue
            seen.add(pid)
            up, hops = pid, 0
            while up and up not in panes and hops < 40:
                up, hops = pp.get(up), hops + 1
            sid = str(d.get("sessionId") or "")
            tr = next(iter(cfg.glob(f"projects/*/{sid}.jsonl")), None) if SESSION_ID.match(sid) else None
            try:
                last = tr.stat().st_mtime if tr else 0
            except OSError:
                last = 0
            cwd = str(d.get("cwd") or "")
            target, window = panes.get(up, ("", ""))
            given, ai = titles.get(sid, (None, None))
            # a name the user gave (in claude-move, then in Claude Code), then the session's title, then the window's
            # name firstmate gave, then Claude Code's
            title = lb.get(sid) or (d.get("nameSource") == "user" and d.get("name")) or given or window or ai or d.get(
                "name") or (first_prompt(tr) if tr else "")
            out.append({"pid": pid, "sid": sid, "acct": acct, "name": nm.get(acct, acct[:8]), "cfg": str(cfg),
                        "title": str(title), "status": str(d.get("status") or ""),
                        "cwd": cwd, "project": short(Path(cwd)) if cwd else "", "started": (d.get("startedAt") or 0) / 1000,
                        "active": max(last, (d.get("updatedAt") or 0) / 1000), "rc": bool(d.get("bridgeSessionId")),
                        "tmux": target, "pin": sid in pin})
    order = {sid: i for i, sid in enumerate(pin)}  # pinned ones keep the order they were pinned in
    return sorted(out, key=lambda r: (not r["pin"], order.get(r["sid"], 0), r["status"] != "busy", -r["active"]))


def status_text(s):
    return t("ps_" + s) if s in ("busy", "idle") else s


def tmux_show(target):
    """Bring a tmux pane forward: in the terminal attached to tmux most recently, else in a new terminal window."""
    win = target.split(".")[0]
    if tmux("select-window", "-t", win) is None:
        return False
    tmux("select-pane", "-t", target)
    clients = []
    for line in (tmux("list-clients", "-F", "#{client_activity}\t#{client_name}") or "").splitlines():
        a, _, c = line.partition("\t")
        if a.isdigit() and c:
            clients.append((int(a), c))
    if clients:
        tmux("switch-client", "-c", max(clients)[1], "-t", target)
    else:
        sess = win.split(":")[0]
        open_command(term_script("tmux-" + (re.sub(r"[^A-Za-z0-9-]", "-", sess)[:24] or "x"), None, {},
                                 [tmux_bin(), "attach-session", "-t", sess]))
    return True


def open_window(script_body, name):
    """A new tmux window when a tmux server is running, shown; else a new terminal window. Returns the tmux target or ""."""
    from shlex import quote
    if tmux("list-sessions", "-F", "#{session_name}"):
        script = write_script(script_body)
        target = (tmux("new-window", "-P", "-F", "#{session_name}:#{window_index}", "-n", name[:30], quote(str(script))) or "").strip()
        if target:
            tmux("set-option", "-w", "-t", target, "@cm_named", "1")
            tmux_show(target)
            return target
    open_command(script_body)
    return ""


def window_label(r):
    return (("● " if r["status"] == "busy" else "") + r["name"] + "·" + (r["title"] or Path(r["cwd"]).name or r["sid"][:8]))[:30]


def tmux_name(rows=None):
    """Name each tmux window that holds one Claude session after its account and session, with ● while busy. Only
    windows nobody named, or claude-move named before: firstmate's and the user's own names stay. A window claude-move
    named goes back to tmux's automatic name once its session ends."""
    rows = live_sessions() if rows is None else rows
    by_win = {}
    for r in rows:
        if r["tmux"]:
            by_win.setdefault(r["tmux"].split(".")[0], []).append(r)
    n = 0
    fmt = "#{session_name}:#{window_index}\t#{window_panes}\t#{automatic-rename}\t#{@cm_named}\t#{window_name}"
    for line in (tmux("list-windows", "-a", "-F", fmt) or "").splitlines():
        p = line.split("\t")
        if len(p) != 5 or not (p[2] == "1" or p[3] == "1"):
            continue
        here = by_win.get(p[0], [])
        if len(here) == 1 and p[1] == "1":
            want = window_label(here[0])
            if p[4] != want:
                tmux("rename-window", "-t", p[0], want)
                tmux("set-option", "-w", "-t", p[0], "@cm_named", "1")
                n += 1
        elif p[3] == "1" and not here:
            tmux("set-option", "-w", "-t", p[0], "automatic-rename", "on")
            tmux("set-option", "-w", "-u", "-t", p[0], "@cm_named")
    return n


def tmux_line(rows):
    """The status bar text: running sessions per account, ● how many are busy."""
    per = {}
    for r in rows:
        n, b = per.get(r["name"], (0, 0))
        per[r["name"]] = (n + 1, b + (r["status"] == "busy"))
    return " · ".join(f"{a} {n}" + (f" ●{b}" if b else "") for a, (n, b) in sorted(per.items()))


def tmux_menu(rows):
    keys = "123456789abcdefghijklmnopqrstuvwxyz"
    items = []
    for k, r in zip(keys, [r for r in rows if r["tmux"]]):
        label = f'{"●" if r["status"] == "busy" else "○"} {"📌 " * r["pin"]}{r["name"]} · {r["title"] or r["project"]} · {r["tmux"]}'
        items += [label.replace("#", "##")[:70], k, f'switch-client -t {r["tmux"]}']
    return ["display-menu", "-T", t("tm_menu"), "-x", "C", "-y", "C"] + (items or ["-" + t("tm_menu_none"), "", ""])


def tmux_conf_block():
    py = "/usr/bin/python3" if sys.platform == "darwin" and os.path.exists("/usr/bin/python3") else sys.executable
    cm = f'"{py}" "{Path(__file__).resolve()}"'
    return "\n".join([TMUX_MARK[0] + " (claude-move tmux conf --remove takes it out)", "set -g mouse on",
                      "set -g status-interval 15", "set -g status-right-length 120",
                      f"set -g status-right '#({cm} tmux line) %H:%M'", f"bind-key S run-shell -b '{cm} tmux menu'",
                      TMUX_MARK[1]]) + "\n"


def tmux_conf_set(on):
    """Add or take out the claude-move block in ~/.tmux.conf, backing the file up first, and apply it to a running tmux."""
    old = TMUX_CONF.read_text(encoding="utf-8") if TMUX_CONF.exists() else ""
    pat = re.compile(re.escape(TMUX_MARK[0]) + r".*?" + re.escape(TMUX_MARK[1]) + r"\n?", re.S)
    has = bool(pat.search(old))
    new = pat.sub("", old)
    if on:
        if old and pat.search(old) and pat.search(old).group(0) == tmux_conf_block():
            return False, t("tm_conf_same", p=short(TMUX_CONF))
        new = new + ("\n" if new and not new.endswith("\n") else "") + tmux_conf_block()
    elif not has:
        return False, t("tm_conf_absent", p=short(TMUX_CONF))
    lines = []
    if old:
        bk = CONF / "backups" / f'tmux.conf-{time.strftime("%Y%m%d-%H%M%S")}'
        bk.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(TMUX_CONF, bk)
        lines.append(t("tm_conf_bk", p=short(bk)))
    TMUX_CONF.write_text(new, encoding="utf-8")
    if on:
        tmux("source-file", str(TMUX_CONF))
    else:
        for opt in ("mouse", "status-interval", "status-right-length", "status-right"):
            tmux("set-option", "-gu", opt)
        tmux("unbind-key", "S")
    return True, "\n".join([t("tm_conf_on" if on else "tm_conf_off", p=short(TMUX_CONF))] + lines)


def tmux_conf_on():
    return TMUX_CONF.exists() and TMUX_MARK[0] in TMUX_CONF.read_text(encoding="utf-8", errors="replace")


def ps_match(rows, tok):
    tok = tok.strip()
    return next((r for r in rows if tok and (r["tmux"] == tok or r["sid"].startswith(tok) or str(r["pid"]) == tok
                                             or r["tmux"].split(".")[0] == tok)), None)


def cmd_ps(args):
    rows = live_sessions(args.config or ())
    if args.pin or args.unpin:
        for tok in args.pin or args.unpin:
            r = ps_match(rows, tok)
            # a pin can come off a session that is not running any more, by its id
            sid = r["sid"] if r else next((x for x in pins() if args.unpin and tok.strip() and x.startswith(tok.strip())), "")
            if not sid:
                sys.exit(t("ps_go_none", i=tok))
            set_pin(sid, bool(args.pin))
            print(t("ps_pinned" if args.pin else "ps_unpinned", w=(r["title"] or r["tmux"]) if r else sid[:8]))
        return
    if args.go or args.label:
        tok = args.go or args.label[0]
        r = ps_match(rows, tok)
        if not r:
            sys.exit(t("ps_go_none", i=tok))
        if args.label:
            lb, text = labels(), " ".join(args.label[1].split())
            lb.pop(r["sid"], None)
            if text:
                lb[r["sid"]] = text
            save_labels(lb)
            print(t("ps_labeled" if text else "ps_unlabeled", w=r["tmux"] or r["sid"][:8], n=text))
            if r["tmux"] and tmux_bin():
                tmux_name()
            return
        if not r["tmux"]:
            sys.exit(t("ps_go_notmux", p=r["pid"]))
        if not tmux_show(r["tmux"]):
            sys.exit(t("tm_none"))
        print(t("ps_shown", w=r["tmux"]))
        return
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return
    if not rows:
        print(t("ps_none"))
        return
    print(t("ps_head", n=len(rows), b=sum(r["status"] == "busy" for r in rows)))
    import unicodedata
    wide = lambda x: sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in x)
    w = [max(wide(x) for x in col) for col in zip(*[(r["name"], status_text(r["status"]), r["tmux"] or "-") for r in rows])]
    for r in rows:
        cols = (r["name"], status_text(r["status"]), r["tmux"] or "-")
        print("  " + "  ".join(c + " " * (n - wide(c)) for c, n in zip(cols, w)) + f'  {"📌 " * r["pin"]}{r["title"] or r["sid"][:8]} · {r["project"]}'
              + f'  ({ago(time.time() - r["started"])})' * bool(r["started"]))


def cmd_tmux(args):
    if args.action == "conf":
        if not (args.install or args.remove):
            print(t("tm_conf_show", p=short(TMUX_CONF)) + "\n\n" + tmux_conf_block(), end="")
            return
        ok, log = tmux_conf_set(bool(args.install))
        print(log)
        return
    rows = live_sessions(args.config or ())
    if args.action == "line":  # the status bar runs this every few seconds: never fail, print one short line
        try:
            tmux_name(rows)
        except Exception:
            pass
        print(tmux_line(rows))
        return
    if not tmux("list-sessions"):
        sys.exit(t("tm_none"))
    if args.action == "menu":
        tmux(*tmux_menu(rows))
    else:
        print(t("tm_named", n=tmux_name(rows)))


# ---------- doctor
def doctor_items(extra=()):
    """What doctor finds, for the terminal and the panel: section, whether it needs a look, text, and the fix the
    panel can offer for it."""
    items = []

    def add(sec, text, warn=False, fix=None):
        items.append({"sec": sec, "warn": warn, "text": text, "fix": fix})

    nm = names()
    timeline = signin_timeline()
    signed = timeline[-1][1] if timeline else None
    if signed:
        add("desk", t("d_signed", a=nm.get(signed, signed[:8])))
    desk = {}
    for a in accounts():
        if a["sessions"]:
            desk.setdefault(a["acct"], a)
    for acct in desk:
        if not nm.get(acct):
            add("desk", t("d_unnamed", a=acct[:8]), True, {"do": "name", "acct": acct})
    logins = load(LOGINS) or {}
    plan_of = plans(extra)
    found = sorted(p for p in HOME.glob(".claude-*") if p.is_dir())
    found += [Path(os.path.expanduser(c)) for c in extra] + [HOME / ".claude"]
    where = {}
    for c in dict.fromkeys(found):
        acct = cli_account(c)
        if not acct:
            add("cli", t("d_cli_none", d=short(c)))
            continue
        where.setdefault(acct, []).append(c)
        st = logins.get(str(c))
        s = (t("d_ok_at" if st.get("ok") else "d_bad_at", w=ago(time.time() - st.get("at", 0)))
             if isinstance(st, dict) else t("d_unchecked"))
        plan = f' ({plan_of[acct]})' if plan_of.get(acct) else ""
        add("cli", t("d_cli_row", d=short(c), a=nm.get(acct, acct[:8]), p=plan, s=s))
    for acct, dirs in where.items():  # dirs[0] is the one cli_configs puts first, so the one claude-move uses
        if len(dirs) > 1:
            stale = [d for d in dirs[1:] if not (logins.get(str(d)) or {}).get("ok", True)]
            if len(stale) == len(dirs) - 1:
                add("cli", t("d_stale", a=nm.get(acct, acct[:8]), d=", ".join(short(d) for d in stale), u=short(dirs[0])))
            else:
                add("cli", t("d_dup", a=nm.get(acct, acct[:8]), ds=", ".join(short(d) for d in dirs), u=short(dirs[0])), True)
    for acct in desk:
        if acct not in where:
            add("cli", t("d_no_cli", a=nm.get(acct, acct[:8]), n=nm.get(acct) or "name"), True, {"do": "login", "acct": acct})
    for acct, dirs in where.items():
        c = dirs[0]
        if (logins.get(str(c)) or {}).get("ok") is False or recorder_on(c):
            continue
        fix = env_cmd(c, "claude-move watch install")
        add("cli", t("d_watch", d=short(c), c=fix), True, {"do": "watch", "acct": acct})
    conf = notify_conf()
    add("misc", t("d_notify_on", l="/".join(map(str, conf["levels"]))) if conf["on"] else t("d_notify_off"))
    app = app_path()
    if WIN and app.exists():
        add("misc", t("d_app_ok"))
    if sys.platform == "darwin" and app.exists():
        ok = subprocess.run(["codesign", "--verify", "--deep", "--strict", str(app)], capture_output=True).returncode == 0
        add("misc", t("d_app_ok" if ok else "d_app_bad"), not ok)
    return items


def cmd_doctor(args):
    if args.refresh:
        refresh_official(args.config or ())
        print()
    items = doctor_items(args.config or ())
    for sec, head in (("desk", "d_desk"), ("cli", "d_cli"), ("misc", "d_misc")):
        print(t(head))
        for it in items:
            if it["sec"] == sec:
                print(("  ! " if it["warn"] else "  ") + it["text"])
    n = sum(1 for it in items if it["warn"])
    print()
    print(t("d_count", n=n) if n else t("d_fine"))


# ---------- panel: the fixed actions behind its buttons
def captured(fn):
    """Run fn, returning (ok, what it printed); a sys.exit message counts as a failure."""
    import contextlib
    import io
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        try:
            fn()
            ok = True
        except SystemExit as e:
            print(e.code if isinstance(e.code, str) else "")
            ok = False
    return ok, buf.getvalue()


def with_app_closed(fn):
    """Run fn with the desktop app quit first when it is open, and reopen it afterwards."""
    was = app_running()
    log = ""
    if was:
        log = t("p_quitting") + "\n"
        if not quit_app():
            return False, log + t("running")
    ok, out = False, ""
    try:
        ok, out = captured(fn)
    finally:
        if was:
            out += t("p_opening") + "\n"
            open_app()
    return ok, log + out


def claim_logins():
    """Name accounts signed in through the panel's Add CLI login once their login shows up."""
    pending = load(PENDING)
    if not isinstance(pending, dict) or not pending:
        return
    nm = names()
    left = {}
    for d, p in pending.items():
        acct = cli_account(Path(d))
        if not acct:
            if time.time() - (p.get("at") or 0) < 86400:
                left[d] = p
            continue
        if p.get("label") and not nm.get(acct) and p.get("expect") in (None, acct):
            nm[acct] = p["label"]
            save_names(nm)
    save_json(PENDING, left)


def open_login(cfg, who):
    """A terminal window running the CLI's own `claude auth login` for this config folder."""
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    open_command(term_script(f"login-{cfg.name.lstrip('.')}", None, {"CLAUDE_CONFIG_DIR": cfg},
                             [exe, "auth", "login", "--claudeai"],
                             before=[t("l_head", d=short(cfg)), t("l_hint", a=who)], after=[t("l_done")]))


def check_update():
    import urllib.request
    url = os.environ.get("CLAUDE_MOVE_UPDATE_URL", "https://api.github.com/repos/Layla-NL/claude-move/releases/latest")
    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "claude-move"})
    with urllib.request.urlopen(req, timeout=10) as r:
        d = json.loads(r.read().decode("utf-8"))
    tag = str(d.get("tag_name") or "").lstrip("v")
    ver = lambda v: tuple(int(x) for x in re.findall(r"\d+", v)[:3])
    return tag, d.get("html_url") or "", ver(tag) > ver(__version__)


def panel_accounts(extra=()):
    nm = names()
    out = {}
    for a in accounts():
        if a["sessions"]:
            e = out.setdefault(a["acct"], {"acct": a["acct"], "desk": True, "live": 0})
            e["live"] += sum(1 for _, d in a["sessions"] if not d.get("isArchived"))
    for c in cli_configs(extra):
        e = out.setdefault(cli_account(c), {"acct": cli_account(c), "desk": False, "live": 0})
        if "cli" not in e:
            e.update(cli=short(c), cli_home=c.resolve() == DESKTOP_HOME.resolve(), recorder=recorder_on(c),
                     settings=short(recorder_path(c)))
    for e in out.values():
        e["label"] = nm.get(e["acct"], "")
        e["name"] = e["label"] or e["acct"][:8]
    return sorted(out.values(), key=lambda e: e["name"].lower())


def desk_sessions(acct):
    hits = [a for a in accounts() if a["acct"] == acct]
    if not hits:
        return None
    a = max(hits, key=lambda a: len(a["sessions"]))  # the same org `to` would pick
    rows = [{"id": d["sessionId"], "title": d.get("title") or t("untitled"), "last": d.get("lastActivityAt") or 0,
             "archived": bool(d.get("isArchived"))} for _, d in a["sessions"]]
    return sorted(rows, key=lambda r: r["last"], reverse=True)


def cli_sessions(cfg, limit=30):
    files = []
    for f in cfg.glob("projects/*/*.jsonl"):
        try:
            files.append((f.stat().st_mtime, f))
        except OSError:
            pass
    home = project_dir_name(HOME) + "-"
    return [{"id": f.stem, "project": f.parent.name[len(home):] if f.parent.name.startswith(home) else f.parent.name,
             "title": first_prompt(f) or t("untitled"), "last": int(m * 1000),
             "in_desk": (DESKTOP_HOME / "projects" / f.parent.name / f.name).exists()}
            for m, f in sorted(files, reverse=True)[:limit]]


def run_list():
    nm = names()
    out = []
    files = sorted(RUNS.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True)[:20] if RUNS.is_dir() else []
    for f in files:
        d = load(f)
        if not isinstance(d, dict) or not d.get("sid"):
            continue
        tr = transcript_files(Path(d.get("cfg") or HOME / ".claude"), d["sid"])
        main = [x for x in tr if x.name == f"{d['sid']}.jsonl"]
        who = lambda a: nm.get(a or "", (a or "")[:8])
        out.append({"sid": d["sid"], "title": first_prompt(main[0]) if main else "", "name": who(d.get("acct")),
                    "started": d.get("started") or 0, "running": not d.get("ended") and pid_alive(d.get("pid")),
                    "switches": [{"at": x.get("at") or 0, "from": who(x.get("from")), "to": who(x.get("to"))}
                                 for x in d.get("switches") or []]})
    return out


SESSION_ID = re.compile(r"^(local_)?[0-9a-f-]{8,64}$")


def panel_api(method, path, q, body, extra=()):
    """Every button behind /api/: a fixed action, and every value from the page is checked against this Mac."""
    name = path[len("/api/"):]
    bad = (400, {"ok": False, "log": t("pt_bad")})
    accts = panel_accounts(extra)
    by = {a["acct"]: a for a in accts}
    acct = str(body.get("acct") or q.get("acct") or "")
    cfg = next((c for c in cli_configs(extra) if acct and cli_account(c) == acct), None)
    if method == "GET":
        if name == "accounts":
            claim_logins()
            return 200, {"accounts": panel_accounts(extra)}
        if name == "sessions":
            rows = desk_sessions(acct) if acct in by else None
            return (200, {"sessions": rows}) if rows is not None else bad
        if name == "backups":
            out = []
            nm = names()
            for b, m in backups()[:30]:
                if b.name.endswith("-before-undo"):
                    continue
                ok = isinstance(m, dict) and m.get("version") == 1
                who = nm.get(m.get("account", ""), m.get("account", "")[:8]) if ok else ""
                text = t("bk_line", n=b.name, w=time.strftime("%m-%d %H:%M", time.localtime(m.get("created", 0))),
                         c=len(m.get("replaced", [])) + len(m.get("added", [])), a=who) if ok else t("bk_old", n=b.name)
                out.append({"name": b.name, "ok": ok, "undone": bool(ok and m.get("undone")), "account": who, "text": text})
            return 200, {"backups": out}
        if name == "runs":
            return 200, {"runs": run_list()}
        if name == "search":
            needle = str(q.get("q") or "").strip().casefold()
            if not 0 < len(needle) <= 80:
                return bad
            out = []
            for a in accts:
                if a["desk"]:
                    out += [dict(x, acct=a["acct"], name=a["name"]) for x in desk_sessions(a["acct"]) or []
                            if needle in x["title"].casefold()]
            import sqlite3
            try:
                cli = [dict(x, cmd=resume_text(x["cfg"], x["cwd"], x["sid"]) if x["cwd"] else "")
                       for x in find_sessions(needle.split(), extra, 30)]
            except sqlite3.Error:
                cli = []
            return 200, {"sessions": sorted(out, key=lambda x: x["last"], reverse=True)[:40], "cli": cli}
        if name == "live":
            return 200, {"rows": live_sessions(extra), "tmux": bool(tmux("list-sessions")), "has_tmux": bool(tmux_bin()),
                         "conf": tmux_conf_on(), "block": tmux_conf_block(), "path": short(TMUX_CONF)}
        if name == "cli-sessions":
            if not cfg or cfg.resolve() == DESKTOP_HOME.resolve():
                return bad
            return 200, {"sessions": cli_sessions(cfg)}
        if name == "doctor":
            return 200, {"items": doctor_items(extra)}
        if name == "notify":
            return 200, notify_conf()
        if name == "crew":
            return 200, {"found": is_firstmate(FM_HOME), "info": crew_lines(), "accounts": crew_accounts(extra),
                         "sched": bool((load(SNAP_CONF) or {}).get("sched"))}
        if name == "update":
            try:
                tag, url, newer = check_update()
            except (OSError, ValueError) as e:
                return 200, {"ok": False, "log": t("pt_update_fail", e=e)}
            log = t("pt_update_new", v=tag, c=__version__, u=url) if newer else t("pt_update_none", c=__version__, v=tag or "-")
            return 200, {"ok": True, "newer": newer, "url": url if newer else "", "log": log}
        return 404, {}
    if name == "move":
        src, dst = str(body.get("from") or ""), str(body.get("to") or "")
        rng = str(body.get("range") or "3")
        if src not in by or dst not in by or not by[src]["desk"] or not by[dst]["desk"] or rng not in ("3", "7", "all", "pick"):
            return bad
        only = None
        if rng == "pick":
            ids = {r["id"] for r in desk_sessions(src) or []}
            only = [str(x) for x in body.get("only") or [] if str(x) in ids]
            if not only:
                return 200, {"ok": False, "log": t("nothing")}
        ns = argparse.Namespace(target=dst, source=src, days=float(rng) if rng in ("3", "7") else 3, all=rng == "all",
                                only=only, dry_run=bool(body.get("dry")))
        ok, log = captured(lambda: cmd_to(ns)) if ns.dry_run else with_app_closed(lambda: cmd_to(ns))
        return 200, {"ok": ok, "log": log}
    if name == "undo":
        bk = str(body.get("name") or "")
        if bk not in {b.name for b, m in backups() if isinstance(m, dict) and m.get("version") == 1}:
            return bad
        ns = argparse.Namespace(list=False, backup=bk, dry_run=bool(body.get("dry")))
        ok, log = captured(lambda: cmd_undo(ns)) if ns.dry_run else with_app_closed(lambda: cmd_undo(ns))
        return 200, {"ok": ok, "log": log}
    if name == "name":
        label = str(body.get("label") or "").strip()
        if acct not in by:
            return bad
        if len(label) > 32 or any(ord(ch) < 32 for ch in label):
            return 200, {"ok": False, "log": t("pt_label_bad")}
        nm = names()
        if label:
            nm[acct] = label
        else:
            nm.pop(acct, None)
        save_names(nm)
        return 200, {"ok": True, "log": t("pt_saved")}
    if name == "watch":
        if not cfg:
            return bad
        ok, log = captured(lambda: watch_set(recorder_path(cfg), bool(body.get("on"))))
        return 200, {"ok": ok, "log": log}
    if name == "login":
        nm = names()
        if acct:
            if acct not in by or not by[acct]["desk"]:
                return bad
            label = nm.get(acct, "")
            folder = re.sub(r"[^A-Za-z0-9-]", "", label)[:24] or acct[:8]
            who, new_label = label or acct[:8], None
        else:
            folder = str(body.get("name") or "").strip()
            if not re.fullmatch(r"[A-Za-z0-9-]{1,24}", folder):
                return 200, {"ok": False, "log": t("pt_login_bad")}
            who, new_label = t("pt_login_any"), folder
        target = HOME / f".claude-{folder}"
        if cli_account(target):
            return 200, {"ok": False, "log": t("pt_login_exists", d=short(target))}
        target.mkdir(exist_ok=True)
        pending = load(PENDING) or {}
        pending[str(target)] = {"label": new_label, "expect": acct or None, "at": time.time()}
        save_json(PENDING, pending)
        open_login(target, who)
        return 200, {"ok": True, "log": t("pt_login_opened", d=short(target), a=who)}
    if name == "notify":
        if body.get("test"):
            notify(t("n_title"), t("n_test"))
            return 200, {"ok": True, "log": t("n_sent")}
        conf = notify_conf()
        try:
            levels = sorted({int(x) for x in str(body.get("levels") or "").split(",") if x.strip()})
        except ValueError:
            levels = []
        if not levels or not all(1 <= x <= 100 for x in levels):
            return 200, {"ok": False, "log": t("pt_levels_bad")}
        conf.update(on=bool(body.get("on")), levels=levels)
        save_json(NOTIFY, conf)
        return 200, {"ok": True, "log": t("n_on", l="/".join(map(str, levels))) if conf["on"] else t("n_off")}
    if name == "import":
        if not cfg or cfg.resolve() == DESKTOP_HOME.resolve():
            return bad
        lines, n = [], 0
        for sid in [str(x) for x in body.get("ids") or [] if SESSION_ID.match(str(x))]:
            f = next(iter(cfg.glob(f"projects/*/{sid}.jsonl")), None)
            if not f:
                continue
            w = time.strftime("%m-%d %H:%M", time.localtime(f.stat().st_mtime))
            added = import_one(f, DESKTOP_HOME)
            n += added
            lines.append(t("imp_add" if added else "imp_skip", i=sid, w=w, t=first_prompt(f)))
        return 200, {"ok": True, "log": "\n".join(lines + [t("imp_done", n=n) if lines else t("nothing")])}
    if name == "look":
        cur = load(LOOK)
        cur = cur if isinstance(cur, dict) else {}
        if not {"accent", "theme", "lang"} & set(body):
            return bad
        if "accent" in body:
            a = body["accent"]
            if not isinstance(a, (int, float)) or isinstance(a, bool) or not 0 <= a <= 2:
                return bad
            cur["accent"] = round(float(a), 2)
        if "theme" in body:
            if body["theme"] not in ("auto", "light", "dark"):
                return bad
            cur["theme"] = body["theme"]
        if "lang" in body:
            if body["lang"] not in ("zh", "en"):
                return bad
            cur["lang"] = body["lang"]
            use_lang(body["lang"])
        save_json(LOOK, cur)
        return 200, {"ok": True}
    if name == "crew":
        do = body.get("do")
        if do == "pin":
            if not cfg or not is_firstmate(FM_HOME):
                return bad
            ok, log = captured(lambda: fm_pin_set(cfg))
            return 200, {"ok": ok, "log": log}
        if do == "snapshot":
            pin, err = fm_pin()
            if not pin:
                return 200, {"ok": False, "log": err or t("qs_noacct")}
            ok, log = write_snapshot(pin, snapshot_out(), refresh=True)
            return 200, {"ok": ok, "log": log}
        if do == "schedule":
            ok, log = snapshot_schedule(bool(body.get("on")), (load(SNAP_CONF) or {}).get("every", 10))
            return 200, {"ok": ok, "log": log}
        return bad
    if name == "resume":
        sid = str(body.get("sid") or "")
        if not SESSION_ID.match(sid) or sid.startswith("local_"):
            return bad
        found, err = find_transcript(sid, extra)
        if err:
            return 200, {"ok": False, "log": err}
        ok, log = resume_session(*found, extra=extra)
        return 200, {"ok": ok, "log": log}
    if name == "live":
        do = body.get("do")
        if do == "show":
            target = str(body.get("target") or "")
            if target not in {r["tmux"] for r in live_sessions(extra) if r["tmux"]}:
                return bad
            ok = tmux_show(target)
            return 200, {"ok": ok, "log": t("ps_shown", w=target) if ok else t("tm_none")}
        if do == "pin":
            sid = str(body.get("sid") or "")
            r = next((r for r in live_sessions(extra) if sid and r["sid"] == sid), None)
            if not r:
                return bad
            set_pin(sid, bool(body.get("on")))
            return 200, {"ok": True, "log": t("ps_pinned" if body.get("on") else "ps_unpinned", w=r["title"] or r["sid"][:8])}
        if do == "name":
            if not tmux("list-sessions"):
                return 200, {"ok": False, "log": t("tm_none")}
            return 200, {"ok": True, "log": t("tm_named", n=tmux_name(live_sessions(extra)))}
        if do == "conf":
            if not tmux_bin():
                return 200, {"ok": False, "log": t("tm_none")}
            ok, log = tmux_conf_set(bool(body.get("on")))
            return 200, {"ok": ok, "log": log}
        return bad
    if name == "doctor":
        _, log = captured(lambda: refresh_official(extra))
        return 200, {"ok": True, "log": log, "items": doctor_items(extra)}
    return 404, {}


