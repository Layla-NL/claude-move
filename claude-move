def doctor_items(extra=()):
    """What doctor finds, for the terminal and the panel: section, whether it needs a look, text, and the fix the
    panel can offer for it."""
    items = []

    def add(sec, text, warn=False, fix=None):
        items.append({"sec": sec, "warn": warn, "text": text, "fix": fix})

    nm = names()
    timeline = signin_timeline()
    signed = timeline[-1][1] if timeline else None
    if signed:
        add("desk", t("d_signed", a=nm.get(signed, signed[:8])))
    desk = {}
    for a in accounts():
        if a["sessions"]:
            desk.setdefault(a["acct"], a)
    for acct in desk:
        if not nm.get(acct):
            add("desk", t("d_unnamed", a=acct[:8]), True, {"do": "name", "acct": acct})
    logins = load(LOGINS) or {}
    plan_of = plans(extra)
    found = sorted(p for p in HOME.glob(".claude-*") if p.is_dir())
    found += [Path(os.path.expanduser(c)) for c in extra] + [HOME / ".claude"]
    where = {}
    for c in dict.fromkeys(found):
        acct = cli_account(c)
        if not acct:
            add("cli", t("d_cli_none", d=short(c)))
            continue
        where.setdefault(acct, []).append(c)
        st = logins.get(str(c))
        s = (t("d_ok_at" if st.get("ok") else "d_bad_at", w=ago(time.time() - st.get("at", 0)))
             if isinstance(st, dict) else t("d_unchecked"))
        plan = f' ({plan_of[acct]})' if plan_of.get(acct) else ""
        add("cli", t("d_cli_row", d=short(c), a=nm.get(acct, acct[:8]), p=plan, s=s))
    for acct, dirs in where.items():  # dirs[0] is the one cli_configs puts first, so the one claude-move uses
        if len(dirs) > 1:
            stale = [d for d in dirs[1:] if not (logins.get(str(d)) or {}).get("ok", True)]
            if len(stale) == len(dirs) - 1:
                add("cli", t("d_stale", a=nm.get(acct, acct[:8]), d=", ".join(short(d) for d in stale), u=short(dirs[0])))
            else:
                add("cli", t("d_dup", a=nm.get(acct, acct[:8]), ds=", ".join(short(d) for d in dirs), u=short(dirs[0])), True)
    for acct in desk:
        if acct not in where:
            add("cli", t("d_no_cli", a=nm.get(acct, acct[:8]), n=nm.get(acct) or "name"), True, {"do": "login", "acct": acct})
    for acct, dirs in where.items():
        c = dirs[0]
        if (logins.get(str(c)) or {}).get("ok") is False or recorder_on(c):
            continue
        fix = env_cmd(c, "claude-move watch install")
        add("cli", t("d_watch", d=short(c), c=fix), True, {"do": "watch", "acct": acct})
    conf = notify_conf()
    add("misc", t("d_notify_on", l="/".join(map(str, conf["levels"]))) if conf["on"] else t("d_notify_off"))
    app = app_path()
    if WIN and app.exists():
        add("misc", t("d_app_ok"))
    if sys.platform == "darwin" and app.exists():
        ok = subprocess.run(["codesign", "--verify", "--deep", "--strict", str(app)], capture_output=True).returncode == 0
        add("misc", t("d_app_ok" if ok else "d_app_bad"), not ok)
    return items


def cmd_doctor(args):
    if args.refresh:
        refresh_official(args.config or ())
        print()
    items = doctor_items(args.config or ())
    for sec, head in (("desk", "d_desk"), ("cli", "d_cli"), ("misc", "d_misc")):
        print(t(head))
        for it in items:
            if it["sec"] == sec:
                print(("  ! " if it["warn"] else "  ") + it["text"])
    n = sum(1 for it in items if it["warn"])
    print()
    print(t("d_count", n=n) if n else t("d_fine"))


