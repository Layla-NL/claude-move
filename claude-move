# $ per million input tokens; output, cache writes and cache reads scale from it as in the public price list
PRICE_IN = {"opus": 5.0, "fable": 5.0, "sonnet": 3.0, "haiku": 1.0}


def iso_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def api_dollars(model, u):
    fam = next((k for k in PRICE_IN if k in (model or "")), "opus")
    tokens = ((u.get("input_tokens") or 0) + 1.25 * (u.get("cache_creation_input_tokens") or 0)
              + 0.1 * (u.get("cache_read_input_tokens") or 0) + 5 * (u.get("output_tokens") or 0))
    return tokens * PRICE_IN[fam] / 1e6


def scan_file(path, start):
    """Usage and limit-hit records appended to one transcript since byte offset `start`."""
    recs, hits = [], []
    with open(path, "rb") as fh:
        fh.seek(start)
        data = fh.read()
    end = data.rfind(b"\n") + 1  # leave a half-written last line for the next run
    for raw in data[:end].splitlines():
        if b'"usage"' not in raw and b"usage_limit_reached" not in raw:
            continue
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        ts = iso_ts(rec.get("timestamp") or "")
        sid = rec.get("sessionId")
        if ts is None or not sid:
            continue
        ep = {"claude-desktop": "d", "cli": "c"}.get(rec.get("entrypoint"), "")
        info = (rec.get("apiErrorParams") or {}).get("rate_limit_info")
        if rec.get("apiError") == "usage_limit_reached" and isinstance(info, dict) and info.get("resetsAt"):
            hits.append([ts, sid, info.get("rateLimitType") or "", info["resetsAt"], ep])
            continue
        msg = rec.get("message") or {}
        u = msg.get("usage")
        if rec.get("type") == "assistant" and isinstance(u, dict) and msg.get("id") and msg.get("model") != "<synthetic>":
            recs.append([ts, sid, msg["id"], round(api_dollars(msg.get("model"), u), 6), ep])
    return recs, hits, start + end


def scan(roots):
    """Incrementally read transcripts under each root's projects/; cache per file by offset."""
    cache = load(CACHE) or {}
    if cache.get("v") != 2:
        cache = {"v": 2, "files": {}}
    files, cutoff, seen = cache["files"], time.time() - KEEP_DAYS * 86400, set()
    for root in roots:
        for p in (root / "projects").rglob("*.jsonl") if (root / "projects").is_dir() else []:
            try:
                st = p.stat()
            except OSError:
                continue
            if st.st_mtime < cutoff:
                continue
            key = str(p)
            seen.add(key)
            c = files.get(key)
            if not c or c["size"] > st.st_size or c.get("ino") != st.st_ino:
                c = files[key] = {"size": 0, "off": 0, "ino": st.st_ino, "recs": [], "hits": [], "root": str(root)}
            if st.st_size > c["off"]:
                recs, hits, off = scan_file(p, c["off"])
                c["recs"] += recs
                c["hits"] += hits
                c["off"], c["size"] = off, st.st_size
            c["recs"] = [r for r in c["recs"] if r[0] >= cutoff]
    for key in [k for k in files if k not in seen]:
        del files[key]
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(cache, separators=(",", ":")))
    recs, hits, dedup = [], [], set()
    for c in files.values():
        for r in c["recs"]:
            if r[2] not in dedup:  # a reply is written once per content block, and resumed sessions copy history
                dedup.add(r[2])
                recs.append(r + [c["root"]])
        hits += [h + [c["root"]] for h in c["hits"]]
    return recs, hits


def cli_account(cfg):
    """Account id the CLI config folder is signed into (from its .claude.json; no tokens are read)."""
    p = HOME / ".claude.json" if cfg == HOME / ".claude" else cfg / ".claude.json"
    d = load(p)
    oa = d.get("oauthAccount") if isinstance(d, dict) else None
    return oa.get("accountUuid") if isinstance(oa, dict) else None


def signin_timeline():
    """When each account was signed into the desktop app, from the app's log lines that name the account it is
    looking up (`cacheKey=acct:<id>`). Only ids and times are read. Returns [(epoch, account id)] at each change."""
    import re
    pat = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) .*?cacheKey=acct:([0-9a-f-]{36})")
    points = []
    for f in sorted(LOGS.glob("main*.log")) if LOGS.is_dir() else []:
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if "cacheKey=acct:" in line:
                        m = pat.match(line)
                        if m:
                            points.append((time.mktime(time.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")), m.group(2)))
        except OSError:
            continue
    points.sort()
    out = []
    for ts, acct in points:
        if not out or out[-1][1] != acct:
            out.append((ts, acct))
    return out


def signed_in(timeline, ts):
    if not timeline or ts < timeline[0][0] - 3600:
        return None
    acct = None
    for start, a in timeline:
        if start > ts:
            break
        acct = a
    return acct or timeline[0][1]


def owner_index(accts):
    """cliSessionId -> [(lastActivityAt seconds, account id)], one entry per account list holding the session."""
    idx = {}
    for a in accts:
        for _, d in a["sessions"]:
            if d.get("cliSessionId"):
                idx.setdefault(d["cliSessionId"], []).append(((d.get("lastActivityAt") or 0) / 1000, a["acct"]))
    for v in idx.values():
        v.sort()
    return idx


def owner(idx, sid, ts, fallback):
    """A session copied between accounts sits in several lists. The desktop app only bumps lastActivityAt in the
    account that is signed in, so a reply belongs to the first account whose entry was last active at or after it."""
    cands = idx.get(sid)
    if not cands:
        return fallback
    for last, acct in cands:
        if last >= ts - 60:
            return acct
    return cands[-1][1]


def week_window(hits7, now):
    """Weekly windows reset at a fixed time; step the last known reset forward to find the current one."""
    if not hits7:
        return None, None
    r = max(h[3] for h in hits7)
    if now < r:
        return r - WEEK, r
    n = int((now - r) // WEEK)
    return r + n * WEEK, r + (n + 1) * WEEK


def ago(sec):
    m = int(sec // 60)
    if ZH:
        return f"{m} 分钟" if m < 120 else f"{m // 60} 小时"
    return f"{m} min" if m < 120 else f"{m // 60} h"


def clock(ts):
    return time.strftime("%m-%d %H:%M", time.localtime(ts))


def usage_report(extra_cfgs=(), now=None):
    now = now or time.time()
    accts = accounts()
    idx = owner_index(accts)
    roots = [DESKTOP_HOME] + [Path(os.path.expanduser(c)) for c in extra_cfgs]
    fallback = {str(DESKTOP_HOME): None}
    for c in roots[1:]:
        fallback[str(c)] = cli_account(c)
    recs, hits = scan(roots)
    timeline = signin_timeline()

    def who(ts, sid, ep, root):
        # desktop replies run as whoever is signed into the app; CLI replies as the config folder's account
        if ep == "d":
            return signed_in(timeline, ts) or owner(idx, sid, ts, None)
        if ep == "c":
            return fallback.get(root)
        return owner(idx, sid, ts, fallback.get(root))

    by = {}
    for r in recs:
        by.setdefault(who(r[0], r[1], r[4], r[5]), {"recs": [], "hits": []})["recs"].append(r)
    for h in hits:
        by.setdefault(who(h[0], h[1], h[4], h[5]), {"recs": [], "hits": []})["hits"].append(h)
    official = load(LIMITS) or {}
    ids = {a["acct"] for a in accts if a["sessions"]} | {k for k in by if k} | set(official)
    rows = []
    for acct in ids:
        b = by.get(acct, {"recs": [], "hits": []})
        h7 = [h for h in b["hits"] if h[2] == "seven_day"]
        w0, w1 = week_window(h7, now)
        spent_week = sum(r[3] for r in b["recs"] if r[0] >= (w0 if w0 else now - WEEK))
        spent_5h = sum(r[3] for r in b["recs"] if r[0] >= now - FIVE_H)
        cool = [h for h in b["hits"] if h[3] > now]
        cool = max(cool, key=lambda h: h[3]) if cool else None
        off = official.get(acct)
        daily = [round(sum(r[3] for r in b["recs"] if now - (i + 1) * 86400 <= r[0] < now - i * 86400), 2)
                 for i in range(6, -1, -1)]
        rows.append({
            "acct": acct, "name": names().get(acct, "") or acct[:8],
            "cool": {"kind": cool[2], "until": cool[3]} if cool else None,
            "week_usd": spent_week, "five_usd": spent_5h, "week_reset": w1, "daily": daily,
            "official": off if isinstance(off, dict) and now - off.get("at", 0) < 3 * 86400 else None,
            "last": max((r[0] for r in b["recs"]), default=0)})
    unmapped = by.get(None)
    rows.sort(key=lambda r: r["last"], reverse=True)
    free = [r for r in rows if not r["cool"]]
    pct = lambda r: ((r["official"] or {}).get("seven_day") or {}).get("used_percentage")
    pick = min(free, key=lambda r: (pct(r) is None, pct(r) or 0, r["week_usd"])) if free else None
    first_back = min(rows, key=lambda r: r["cool"]["until"]) if rows and not free else None
    return {"now": now, "rows": rows, "pick": pick, "first_back": first_back,
            "unmapped_usd": sum(r[3] for r in unmapped["recs"] if r[0] >= now - WEEK) if unmapped else 0}


def row_text(r, now):
    parts = []
    off = r["official"]
    if off:
        parts.append(t("u_official", w=round((off.get("seven_day") or {}).get("used_percentage", 0)),
                       f=round((off.get("five_hour") or {}).get("used_percentage", 0)), a=ago(now - off["at"])))
    parts.append(t("u_spent", k=t("u_week") if r["week_reset"] else t("u_7d"), d=r["week_usd"]))
    parts.append(t("u_spent", k=t("u_5h"), d=r["five_usd"]))
    if r["week_reset"]:
        parts.append(t("u_reset", w=clock(r["week_reset"])))
    if r["cool"]:
        k = t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h")
        return t("u_cool", k=k, w=clock(r["cool"]["until"])) + " · " + " · ".join(parts)
    return t("u_ok") + "  " + " · ".join(parts)


def cmd_usage(args):
    print(t("u_scan"), file=sys.stderr)
    rep = usage_report(args.config or ())
    print(t("u_title"))
    for r in rep["rows"]:
        print(f"{r['name']:10} {row_text(r, rep['now'])}")
    if rep["unmapped_usd"] >= 1:
        print(f"{'-':10} {t('u_unmapped')}: " + t("u_spent", k=t("u_week"), d=rep["unmapped_usd"]))
    if rep["pick"]:
        print(t("u_pick", a=rep["pick"]["name"]))
    elif rep["first_back"]:
        print(t("u_pick_none", a=rep["first_back"]["name"], w=clock(rep["first_back"]["cool"]["until"])))
    print(t("u_notes"))
    if args.html:
        out = CONF / "usage.html"
        CONF.mkdir(parents=True, exist_ok=True)
        out.write_text(render_html(rep), encoding="utf-8")
        print(t("u_html", p=out))
        if not args.no_open and sys.platform == "darwin":
            subprocess.run(["open", str(out)], check=False)


def render_html(rep):
    from html import escape
    now = rep["now"]
    peak = max([max(r["daily"]) for r in rep["rows"]] + [1])
    days = [time.strftime("%m-%d", time.localtime(now - i * 86400)) for i in range(6, -1, -1)]
    cards = []
    for r in rep["rows"]:
        state = "cool" if r["cool"] else ("pick" if rep["pick"] is r else "ok")
        badge = {"cool": t("u_tag_cool"), "pick": t("u_tag_pick"), "ok": t("u_ok").strip()}[state]
        cool = ""
        if r["cool"]:
            k = t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h")
            cool = f'<p class="coolline">{escape(t("u_back", k=k, w=clock(r["cool"]["until"])))}</p>'
        week_label = t("u_week") if r["week_reset"] else t("u_7d")
        nums = (f'<div class="nums"><div><b>${r["week_usd"]:,.0f}</b><span>{escape(week_label)}</span></div>'
                f'<div><b>${r["five_usd"]:,.0f}</b><span>{escape(t("u_5h"))}</span></div></div>')
        meters = ""
        off = r["official"]
        if off:
            for key, label in (("seven_day", t("u_week")), ("five_hour", t("u_5h"))):
                if isinstance(off.get(key), dict):
                    pc = off[key].get("used_percentage", 0)
                    meters += (f'<div class="m"><span>{escape(label)}</span><div class="bar"><i style="width:{min(100, pc)}%">'
                               f'</i></div><b>{pc:.0f}%</b></div>')
            meters = (f'<div class="official"><p>{escape(t("u_off_head", a=ago(now - off["at"])))}</p>{meters}</div>')
        bars = "".join(
            f'<div class="day" title="{days[i]} ${v:,.0f}"><i style="height:{max(2, 100 * v / peak):.0f}%"></i>'
            f'<span>{days[i][3:]}</span></div>' for i, v in enumerate(r["daily"]))
        foot = f'<p class="foot">{escape(t("u_reset", w=clock(r["week_reset"])))}</p>' if r["week_reset"] else ""
        cards.append(f'<section class="card {state}"><header><h2>{escape(r["name"])}</h2>'
                     f'<span class="badge">{escape(badge)}</span></header>{cool}{nums}{meters}'
                     f'<div class="days">{bars}</div>{foot}</section>')
    if rep["unmapped_usd"] >= 1:
        cards.append(f'<section class="card muted"><header><h2>{escape(t("u_cli_head"))}</h2></header>'
                     f'<div class="nums"><div><b>${rep["unmapped_usd"]:,.0f}</b><span>{escape(t("u_7d"))}</span></div></div>'
                     f'<p class="foot">{escape(t("u_unmapped"))}</p></section>')
    if rep["pick"]:
        pick = t("u_pick", a=rep["pick"]["name"])
    elif rep["first_back"]:
        pick = t("u_pick_none", a=rep["first_back"]["name"], w=clock(rep["first_back"]["cool"]["until"]))
    else:
        pick = ""
    return f"""<!doctype html><html lang="{'zh' if ZH else 'en'}"><head><meta charset="utf-8">
