def pick(token, accts):
    token = token.strip()
    nm = names()
    hits = [a for a in accts if nm.get(a["acct"]) == token] or [a for a in accts if a["acct"].startswith(token)]
    if not hits:
        sys.exit(t("not_found", t=token))
    if len(hits) > 1:
        hits = sorted(hits, key=lambda a: len(a["sessions"]), reverse=True)
        print(t("many_orgs", t=token, n=len(hits), o=hits[0]["org"]))
    return hits[0]


def when(ms):
