  (r.sessions || []).filter(s => !s.archived).forEach(s => box.append(
    el("label", {className: "item"}, el("input", {type: "checkbox", value: s.id}), day(s.last) + "  " + s.title)));
}
$("mv-from").onchange = loadMoveList;
$("mv-range").onchange = loadMoveList;
const moveBody = dry => ({from: $("mv-from").value, to: $("mv-to").value, range: $("mv-range").value, dry,
  only: [...document.querySelectorAll("#mv-list input:checked")].map(i => i.value)});
$("mv-preview").onclick = async () => { say("mv-log", TT.p_working); say("mv-log", (await post("move", moveBody(true))).log); };
$("mv-go").onclick = async () => {
  if (state && state.running && !confirm(TT.pt_move_confirm)) return;
  say("mv-log", TT.p_working);
  say("mv-log", (await post("move", moveBody(false))).log);
};

async function loadUndo() {
  const box = $("undo-list");
  const r = await get("backups");
  box.innerHTML = "";
  if (!r.backups.length) empty(box, TT.no_backups);
  r.backups.forEach(b => {
    const row = el("div", {className: "item" + (b.ok && !b.undone ? "" : " dim")}, b.text + (b.undone ? " · " + TT.pt_undone : ""));
    if (b.ok && !b.undone) {
      const btn = el("button", {className: "ghost", textContent: TT.pt_undo_btn});
      btn.onclick = async () => {
        if (!confirm(fmt(TT.pt_undo_confirm, {a: b.account}))) return;
        say("undo-log", TT.p_working);
        say("undo-log", (await post("undo", {name: b.name})).log);
        loadUndo();
      };
      row.append(btn);
    }
    box.append(row);
  });
}

async function loadSess() {
  fill($("ss-acct"), (await accts()).filter(x => x.desk), state && state.signed && state.signed.acct);
  const r = await get("sessions", {acct: $("ss-acct").value});
  const box = $("ss-list");
  box.innerHTML = "";
  (r.sessions || []).forEach(x => box.append(el("div", {className: "item" + (x.archived ? " dim" : "")},
    day(x.last) + "  " + x.title + (x.archived ? " · " + TT.pt_archived : ""))));
}
$("ss-acct").onchange = loadSess;

async function loadImp() {
  fill($("im-acct"), (await accts()).filter(x => x.cli && !x.cli_home));
  const box = $("im-list");
  box.innerHTML = "";
  if (!$("im-acct").value) return;
  const r = await get("cli-sessions", {acct: $("im-acct").value});
  (r.sessions || []).forEach(x => box.append(el("label", {className: "item" + (x.in_desk ? " dim" : "")},
    el("input", {type: "checkbox", value: x.id, disabled: x.in_desk}),
    day(x.last) + "  " + x.project + "  " + x.title + (x.in_desk ? " · " + TT.pt_in_desk : ""))));
}
$("im-acct").onchange = loadImp;
$("im-go").onclick = async () => {
  const ids = [...document.querySelectorAll("#im-list input:checked")].map(i => i.value);
  say("im-log", TT.p_working);
  say("im-log", (await post("import", {acct: $("im-acct").value, ids})).log);
  loadImp();
};

async function loadRuns() {
  const box = $("runs-list");
  const r = await get("runs");
  box.innerHTML = "";
  if (!r.runs.length) empty(box, TT.pt_runs_none);
  r.runs.forEach(x => {
    box.append(el("div", {className: "item" + (x.running ? "" : " dim")}, fmt(TT.pt_run_line,
      {s: x.title || x.sid.slice(0, 8), a: x.name, n: x.switches.length, w: day(x.started * 1000)}) + " · " + (x.running ? TT.pt_running : TT.pt_ended)));
    x.switches.forEach(w => box.append(el("div", {className: "item sub-item"}, fmt(TT.pt_run_switch, {w: day(w.at * 1000), a: w.from, b: w.to}))));
  });
}

function showDoctor(items) {
  const box = $("doc-list");
  box.innerHTML = "";
  items.forEach(it => {
    const row = el("div", {className: "item" + (it.warn ? " warn" : "")}, (it.warn ? "! " : "") + it.text);
    if (it.fix) {
      const b = el("button", {className: "ghost", textContent: TT.pt_fix});
      b.onclick = () => fix(it.fix);
      row.append(b);
    }
    box.append(row);
  });
}
const loadDoc = async () => showDoctor((await get("doctor")).items);
$("doc-refresh").onclick = async () => {
  say("doc-log", TT.p_working);
  const r = await post("doctor", {});
  say("doc-log", r.log);
  showDoctor(r.items);
};
$("doc-login").onclick = () => login({});

async function loadNotify() {
  const r = await get("notify");
  $("nt-on").checked = r.on;
  $("nt-levels").value = r.levels.join(",");
}
$("nt-save").onclick = async () => { $("nt-msg").textContent = (await post("notify", {on: $("nt-on").checked, levels: $("nt-levels").value})).log; };
$("nt-test").onclick = async () => { $("nt-msg").textContent = (await post("notify", {test: true})).log; };
$("up-go").onclick = async () => { $("up-msg").textContent = TT.p_working; $("up-msg").textContent = (await get("update")).log; };

const loaders = {"t-move": loadMove, "t-undo": loadUndo, "t-sess": loadSess, "t-imp": loadImp, "t-runs": loadRuns,
  "t-doc": loadDoc, "t-notify": loadNotify};
Object.entries(loaders).forEach(([id, fn]) => $(id).addEventListener("toggle", () => { if ($(id).open) fn(); }));
try { JSON.parse(sessionStorage.getItem("open") || "[]").forEach(id => { if ($(id)) $(id).open = true; }); } catch (e) {}
"""

TOOLS_KEYS = ("p_working", "no_backups", "pt_move_confirm", "pt_undo_btn", "pt_undo_confirm", "pt_undone", "pt_archived",
              "pt_in_desk", "pt_runs_none", "pt_run_line", "pt_run_switch", "pt_running", "pt_ended", "pt_fix",
              "pt_rename_ask", "pt_rec_confirm", "pt_login_ask")


def tools_html():
    from html import escape
    e = lambda k: escape(t(k))
    opts = "".join(f'<option value="{v}">{e(k)}</option>' for v, k in (("3", "pt_r3"), ("7", "pt_r7"), ("all", "pt_rall"), ("pick", "pt_rpick")))
    return f'''<div class="toolbox">
<details id="t-move"><summary>{e("pt_move")}</summary>
<div class="row">{e("pt_from")} <select id="mv-from"></select> {e("pt_to")} <select id="mv-to"></select> <select id="mv-range">{opts}</select></div>
<div class="list" id="mv-list"></div>
<div class="row"><button class="ghost" id="mv-preview">{e("pt_preview")}</button><button id="mv-go">{e("pt_do_move")}</button></div>
<pre class="log" id="mv-log" hidden></pre></details>
<details id="t-undo"><summary>{e("pt_undo")}</summary><div class="list" id="undo-list"></div><pre class="log" id="undo-log" hidden></pre></details>
<details id="t-sess"><summary>{e("pt_sessions")}</summary><div class="row"><select id="ss-acct"></select></div><div class="list" id="ss-list"></div></details>
<details id="t-imp"><summary>{e("pt_import")}</summary><div class="row"><select id="im-acct"></select></div><div class="list" id="im-list"></div>
<div class="row"><button id="im-go">{e("pt_import_btn")}</button></div><pre class="log" id="im-log" hidden></pre></details>
<details id="t-runs"><summary>{e("pt_runs")}</summary><div class="list" id="runs-list"></div></details>
<details id="t-doc"><summary>{e("pt_doctor")}</summary><div class="list" id="doc-list"></div>
<div class="row"><button class="ghost" id="doc-refresh">{e("pt_doctor_refresh")}</button><button class="ghost" id="doc-login">{e("pt_login_new")}</button></div>
<pre class="log" id="doc-log" hidden></pre></details>
<details id="t-notify"><summary>{e("pt_notify")}</summary><div class="row"><label><input type="checkbox" id="nt-on"> {e("pt_notify_on")}</label>
<input type="text" id="nt-levels" size="10"> %<button class="ghost" id="nt-save">{e("pt_save")}</button><button class="ghost" id="nt-test">{e("pt_test")}</button></div>
<p class="dim" id="nt-msg"></p></details>
<details id="t-upd"><summary>{e("pt_update")}</summary><div class="row"><button class="ghost" id="up-go">{e("pt_update_btn")}</button></div>
<p class="dim" id="up-msg"></p></details>
</div>'''


def tools_js():
    return TOOLS_JS.replace("__TT__", json.dumps({k: t(k) for k in TOOLS_KEYS}, ensure_ascii=False))


def main(argv=None):
    if WIN:
        for name in ("stdout", "stderr"):
            if getattr(sys, name) is None:  # pythonw (the Start menu shortcut) has no console to print to
                setattr(sys, name, open(os.devnull, "w", encoding="utf-8"))
            elif hasattr(getattr(sys, name), "reconfigure"):  # a code page without some character must not stop a move
                getattr(sys, name).reconfigure(errors="replace")
    p = argparse.ArgumentParser(prog="claude-move",
                                description="Move the Claude desktop app's Code session list between accounts (copy only).")
    p.add_argument("--version", action="version", version=f"claude-move {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="accounts on this computer and their session counts").set_defaults(fn=cmd_list)
    s = sub.add_parser("sessions", help="live sessions of one account")
    s.add_argument("account")
    s.set_defaults(fn=cmd_sessions)
    n = sub.add_parser("name", help="give an account a short label")
    n.add_argument("account")
    n.add_argument("label")
    n.set_defaults(fn=cmd_name)
    to = sub.add_parser("to", help="copy recent live sessions into the target account")
    to.add_argument("target")
    to.add_argument("--from", dest="source", help="source account (default: the most recently used one)")
    to.add_argument("--days", type=float, default=3, help="only sessions used in the last N days (default 3)")
    to.add_argument("--all", action="store_true", help="every live session, regardless of age")
    to.add_argument("--only", action="append", metavar="TEXT",
                    help="only sessions whose title contains TEXT or whose id starts with it (repeatable)")
    to.add_argument("--dry-run", action="store_true", help="show what would be copied, change nothing")
    to.set_defaults(fn=cmd_to)
    u = sub.add_parser("undo", help="put the target account's list back the way it was before the last move")
    u.add_argument("--list", action="store_true", help="list backups")
    u.add_argument("--backup", help="undo this backup instead of the latest one")
    u.add_argument("--dry-run", action="store_true")
    u.set_defaults(fn=cmd_undo)
    ic = sub.add_parser("import-cli", help="copy CLI session transcripts from another config folder into ~/.claude")
    ic.add_argument("--config", required=True, help="the other config folder, e.g. ~/.claude-work")
    ic.add_argument("--project", help="project path (default: current folder) or its folder name under projects/")
    ic.add_argument("--session", action="append", help="session id or id prefix (repeatable)")
    ic.add_argument("--days", type=float, default=3, help="without --session: sessions touched in the last N days")
    ic.add_argument("--dry-run", action="store_true")
    ic.set_defaults(fn=cmd_import_cli)
    us = sub.add_parser("usage", help="quota per account: cooling/reset times, estimated use, official %% from the CLI")
    us.add_argument("--html", action="store_true", help="also write a panel page and open it")
    us.add_argument("--no-open", action="store_true", help="with --html: write the page but do not open it")
    us.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    us.add_argument("--refresh", action="store_true",
                    help="first ask the official /usage of every signed-in CLI config folder (~/.claude, ~/.claude-*)")
    us.set_defaults(fn=cmd_usage)
    pn = sub.add_parser("panel", help="open the quota panel with a button that moves sessions after you switch accounts")
    pn.add_argument("--port", type=int, default=0, help="port on 127.0.0.1 (default: any free port)")
    pn.add_argument("--no-open", action="store_true")
    pn.add_argument("--here", action="store_true", help="run in this process even inside the desktop app's terminal")
    pn.add_argument("--idle", type=float, default=0, help="stop after this many seconds without the page open (default: never)")
    pn.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    pn.set_defaults(fn=cmd_panel)
    ap = sub.add_parser("app", help="install a double-clickable launcher that opens the panel: Claude Move.app on "
                                    "macOS, a Start menu shortcut on Windows")
    ap.add_argument("action", choices=["install", "uninstall"])
    ap.add_argument("--dir", help="where to put it (default ~/Applications; on Windows the Start menu)")
    ap.add_argument("--no-dock", action="store_true", help="do not add it to the Dock (Windows: no desktop shortcut)")
    ap.add_argument("--icon", help="use this image as the icon (PNG/JPEG, ideally 1024x1024; on Windows PNG or ICO)")
    ap.set_defaults(fn=cmd_app)
    tm = sub.add_parser("term", help="open a Terminal window running Claude Code with that account's CLI login")
    tm.add_argument("account", help="label or id prefix of an account signed in under ~/.claude or ~/.claude-*")
    tm.add_argument("--auto", action="store_true", help="through claude-move run: switch account at a usage limit")
    tm.add_argument("--rc", action="store_true",
                    help="start it as a Remote Control session named after the account, so the phone app can join")
    tm.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    tm.set_defaults(fn=cmd_term)
    rn = sub.add_parser("run", help="run Claude Code as an account; at a usage limit, move the session to the account "
                                    "with the most left and resume it there")
    rn.add_argument("account", help="label or id prefix of an account with a CLI login")
    rn.add_argument("--rc", action="store_true", help="as a Remote Control session named after the account")
    rn.add_argument("--resume", metavar="ID", help="resume this session id instead of starting a new one")
    rn.add_argument("--config", action="append", help="also use this CLI config folder (repeatable)")
    rn.add_argument("claude_args", nargs="*", help="more arguments for claude, after --")
    rn.set_defaults(fn=cmd_run)
    nt = sub.add_parser("notify", help="system notifications when an account's official %% passes 75/90/95%%")
    nt.add_argument("action", choices=["on", "off", "status", "test"])
    nt.add_argument("--levels", help="comma-separated levels, e.g. 80,95")
    nt.set_defaults(fn=cmd_notify)
    dr = sub.add_parser("doctor", help="check accounts, CLI logins, duplicates, the status line recorder and the app")
    dr.add_argument("--refresh", action="store_true", help="first ask each CLI login its official /usage")
    dr.add_argument("--config", action="append", help="also check this CLI config folder (repeatable)")
    dr.set_defaults(fn=cmd_doctor)
    w = sub.add_parser("watch", help="record official CLI rate limits from the Claude Code status line")
    w.add_argument("action", choices=["install", "uninstall", "record"])
    w.set_defaults(fn=cmd_watch)
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
