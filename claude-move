    theme_attr = f' data-theme="{lk["theme"]}"' if lk["theme"] != "auto" else ""
    refresh = (f'<label class="search" data-tip="{tip(t("pp_search_tip"))}">{icon("search")}<input type="search" id="q" '
               f'placeholder="{E(t("pp_search"))}" autocomplete="off"></label>'
               f'<button class="ib raised" type="button" id="refresh" data-tip="{tip(t("p_refresh") + chr(10) + t("pp_refresh"))}">{icon("refresh")}</button>'
               f'<button class="ib raised" type="button" id="theme" data-theme="{lk["theme"]}" data-tip="{tip(t("pp_theme_" + lk["theme"]))}">'
               f'{icon({"auto": "contrast", "light": "sun", "dark": "moon"}[lk["theme"]])}</button>'
               f'<button class="ib raised lang" type="button" id="lang" data-to="{"en" if ZH else "zh"}" data-tip="{tip(t("pp_lang_tip"))}">{E(t("pp_lang_to"))}</button>'
               if live else "")
    found = '<section class="panel found" id="found" hidden></section>' if live else ""
    nxt = []
    for r in rep["rows"]:
        marks = [{"k": row_label(x), "p": round(x.get("percent") or 0), "at": x["resets_at"]}
                 for x in (r["official"] or {}).get("rows", []) if x.get("resets_at") and now < x["resets_at"] <= now + WEEK]
        until = r["cool"]["until"] if r["cool"] else None
        if marks or until:
            nxt.append({"name": r["name"], "marks": marks, "cool": until,
                        "cool_text": t("u_back", k=t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h"),
                                       w=clock(until)) if until else ""})
    timeline = (f'<section class="panel next"><h2 data-tip="{tip(t("pp_next_tip"))}">{icon("clock")}{E(t("pp_next"))}</h2>'
                f'<div id="next"></div></section>' if nxt else "")
    ramp = (f'<span data-tip="{tip(t("pp_legend_tip"))}">{E(t("pp_legend"))}</span><span class="ramp" id="ramp" aria-hidden="true">'
            + "".join(f'<b{" class=up" if i == len(LEVELS) - 1 else ""} style="left:{v}%">{v}</b>' for i, v in enumerate(LEVELS))
            + f'</span><span class="grey" aria-hidden="true"></span><span>{E(t("pp_none"))}</span>')
    if live:
        ramp += (f'<label data-tip="{tip(t("pp_accent_tip"))}">{E(t("pp_accent"))} <input type="range" id="accent" min="0" max="200" '
                 f'value="{round(look()["accent"] * 100)}"></label>')
        dock = [("t-move", "pick", "pp_d_move", "pt_move"), ("t-undo", "undo", "pp_d_undo", "pt_undo"),
                ("t-sess", "list", "pp_d_sess", "pt_sessions"), ("t-imp", "import", "pp_d_imp", "pt_import"),
                ("t-runs", "loop", "pp_d_runs", "pt_runs"), ("t-doc", "pulse", "pp_d_doc", "pt_doctor"),
                ("t-notify", "bell", "pp_d_notify", "pt_notify"), ("", "adduser", "pp_d_login", "pt_login_new"),
                ("t-upd", "update", "pp_d_upd", "pt_update")]
        if is_firstmate(FM_HOME):
            dock.insert(-2, ("t-crew", "anchor", "pp_d_crew", "pt_crew_tip"))
        tools = "".join(f'<button class="tool" type="button" {f"data-open={q}" if q else "id=dock-login"} aria-pressed="false" '
                        f'data-tip="{tip(t(k2))}">{icon(ic)}{E(t(k))}</button>' for q, ic, k, k2 in dock)
        bottom = f'<section class="panel dock"><div class="tools">{tools}</div><div class="legend">{ramp}</div>{tools_html()}</section>'
    else:
        bottom = f'<section class="panel dock"><div class="legend">{ramp}</div></section>'
    heat = f'''<section class="panel heat" aria-label="{E(t("pp_heat"))}"><div class="hhead">
<h2 data-tip="{tip(t("pp_heat_tip"))}">{icon("flame")}{E(t("pp_heat"))}</h2><span class="total" id="h-total"></span>
<span class="seg" id="h-acct" role="group"></span><span class="scale" aria-hidden="true">{E(t("pp_less"))}<i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i>{E(t("pp_more"))}</span></div>
<div class="maps"><div><p class="cap" data-tip="{tip(t("pp_cal_tip"))}">{E(t("pp_cal"))}</p><div class="hm" id="h-cal"></div></div>
<div><p class="cap" id="h-hcap" data-tip="{tip(t("pp_hours_tip"))}"></p><div class="hm" id="h-hour"></div></div></div>
<div class="dayinfo" id="h-day" hidden></div></section>'''
    data = {"heat": rep.get("heat"), "accent": look()["accent"], "pick": rep["pick"]["acct"] if rep["pick"] else "",
            "now": now, "next": nxt, "ticks": t("pp_ticks"),
            "T": {k: t(k) for k in ("pp_used", "pp_resets", "pp_idle", "pp_avg", "pp_hours", "pp_cal", "pp_all_accts",
                                    "pp_wd", "pp_wdfmt", "pp_months", "pp_resets")}}
    blob = json.dumps(data, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
    sprite = ('<svg width="0" height="0" style="position:absolute" aria-hidden="true">'
              + "".join(f'<symbol id="i-{k}" viewBox="0 0 24 24">{v}</symbol>' for k, v in ICONS.items()) + "</svg>")
    return f"""<!doctype html><html lang="{'zh' if ZH else 'en'}"{theme_attr}><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Claude Move</title><link rel="icon" id="favicon" href="data:,">
<style>{PANEL_CSS}{TOOLS_CSS if live else ""}</style></head><body>{sprite}<div id="tip" role="tooltip"></div><main>
<div class="top"><div><h1>Claude Move <span class="info" data-tip="{tip(t("u_title") + chr(10) + chr(10) + t("u_notes") + (chr(10) + chr(10) + t("pp_keys") if live else ""))}">{icon("info")}</span></h1>
<div class="sub">{E(t("pp_demo") if live and live.get("demo") else t("u_head"))} · {E(clock(now))} · {__version__}</div></div><div class="topr">{advice}{refresh}</div></div>
{found}{live_bar(live)}<div class="grid">{"".join(cards)}</div>{live_html() if live else ""}{timeline}{heat}{bottom}</main>
<script>{PANEL_JS.replace("__DATA__", blob)}</script>{live_script(live)}</body></html>"""


def live_bar(live):
    if not live:
        return ""
    from html import escape as E
    return f'''<section class="panel move" id="live">
<div class="who" id="who">{icon("desk")}<span id="signed">…</span><small id="from"></small></div><span class="sp"></span>
<button class="tog" type="button" id="auto" aria-pressed="false" data-tip="{tip(t("p_auto"))}">{icon("loop")}{E(t("pp_auto"))}</button>
<button class="tog" type="button" id="all" aria-pressed="false" data-tip="{tip(t("p_all"))}">{icon("layers")}{E(t("pp_all"))}</button>
<button class="go" type="button" id="go" disabled>{icon("move")}<b id="gotext">…</b></button>
<pre class="log" id="log" hidden></pre></section>'''


def live_script(live):
    if not live:
        return ""
    texts = {k: t(k) for k in ("p_signed", "p_unknown", "p_go", "p_go_same", "p_working", "p_copied", "p_confirm",
                               "p_term_done", "p_step1", "p_step2", "pp_last", "pp_search_none", "pp_bring",
                               "pp_theme_auto", "pp_theme_light", "pp_theme_dark", "pp_go", "pp_resume", "pp_copy_cmd",
                               "pp_cli_tag")}
    return f"""<script>
const T = {json.dumps(texts, ensure_ascii=False)}, KEY = {json.dumps(live["token"])};
const fmt = (s, o) => s.replace(/\\{{(\\w+)\\}}/g, (_, k) => o[k] ?? "");
const api = (path, body) => fetch(path, {{method: body ? "POST" : "GET", headers: {{"X-Token": KEY, "Content-Type": "application/json"}},
  body: body ? JSON.stringify(body) : undefined}}).then(r => r.json());
const byId = id => document.getElementById(id);
const pressed = id => byId(id).getAttribute("aria-pressed") === "true";
const flash = (b, text) => {{
  const old = b.dataset.tip; b.dataset.tip = text; b.classList.add("done"); CM.tip(b);
  setTimeout(() => {{ b.dataset.tip = old; b.classList.remove("done"); }}, 1600);
}};
const showLog = text => {{ const log = byId("log"); log.hidden = false; log.textContent = text; }};
let state = null;
async function poll() {{
  try {{ state = await api("/state"); }} catch (e) {{ return; }}
  const go = byId("go");
  byId("signed").textContent = state.signed ? state.signed.name : "?";
  byId("who").dataset.tip = (state.signed ? fmt(T.p_signed, {{a: state.signed.name}}) : T.p_unknown) + "\\n" + T.p_step1;
  byId("from").textContent = state.source ? fmt(T.pp_last, {{a: state.source.name}}) : "";
  if (state.signed && state.source) {{
    byId("gotext").textContent = state.source.name + " → " + state.signed.name;
    go.dataset.tip = fmt(T.p_go, {{s: state.source.name, a: state.signed.name}}) + "\\n" + T.p_step2;
    go.disabled = !!state.busy;
  }} else {{ byId("gotext").textContent = T.p_go_same; go.dataset.tip = T.p_step1; go.disabled = true; }}
  CM.desk(state.signed && state.signed.acct);
}}
byId("go").onclick = async () => {{
  if (!state || !state.signed || !confirm(fmt(T.p_confirm, {{a: state.signed.name}}))) return;
  showLog(T.p_working);
  byId("go").disabled = true;
  const r = await api("/switch", {{to: state.signed.acct, all: pressed("all")}});
  showLog(r.log); if (r.ok) setTimeout(() => location.reload(), 4000);
}};
byId("refresh").onclick = async () => {{
  showLog(T.p_working); byId("refresh").classList.add("spin");
  const r = await api("/refresh", {{}}); showLog(r.log); setTimeout(() => location.reload(), 1200);
}};
document.querySelectorAll("[data-copy]").forEach(b => b.onclick = () =>
  navigator.clipboard.writeText(b.dataset.copy).then(() => flash(b, T.p_copied)));
document.querySelectorAll("[data-term]").forEach(b => b.onclick = async () => {{
  const r = await api("/terminal", {{acct: b.dataset.term, rc: !!b.dataset.rc, auto: pressed("auto")}});
  if (r.ok) flash(b, T.p_term_done); else showLog(r.log);
}});
const setPressed = (id, on) => byId(id).setAttribute("aria-pressed", on ? "true" : "false");
try {{ setPressed("auto", localStorage.getItem("auto") === "1"); }} catch (e) {{}}
byId("auto").onclick = () => {{ setPressed("auto", !pressed("auto")); try {{ localStorage.setItem("auto", pressed("auto") ? "1" : "0"); }} catch (e) {{}} }};
byId("all").onclick = () => setPressed("all", !pressed("all"));
CM.saveAccent = v => api("/api/look", {{accent: v}});
const THEMES = {{auto: ["light", "sun"], light: ["dark", "moon"], dark: ["auto", "contrast"]}};
byId("theme").onclick = () => {{
  const b = byId("theme"), [next, ic] = THEMES[b.dataset.theme];
  if (next === "auto") delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = next;
  b.dataset.theme = next; b.dataset.tip = T["pp_theme_" + next];
  b.innerHTML = '<svg class="i" aria-hidden="true"><use href="#i-' + ic + '"/></svg>'; CM.tip(b);
  api("/api/look", {{theme: next}});
}};
byId("lang").onclick = async () => {{ await api("/api/look", {{lang: byId("lang").dataset.to}}); location.reload(); }};
const syncDock = () => document.querySelectorAll("[data-open]").forEach(b =>
  b.setAttribute("aria-pressed", byId(b.dataset.open).open ? "true" : "false"));
document.querySelectorAll("[data-open]").forEach(b => b.onclick = () => {{
  const d = byId(b.dataset.open), on = !d.open;
  document.querySelectorAll(".toolbox details").forEach(x => {{ x.open = false; }});
  d.open = on;
  if (on) setTimeout(() => d.scrollIntoView({{block: "nearest", behavior: "smooth"}}), 30);
}});
document.querySelectorAll(".toolbox details").forEach(d => d.addEventListener("toggle", syncDock));
const q = byId("q"), found = byId("found");
let typing = 0;
q.oninput = () => {{ clearTimeout(typing); typing = setTimeout(search, 250); }};
async function search() {{
  const v = q.value.trim();
  if (!v) {{ found.hidden = true; return; }}
  const r = await api("/api/search?q=" + encodeURIComponent(v));
  found.hidden = false; found.innerHTML = "";
  if (!(r.sessions || []).length && !(r.cli || []).length) {{
    const p = document.createElement("p"); p.textContent = T.pp_search_none; found.append(p); return;
  }}
  const ib = (ic, tipText, fn) => {{
    const b = el("button", {{className: "ib", type: "button", innerHTML: '<svg class="i"><use href="#i-' + ic + '"/></svg>'}});
    b.dataset.tip = tipText; b.onclick = () => fn(b); return b;
  }};
  (r.cli || []).forEach(x => {{
    const row = el("div", {{className: "row"}}, el("span", {{className: "who2", textContent: x.name + " · " + T.pp_cli_tag}}),
      el("span", {{className: "t"}}, x.title, el("span", {{className: "snip", textContent: x.snippet}})), el("small", {{textContent: day(x.last)}}));
    const tmuxed = x.live && !x.live.startsWith("pid ");
    if (tmuxed) row.append(ib("term", T.pp_go + " · " + x.live, async () => showLog((await api("/api/live", {{do: "show", target: x.live}})).log)));
    else if (!x.live) row.append(ib("loop", T.pp_resume, async () => {{ showLog(T.p_working); showLog((await api("/api/resume", {{sid: x.sid}})).log); }}));
    if (x.cmd) row.append(ib("copy", T.pp_copy_cmd, b => navigator.clipboard.writeText(x.cmd).then(() => flash(b, T.p_copied))));
    found.append(row);
  }});
  r.sessions.forEach(x => {{
    const row = document.createElement("div");
    row.className = "row";
    row.innerHTML = '<span class="who2"></span><span class="t"></span><small></small>';
    row.children[0].textContent = x.name; row.children[1].textContent = x.title; row.children[2].textContent = day(x.last);
    if (state && state.signed && state.signed.acct !== x.acct) {{
      const b = document.createElement("button");
      b.className = "ib"; b.type = "button"; b.innerHTML = '<svg class="i"><use href="#i-move"/></svg>';
      b.dataset.tip = fmt(T.pp_bring, {{a: state.signed.name}});
      b.onclick = async () => {{
        if (!confirm(fmt(T.p_confirm, {{a: state.signed.name}}))) return;
        showLog(T.p_working);
        showLog((await api("/api/move", {{from: x.acct, to: state.signed.acct, range: "pick", only: [x.id]}})).log);
      }};
      row.append(b);
    }}
    found.append(row);
  }});
}}
document.addEventListener("keydown", e => {{
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  const tag = (e.target.tagName || "").toLowerCase();
  if (e.key === "Escape") {{
    if (tag === "input") e.target.blur();
    found.hidden = true;
    document.querySelectorAll(".toolbox details").forEach(x => {{ x.open = false; }});
    return;
  }}
  if (["input", "textarea", "select"].includes(tag)) return;
  if (e.key === "/") {{ e.preventDefault(); q.focus(); }}
  else if (e.key === "r" || e.key === "R") byId("refresh").click();
  else if (/^[1-9]$/.test(e.key)) {{
    const card = document.querySelectorAll(".card")[+e.key - 1], b = card && card.querySelector("[data-term]:not([data-rc])");
    if (b) b.click();
  }}
}});
poll(); setInterval(poll, 3000);
{tools_js()}
byId("dock-login").onclick = () => login({{}});
syncDock();
</script>"""


