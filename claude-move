def quit_app():
    cmd = os.environ.get("CLAUDE_MOVE_QUIT_CMD")
    subprocess.run(cmd, shell=True) if cmd else subprocess.run(["osascript", "-e", 'tell application "Claude" to quit'], check=False)
    for _ in range(60):
        if not app_running():
            return True
        time.sleep(0.5)
    return False


def open_app():
    cmd = os.environ.get("CLAUDE_MOVE_OPEN_CMD")
    subprocess.run(cmd, shell=True) if cmd else subprocess.run(["open", "-a", "Claude"], check=False)


def switch_to(acct, include_all):
    """The panel's button: the desktop app is already signed into `acct`. Quit it, copy the sessions in, reopen."""
    import contextlib
    import io
    timeline = signin_timeline()
    signed = timeline[-1][1] if timeline else None
    buf = io.StringIO()
    if signed != acct:
        return False, t("p_not_signed")
    target = next((a for a in accounts() if a["acct"] == acct), None)
    if not target:
        return False, t("p_no_folder")
    with contextlib.redirect_stdout(buf):
        print(t("p_quitting"))
        if not quit_app():
            return False, buf.getvalue() + t("running")
        try:
            cmd_to(argparse.Namespace(target=acct, source=None, days=3, all=include_all, only=None, dry_run=False))
            ok = True
        except SystemExit as e:
            print(e.code if isinstance(e.code, str) else "")
            ok = False
        print(t("p_opening"))
        open_app()
    return ok, buf.getvalue()


def inside_desktop_app():
    """True when this process descends from the Claude desktop app (its terminal pane, a Code session)."""
    if os.environ.get("CLAUDE_MOVE_SKIP_APP_CHECK") == "1":
        return False
    pid = os.getppid()
    for _ in range(30):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        except OSError:
            return False
        if not out:
            return False
        ppid, _, comm = out.partition(" ")
        if "/Claude.app/" in comm:
            return True
        if not ppid.strip().isdigit() or int(ppid) <= 1:
            return False
        pid = int(ppid)
    return False


def cmd_panel(args):
    import secrets
    if not args.here and inside_desktop_app():
        # quitting the app from the panel would take this process down with it; run on our own instead
        app = Path(os.path.expanduser("~/Applications")) / APP_NAME
        if app.exists():
            subprocess.run(["open", str(app)], check=False)
            print(t("p_detached_app"))
            return
        cmd = [sys.executable, str(Path(__file__).resolve()), "panel", "--here", "--idle", str(args.idle or 1800)]
        for c in args.config or ():
            cmd += ["--config", c]
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        print(t("p_detached"))
        return
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse
    import threading
    import urllib.request
    old = load(PANEL)
    if isinstance(old, dict) and old.get("url") and pid_alive(old.get("pid")):
        try:  # one panel at a time: a second launch just brings the running one back
            base, tok = old["url"].split("/?t=")
            req = urllib.request.Request(base + "/state", headers={"X-Token": tok})
            urllib.request.urlopen(req, timeout=3).read()
            print(t("p_url", u=old["url"]), flush=True)
            if not args.no_open and sys.platform == "darwin":
                subprocess.run(["open", old["url"]], check=False)
            return
        except (OSError, ValueError):
            pass
    token = secrets.token_urlsafe(18)
    busy = {"on": False}
    seen = {"t": time.time()}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def allowed(self):
            host = self.headers.get("Host", "")
            if host != f"127.0.0.1:{self.server.server_port}":  # no DNS rebinding
                return False
            q = parse_qs(urlparse(self.path).query)
            ok = self.headers.get("X-Token") == token or q.get("t", [""])[0] == token
            if ok:
                seen["t"] = time.time()
            return ok

        def send(self, code, body, kind="application/json"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", kind + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if not self.allowed():
                return self.send(403, "{}")
            path = urlparse(self.path).path
            if path == "/":
                rep_ = usage_report(args.config or ())
                return self.send(200, render_html(rep_, live={"token": token}), "text/html")
            if path == "/state":
                accts = accounts()
                timeline = signin_timeline()
                signed = timeline[-1][1] if timeline else None
                others = [a for a in accts if a["acct"] != signed and a["sessions"]]
                src = max(others, key=lambda a: a["last"]) if others else None
                nm = names()
                return self.send(200, json.dumps({
                    "signed": {"acct": signed, "name": nm.get(signed, signed[:8])} if signed else None,
                    "source": {"acct": src["acct"], "name": show(src)} if src else None, "busy": busy["on"]}))
            self.send(404, "{}")

        def do_POST(self):
            if not self.allowed():
                return self.send(403, "{}")
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                body = {}
            path = urlparse(self.path).path
            if path == "/switch":
                if busy["on"]:
                    return self.send(409, json.dumps({"ok": False, "log": t("p_busy")}))
                busy["on"] = True
                try:
                    ok, log = switch_to(str(body.get("to") or ""), bool(body.get("all")))
                finally:
                    busy["on"] = False
                return self.send(200, json.dumps({"ok": ok, "log": log}, ensure_ascii=False))
            if path == "/terminal":  # only an account's own signed-in config folder, only to run `claude`
                acct = str(body.get("acct") or "")
                cfg = next((c for c in cli_configs(args.config or ()) if acct and cli_account(c) == acct), None)
                if not cfg:
                    return self.send(404, json.dumps({"ok": False, "log": t("t_none", t=acct[:8])}, ensure_ascii=False))
                open_terminal(cfg)
                return self.send(200, json.dumps({"ok": True, "log": ""}))
            if path == "/refresh":
                import contextlib
                import io
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    refresh_official(args.config or ())
                return self.send(200, json.dumps({"ok": True, "log": buf.getvalue()}, ensure_ascii=False))
            self.send(404, "{}")

    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{srv.server_port}/?t={token}"
    CONF.mkdir(parents=True, exist_ok=True)
    PANEL.write_text(json.dumps({"pid": os.getpid(), "url": url}) + "\n")
    os.chmod(PANEL, 0o600)
    print(t("p_url", u=url), flush=True)
    if not args.no_open and sys.platform == "darwin":
        subprocess.run(["open", url], check=False)

    def idle_watch():  # the open page polls every few seconds, so this only fires after the tab is gone
        while True:
            time.sleep(5)
            if args.idle and not busy["on"] and time.time() - seen["t"] > args.idle:
                srv.shutdown()
                return

    threading.Thread(target=idle_watch, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        cur = load(PANEL)
        if isinstance(cur, dict) and cur.get("pid") == os.getpid():
            PANEL.unlink()


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


