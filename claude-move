def active(a, days, include_all):
    cutoff = (time.time() - days * 86400) * 1000
    return [(f, d) for f, d in a["sessions"]
            if not d.get("isArchived") and (include_all or (d.get("lastActivityAt") or 0) >= cutoff)]


def kernel32():
    """Windows: kernel32 with the few calls used here typed, so 64-bit handles are not cut short."""
    import ctypes
    from ctypes import wintypes as w
    k = ctypes.WinDLL("kernel32", use_last_error=True)
    k.OpenProcess.restype, k.OpenProcess.argtypes = w.HANDLE, [w.DWORD, w.BOOL, w.DWORD]
    k.CloseHandle.argtypes = [w.HANDLE]
    k.GetExitCodeProcess.argtypes = [w.HANDLE, ctypes.POINTER(w.DWORD)]
    k.QueryFullProcessImageNameW.argtypes = [w.HANDLE, w.DWORD, w.LPWSTR, ctypes.POINTER(w.DWORD)]
    k.CreateToolhelp32Snapshot.restype, k.CreateToolhelp32Snapshot.argtypes = w.HANDLE, [w.DWORD, w.DWORD]
    return k


def win_procs():
    """Windows: {pid: (parent pid, exe)} from a process snapshot; claude.exe entries carry their full path."""
    import ctypes
    from ctypes import wintypes as w

    class Entry(ctypes.Structure):
        _fields_ = [("dwSize", w.DWORD), ("cntUsage", w.DWORD), ("pid", w.DWORD), ("heap", ctypes.c_void_p),
                    ("module", w.DWORD), ("threads", w.DWORD), ("ppid", w.DWORD), ("prio", w.LONG),
                    ("flags", w.DWORD), ("exe", w.WCHAR * 260)]
    k = kernel32()
    k.Process32FirstW.argtypes = k.Process32NextW.argtypes = [w.HANDLE, ctypes.POINTER(Entry)]
    out = {}
    snap = k.CreateToolhelp32Snapshot(2, 0)  # TH32CS_SNAPPROCESS
    if not snap or snap == ctypes.c_void_p(-1).value:
        return out
    try:
        e = Entry()
        e.dwSize = ctypes.sizeof(Entry)
        ok = k.Process32FirstW(snap, ctypes.byref(e))
        while ok:
            out[e.pid] = (e.ppid, e.exe)
            ok = k.Process32NextW(snap, ctypes.byref(e))
    finally:
        k.CloseHandle(snap)
    for pid, (ppid, exe) in out.items():
        if exe.lower() == "claude.exe":
            h = k.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
            if h:
                buf, n = ctypes.create_unicode_buffer(32768), w.DWORD(32768)
                if k.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n)):
                    out[pid] = (ppid, buf.value)
                k.CloseHandle(h)
    return out


def desktop_exe(path):
    """Windows: whether an exe path is the desktop app (an Electron build) rather than the claude CLI."""
    p = path.replace("/", "\\").lower()
    if not p.endswith("\\claude.exe"):
        return False
    return ("\\anthropicclaude\\" in p or re.search(r"\\windowsapps\\(claude|anthropic)[^\\]*\\", p) is not None
            or os.path.exists(os.path.join(os.path.dirname(path), "resources", "app.asar")))


def app_pids():
    """Windows: the desktop app's top processes (its helpers are their children)."""
    procs = win_procs()
    app = {pid for pid, (_, exe) in procs.items() if desktop_exe(exe)}
    return [pid for pid in app if procs[pid][0] not in app], procs


def app_running():
    if os.environ.get("CLAUDE_MOVE_SKIP_APP_CHECK") == "1":
        return False
    if WIN:
        try:
            return bool(app_pids()[0])
        except (OSError, AttributeError):
            return False
    try:
        out = subprocess.run(["ps", "-axo", "comm="], capture_output=True, text=True).stdout
    except OSError:
        return False
    return any(line.endswith("/Claude.app/Contents/MacOS/Claude") for line in out.splitlines())


