__version__ = "0.8.2"

WIN = sys.platform == "win32"
HOME = Path(os.environ.get("CLAUDE_MOVE_HOME", str(Path.home())))


def desktop_dir():
    """The desktop app's own data folder. On Windows it is %APPDATA%/Claude (the Store build too, as of 3.6556), but
    a Store build may get a redirected copy under %LOCALAPPDATA%/Packages; the one with the newest session list wins."""
    if not WIN:
        return HOME / "Library/Application Support/Claude"
    roaming = Path(os.environ.get("APPDATA") or HOME / "AppData/Roaming") / "Claude"
    local = Path(os.environ.get("LOCALAPPDATA") or HOME / "AppData/Local")
    found = []
    for d in [roaming] + sorted(local.glob("Packages/*/LocalCache/Roaming/Claude")):
        try:
            found.append((max([p.stat().st_mtime for p in (d / "claude-code-sessions").iterdir()] or [0]), d))
        except OSError:
            pass
    return max(found, key=lambda x: x[0])[1] if found else roaming


ROOT = Path(os.environ.get("CLAUDE_MOVE_ROOT") or desktop_dir() / "claude-code-sessions")
BACKUPS = Path(os.environ.get("CLAUDE_MOVE_BACKUPS", str(ROOT.parent / "claude-code-sessions-backups")))
NAMES = Path(os.environ.get("CLAUDE_MOVE_NAMES", str(HOME / ".config/claude-move/accounts.json")))
DESKTOP_HOME = Path(os.environ.get("CLAUDE_MOVE_DESKTOP_CONFIG", str(HOME / ".claude")))
MANIFEST = ".claude-move.json"


def _zh():
    lang = os.environ.get("CLAUDE_MOVE_LANG") or os.environ.get("LC_ALL") or os.environ.get("LANG") or ""
    if not lang and WIN:  # Windows locale names read "Chinese (Simplified)_China"; ask for the UI language instead
        try:
            import ctypes
            return ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3FF == 0x04
        except (AttributeError, OSError):
            pass
    if not lang:
        try:
            lang = locale.getlocale()[0] or ""
        except ValueError:
            lang = ""
    return lang.lower().startswith("zh")


