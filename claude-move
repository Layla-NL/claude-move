def t(key, **kw):
    s = T[key][1 if ZH else 0]
    return s.format(**kw) if kw else s


def names():
    try:
        return json.loads(NAMES.read_text())
    except (OSError, ValueError):
        return {}


def save_names(d):
    NAMES.parent.mkdir(parents=True, exist_ok=True)
    NAMES.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")


def load(p):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return None


def accounts():
    out = []
    if not ROOT.is_dir():
        return out
    for acct in sorted(ROOT.iterdir()):
        if not acct.is_dir():
            continue
        for org in sorted(acct.iterdir()):
            if not org.is_dir():
                continue
            sess = []
            for f in org.glob("local_*.json"):
                d = load(f)
                if isinstance(d, dict) and d.get("sessionId"):
                    sess.append((f, d))
            last = max((d.get("lastActivityAt") or 0 for _, d in sess), default=0)
            out.append({"acct": acct.name, "org": org.name, "dir": org, "sessions": sess, "last": last})
    return out


def label(a):
    return names().get(a["acct"], "")


def show(a):
    return label(a) or a["acct"][:8]


def pick(token, accts):
    token = token.strip()
    nm = names()
    hits = [a for a in accts if nm.get(a["acct"]) == token] or [a for a in accts if a["acct"].startswith(token)]
    if not hits:
        sys.exit(t("not_found", t=token))
    if len(hits) > 1:
        hits = sorted(hits, key=lambda a: len(a["sessions"]), reverse=True)
        print(t("many_orgs", t=token, n=len(hits), o=hits[0]["org"]))
    return hits[0]


def when(ms):
    return time.strftime("%m-%d %H:%M", time.localtime(ms / 1000)) if ms else t("never")


def active(a, days, include_all):
    cutoff = (time.time() - days * 86400) * 1000
    return [(f, d) for f, d in a["sessions"]
            if not d.get("isArchived") and (include_all or (d.get("lastActivityAt") or 0) >= cutoff)]


def app_running():
    if os.environ.get("CLAUDE_MOVE_SKIP_APP_CHECK") == "1":
        return False
    try:
        out = subprocess.run(["ps", "-axo", "comm="], capture_output=True, text=True).stdout
    except OSError:
        return False
    return any(line.endswith("/Claude.app/Contents/MacOS/Claude") for line in out.splitlines())


def cmd_list(_):
    accts = accounts()
    if not accts:
        sys.exit(t("no_root", p=ROOT))
    newest = max(accts, key=lambda a: a["last"])
    c = T["cols"][1 if ZH else 0]
    print(t("header", a=c[0], n=c[1], l=c[2], r=c[3], t=c[4]))
    empty = [a for a in accts if not a["sessions"]]
    for a in sorted((a for a in accts if a["sessions"]), key=lambda a: a["last"], reverse=True):
        live = sum(1 for _, d in a["sessions"] if not d.get("isArchived"))
        mark = t("newest") if a is newest else ""
        print(f"{a['acct'][:8]:10} {label(a) or '-':10} {live:>5} {len(a['sessions']) - live:>8}  {when(a['last'])}{mark}")
    if empty:
        print(t("empty", n=len(empty)))
    print("\n" + t("name_hint"))


def cmd_sessions(args):
    a = pick(args.account, accounts())
    rows = sorted(((d.get("lastActivityAt") or 0, d) for _, d in a["sessions"] if not d.get("isArchived")),
                  key=lambda x: x[0], reverse=True)
    for ts, d in rows:
        print(f"{when(ts)}  {d.get('title') or t('untitled')}  [{d['sessionId']}]")
    print(t("count", n=len(rows)))


def cmd_name(args):
    a = pick(args.account, accounts())
    nm = names()
    nm[a["acct"]] = args.label
    save_names(nm)
    print(t("named", a=a["acct"][:8], n=args.label))


def matches(d, only):
    if not only:
        return True
    title = (d.get("title") or "").lower()
    sid = d.get("sessionId") or ""
    return any(o.lower() in title or sid.startswith(o) or sid.startswith("local_" + o) for o in only)


def cmd_to(args):
    accts = accounts()
    if not accts:
        sys.exit(t("no_root", p=ROOT))
    dst = pick(args.target, accts)
    if args.source:
        src = pick(args.source, accts)
    else:
        others = [a for a in accts if a["dir"] != dst["dir"]]
        if not others:
            sys.exit(t("same"))
        src = max(others, key=lambda a: a["last"])
    if src["dir"] == dst["dir"]:
        sys.exit(t("same"))
    todo = [(f, d) for f, d in active(src, args.days, args.all or bool(args.only)) if matches(d, args.only)]
    print(t("plan", s=show(src), d=show(dst), n=len(todo),
            w="" if (args.all or args.only) else t("window", d=f"{args.days:g}")))
    plan = []
    for f, d in sorted(todo, key=lambda x: x[1].get("lastActivityAt") or 0, reverse=True):
        target = dst["dir"] / f.name
        old = load(target) if target.exists() else None
        title = d.get("title") or t("untitled")
        if isinstance(old, dict) and (old.get("lastActivityAt") or 0) > (d.get("lastActivityAt") or 0) and not old.get("isArchived"):
            print(t("skip", t=title))
            continue
        plan.append((f, target, d))
        print(t("over" if old else "add", t=title, w=when(d.get("lastActivityAt"))))
    arts = []
    for _, _, d in plan:
        for a in d.get("publishedArtifacts") or []:
            if isinstance(a, dict) and a.get("url"):
                arts.append((a.get("title") or a["url"], a["url"]))
    if arts:
        print(t("artifacts"))
        for title, url in dict.fromkeys(arts):
            print(t("art_line", t=title, u=url))
    if args.dry_run:
        print(t("dry"))
        return
    if not plan:
        print(t("nothing"))
        return
    if app_running():
        sys.exit(t("running"))
    BACKUPS.mkdir(parents=True, exist_ok=True)
    bk = BACKUPS / f"{time.strftime('%Y%m%d-%H%M%S')}-{dst['acct'][:8]}"
    shutil.copytree(dst["dir"], bk)
    manifest = {"version": 1, "target": str(dst["dir"]), "account": dst["acct"], "created": int(time.time()),
                "replaced": [tg.name for _, tg, _ in plan if tg.exists()],
                "added": [tg.name for _, tg, _ in plan if not tg.exists()]}
    (bk / MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n")
    print(t("backed", p=bk))
    for f, target, _ in plan:
        shutil.copy2(f, target)
    print(t("done", n=len(plan)))


def backups():
    if not BACKUPS.is_dir():
        return []
    out = []
    for b in sorted(BACKUPS.iterdir(), reverse=True):
        if b.is_dir():
            out.append((b, load(b / MANIFEST)))
    return out


def cmd_undo(args):
    items = backups()
    if args.list:
        if not items:
            print(t("no_backups"))
        for b, m in items:
            if isinstance(m, dict) and m.get("version") == 1:
                state = " (undone)" if m.get("undone") else ""
                print(t("bk_line", n=b.name, w=time.strftime("%m-%d %H:%M", time.localtime(m.get("created", 0))),
                        c=len(m.get("replaced", [])) + len(m.get("added", [])), a=m.get("account", "")[:8]) + state)
            else:
                print(t("bk_old", n=b.name))
        return
    if args.backup:
        chosen = [(b, m) for b, m in items if b.name == args.backup]
    else:
        chosen = [(b, m) for b, m in items if isinstance(m, dict) and m.get("version") == 1 and not m.get("undone")][:1]
    if not chosen or not isinstance(chosen[0][1], dict):
        sys.exit(t("no_backups"))
    bk, m = chosen[0]
    target = Path(m["target"])
    if not target.is_dir():
        sys.exit(t("undo_gone", p=target))
    replaced = [n for n in m.get("replaced", []) if (bk / n).exists()]
    added = [n for n in m.get("added", []) if (target / n).exists()]
    print(t("undo_plan", n=bk.name, r=len(replaced), d=len(added), a=m.get("account", "")[:8]))
    if args.dry_run:
        print(t("dry"))
        return
    if app_running():
        sys.exit(t("running"))
    snap = BACKUPS / f"{time.strftime('%Y%m%d-%H%M%S')}-{m.get('account', 'x')[:8]}-before-undo"
    shutil.copytree(target, snap)
    for n in replaced:
        shutil.copy2(bk / n, target / n)
    for n in added:
        (target / n).unlink()
    m["undone"] = int(time.time())
    (bk / MANIFEST).write_text(json.dumps(m, indent=2) + "\n")
    print(t("undo_done", p=snap))


def project_dir_name(path):
    return "".join(c if c.isalnum() or c == "-" else "-" for c in str(path))


def first_prompt(jsonl):
    try:
        with open(jsonl, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 400:
                    break
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") == "user" and not rec.get("isMeta"):
                    c = (rec.get("message") or {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                    if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
                        return " ".join(c.split())[:60]
    except OSError:
        pass
    return ""


def cmd_import_cli(args):
    src_cfg = Path(os.path.expanduser(args.config))
    dst_cfg = DESKTOP_HOME
    if not (src_cfg / "projects").is_dir():
        sys.exit(t("no_cfg", p=src_cfg))
    if src_cfg.resolve() == dst_cfg.resolve():
        sys.exit(t("same_cfg"))
    proj = args.project or os.getcwd()
    literal = "/" not in proj and (src_cfg / "projects" / proj).is_dir()
    name = proj if literal else project_dir_name(os.path.abspath(os.path.expanduser(proj)))
    sdir = src_cfg / "projects" / name
    if not sdir.is_dir():
        sys.exit(t("no_proj", p=name, c=src_cfg))
    ddir = dst_cfg / "projects" / name
    cutoff = time.time() - args.days * 86400
    files = sorted(sdir.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)
    if args.session:
        files = [f for f in files if any(f.stem.startswith(s) for s in args.session)]
    else:
        files = [f for f in files if f.stat().st_mtime >= cutoff]
    print(t("imp_head", c=src_cfg, d=dst_cfg, p=name))
    todo = []
    for f in files:
        title = first_prompt(f)
        w = time.strftime("%m-%d %H:%M", time.localtime(f.stat().st_mtime))
        if (ddir / f.name).exists():
            print(t("imp_skip", i=f.stem, t=title))
            continue
        todo.append(f)
        print(t("imp_add", i=f.stem, w=w, t=title))
    if args.dry_run:
        print(t("dry"))
        return
    if not todo:
        print(t("nothing"))
        return
    ddir.mkdir(parents=True, exist_ok=True)
    for f in todo:
        shutil.copy2(f, ddir / f.name)
        side = sdir / f.stem
        if side.is_dir() and not (ddir / f.stem).exists():
            shutil.copytree(side, ddir / f.stem)
    print(t("imp_done", n=len(todo)))


def main(argv=None):
    p = argparse.ArgumentParser(prog="claude-move",
                                description="Move the Claude desktop app's Code session list between accounts (copy only).")
    p.add_argument("--version", action="version", version=f"claude-move {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="accounts on this Mac and their session counts").set_defaults(fn=cmd_list)
    s = sub.add_parser("sessions", help="live sessions of one account")
    s.add_argument("account")
    s.set_defaults(fn=cmd_sessions)
    n = sub.add_parser("name", help="give an account a short label")
    n.add_argument("account")
    n.add_argument("label")
    n.set_defaults(fn=cmd_name)
    to = sub.add_parser("to", help="copy recent live sessions into the target account")
    to.add_argument("target")
    to.add_argument("--from", dest="source", help="source account (default: the most recently used one)")
    to.add_argument("--days", type=float, default=3, help="only sessions used in the last N days (default 3)")
    to.add_argument("--all", action="store_true", help="every live session, regardless of age")
    to.add_argument("--only", action="append", metavar="TEXT",
                    help="only sessions whose title contains TEXT or whose id starts with it (repeatable)")
    to.add_argument("--dry-run", action="store_true", help="show what would be copied, change nothing")
    to.set_defaults(fn=cmd_to)
    u = sub.add_parser("undo", help="put the target account's list back the way it was before the last move")
    u.add_argument("--list", action="store_true", help="list backups")
    u.add_argument("--backup", help="undo this backup instead of the latest one")
    u.add_argument("--dry-run", action="store_true")
    u.set_defaults(fn=cmd_undo)
    ic = sub.add_parser("import-cli", help="copy CLI session transcripts from another config folder into ~/.claude")
    ic.add_argument("--config", required=True, help="the other config folder, e.g. ~/.claude-work")
    ic.add_argument("--project", help="project path (default: current folder) or its folder name under projects/")
    ic.add_argument("--session", action="append", help="session id or id prefix (repeatable)")
    ic.add_argument("--days", type=float, default=3, help="without --session: sessions touched in the last N days")
    ic.add_argument("--dry-run", action="store_true")
    ic.set_defaults(fn=cmd_import_cli)
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
