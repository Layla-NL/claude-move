    tmp.replace(path)


def refresh_one(c, exe=None):
    """The official /usage of one CLI config folder, saved to limits.json. None when it reports no plan usage.
    Each folder's last answer is kept in logins.json for doctor."""
    exe = exe or os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    env = dict(os.environ)
    if c == HOME / ".claude":
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = str(c)
    r = subprocess.run([exe, "-p", "/usage", "--output-format", "stream-json", "--verbose", "--no-session-persistence"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace", env=env, timeout=90,
                       stdin=subprocess.DEVNULL)
    rows = parse_usage_report(r.stdout)
    logins = load(LOGINS) or {}
    logins[str(c)] = {"at": time.time(), "ok": bool(rows)}
    save_json(LOGINS, logins)
    if not rows:
        return None
    acct = cli_account(c)
    rows = official_rows({"rows": rows})
    cur = load(LIMITS) or {}
    cur[acct] = {"at": time.time(), "src": "usage", "rows": rows}
    save_json(LIMITS, cur)
    check_levels(acct, rows)
    return rows


def usage_report(extra_cfgs=(), now=None):
    now = now or time.time()
    accts = accounts()
    idx = owner_index(accts)
    roots = [DESKTOP_HOME] + [Path(os.path.expanduser(c)) for c in extra_cfgs]
    fallback = {str(DESKTOP_HOME): None}
    for c in roots[1:]:
        fallback[str(c)] = cli_account(c)
    recs, hits = scan(roots)
    timeline = signin_timeline()

    def who(ts, sid, ep, root):
        # desktop replies run as whoever is signed into the app; CLI replies as the config folder's account
        if ep == "d":
            return signed_in(timeline, ts) or owner(idx, sid, ts, None)
        if ep == "c":
            return fallback.get(root)
        return owner(idx, sid, ts, fallback.get(root))

    by = {}
    for r in recs:
        by.setdefault(who(r[0], r[1], r[4], r[5]), {"recs": [], "hits": []})["recs"].append(r)
    for h in hits:
        by.setdefault(who(h[0], h[1], h[4], h[5]), {"recs": [], "hits": []})["hits"].append(h)
    official = load(LIMITS) or {}
    plan_of = plans(extra_cfgs)
    cli_of = {}
    for c in cli_configs(extra_cfgs):
        cli_of.setdefault(cli_account(c), c)
    ids = {a["acct"] for a in accts if a["sessions"]} | {k for k in by if k} | set(official)
    rows = []
    for acct in ids:
        b = by.get(acct, {"recs": [], "hits": []})
        h7 = [h for h in b["hits"] if h[2] == "seven_day"]
        w0, w1 = week_window(h7, now)
        spent_week = sum(r[3] for r in b["recs"] if r[0] >= (w0 if w0 else now - WEEK))
        spent_5h = sum(r[3] for r in b["recs"] if r[0] >= now - FIVE_H)
        off = official.get(acct)
        off = off if isinstance(off, dict) and now - off.get("at", 0) < 3 * 86400 else None
        rows_off = official_rows(off)
        cool = [h for h in b["hits"] if h[3] > now]
        cool = max(cool, key=lambda h: h[3]) if cool else None
        full = [r for r in rows_off if (r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now]
        if full and not cool:
            r0 = max(full, key=lambda r: r["resets_at"])
            cool = [0, "", "five_hour" if r0["kind"] == "session" else "seven_day", r0["resets_at"]]
        wk = next((r for r in rows_off if r.get("kind") == "weekly_all" and r.get("resets_at")), None)
        if wk:
            w1 = wk["resets_at"]
        daily = [round(sum(r[3] for r in b["recs"] if now - (i + 1) * 86400 <= r[0] < now - i * 86400), 2)
                 for i in range(6, -1, -1)]
        rows.append({
            "acct": acct, "name": names().get(acct, "") or acct[:8], "plan": plan_of.get(acct, ""),
            "cli": cli_command(cli_of[acct]) if acct in cli_of else "",
            "cli_rc": rc_command(cli_of[acct]) if acct in cli_of else "",
            "cfg": str(cli_of[acct]) if acct in cli_of else "",
            "cool": {"kind": cool[2], "until": cool[3]} if cool else None,
            "week_usd": spent_week, "five_usd": spent_5h, "week_reset": w1, "daily": daily,
            "official": {"at": off["at"], "rows": rows_off} if off and rows_off else None,
            "last": max((r[0] for r in b["recs"]), default=0)})
    unmapped = by.get(None)
    rows.sort(key=lambda r: r["last"], reverse=True)
    free = [r for r in rows if not r["cool"]]
    pick = min(free, key=rank_key) if free else None
    first_back = min(rows, key=lambda r: r["cool"]["until"]) if rows and not free else None
    return {"now": now, "rows": rows, "pick": pick, "first_back": first_back,
            "unmapped_usd": sum(r[3] for r in unmapped["recs"] if r[0] >= now - WEEK) if unmapped else 0}


def rank_key(r):
    """Most quota left this week: (100 - weekly %) x plan size (Pro = 1, Max 5x / 20x scale the same plan);
    accounts without an official % come after, least used first."""
    pct = next((x["percent"] for x in (r["official"] or {}).get("rows", []) if x.get("kind") == "weekly_all"), None)
    m = re.search(r"(\d+)x", r["plan"])
    return (pct is None, -(100 - (pct or 0)) * (int(m.group(1)) if m else 1), r["week_usd"])


def row_text(r, now):
    parts = []
    off = r["official"]
    if off:
        parts.append(t("u_official", rows=rows_text(off["rows"]), a=ago(now - off["at"])))
    parts.append(t("u_spent", k=t("u_week") if r["week_reset"] else t("u_7d"), d=r["week_usd"]))
    parts.append(t("u_spent", k=t("u_5h"), d=r["five_usd"]))
    if r["week_reset"]:
        parts.append(t("u_reset", w=clock(r["week_reset"])))
    if r["cool"]:
        k = t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h")
        return t("u_cool", k=k, w=clock(r["cool"]["until"])) + " · " + " · ".join(parts)
    return t("u_ok") + "  " + " · ".join(parts)


def cmd_usage(args):
    if args.refresh:
        refresh_official(args.config or ())
        print()
    print(t("u_scan"), file=sys.stderr)
    rep = usage_report(args.config or ())
    print(t("u_title"))
    for r in rep["rows"]:
        print(f"{r['name']:10} {r['plan'] or '-':8} {row_text(r, rep['now'])}")
    if rep["unmapped_usd"] >= 1:
        print(f"{'-':10} {t('u_unmapped')}: " + t("u_spent", k=t("u_7d"), d=rep["unmapped_usd"]))
    if rep["pick"]:
        print(t("u_pick", a=rep["pick"]["name"]))
    elif rep["first_back"]:
        print(t("u_pick_none", a=rep["first_back"]["name"], w=clock(rep["first_back"]["cool"]["until"])))
    print(t("u_notes"))
    if args.html:
        out = CONF / "usage.html"
        CONF.mkdir(parents=True, exist_ok=True)
        out.write_text(render_html(rep), encoding="utf-8")
        print(t("u_html", p=out))
        if not args.no_open:
            open_path(out)


