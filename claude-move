    """True when this process descends from the Claude desktop app (its terminal pane, a Code session)."""
    if os.environ.get("CLAUDE_MOVE_INSIDE_APP") == "1":
        return True
    if os.environ.get("CLAUDE_MOVE_SKIP_APP_CHECK") == "1":
        return False
    if WIN:
        try:
            procs = win_procs()
