        big = '<div class="big q">—</div>'
        what = t("pp_none")
    if cool:
        chip = (f'<span class="chip hot" data-until="{int(cool["until"])}" data-tip="{tip(t("u_back", k=kind, w=clock(cool["until"])))}">'
                f'{icon("clock")}<span></span></span>')
    elif rows:
        chip = f'<span class="chip ok" data-tip="{tip(t("u_ok").strip() + chr(10) + t("u_off_head", a=ago(now - off["at"])))}">{icon("check")}</span>'
    else:
        chip = f'<span class="chip unk" data-tip="{tip(t("pp_nooff"))}">{icon("q")}</span>'
    pills = "".join(
        f'<button type="button" data-p="{round(x.get("percent") or 0)}" data-k="{E(row_label(x))}" '
        f'data-reset="{E(short_clock(x["resets_at"], now)) if x.get("resets_at") else ""}" '
        f'aria-pressed="{"true" if i == sel else "false"}" data-tip="{tip(t("u_pct", k=row_label(x), p=round(x.get("percent") or 0)) + (chr(10) + t("pp_resets", w=clock(x["resets_at"])) if x.get("resets_at") else ""))}">'
        f'{E(row_label(x))} {round(x.get("percent") or 0)}%</button>' for i, x in enumerate(rows))
    days = [time.strftime("%m-%d", time.localtime(now - i * 86400)) for i in range(6, -1, -1)]
    peak = max(r["daily"] + [0.01])
    week_label = t("u_week") if r["week_reset"] else t("u_7d")
    spend = (f'<div class="spend" data-tip="{tip(t("u_spent", k=week_label, d=r["week_usd"]) + chr(10) + t("u_spent", k=t("u_5h"), d=r["five_usd"]))}">'
             f'<div class="bars">' + "".join(f'<i style="height:{max(8, 100 * v / peak):.0f}%"></i>' for v in r["daily"]) +
             f'</div>${r["week_usd"]:,.0f}</div>')
    acts = ""
    if live:
        a = E(r["acct"])
        if r["cli"]:
            on = bool(r["cfg"]) and recorder_on(Path(r["cfg"]))
            acts += (f'<button class="ib" type="button" data-term="{a}" data-tip="{tip(t("p_term"))}">{icon("term")}</button>'
                     f'<button class="ib" type="button" data-term="{a}" data-rc="1" data-tip="{tip(t("p_term_rc"))}">{icon("phone")}</button>'
                     f'<button class="ib" type="button" data-copy="{E(r["cli"])}" data-tip="{tip(t("p_copy"))}">{icon("copy")}</button>'
                     f'<button class="ib" type="button" data-copy="{E(r["cli_rc"])}" data-tip="{tip(t("p_copy_rc"))}">{icon("copyrc")}</button>'
                     f'<button class="ib" type="button" data-rec="{a}" data-on="{1 if on else 0}" aria-pressed="{"true" if on else "false"}" '
                     f'data-tip="{tip(t("pt_rec_off" if on else "pt_rec_on"))}">{icon("rec")}</button>')
        else:
            acts += f'<button class="ib" type="button" data-login="{a}" data-tip="{tip(t("pt_login"))}">{icon("adduser")}</button>'
        acts += f'<button class="ib" type="button" data-rename="{a}" data-tip="{tip(t("pt_rename"))}">{icon("pen")}</button>'
    plan = E(r["plan"]) if r["plan"] else "&nbsp;"
    crew = f'<span class="crewmark" data-tip="{tip(t("pp_crew"))}">{icon("anchor")}</span>' if live and r["acct"] == crew_acct() else ""
    return (f'<article class="card" {attrs} data-heat="{heat}"><div class="sky"><canvas class="orb" aria-hidden="true"></canvas>'
            f'<div class="head"><div><div class="name">{E(r["name"])}<span class="deskmark" hidden data-tip="{tip(t("pp_desk"))}">{icon("desk")}</span>{crew}</div>'
            f'<div class="plan">{plan}</div></div>{chip}</div></div>'
            f'<div class="glass"><div class="hero"><div>{big}<div class="what">{E(what)}</div><div class="when"><span class="rs">{E(when_)}</span></div></div>{spend}</div>'
            + (f'<div class="pills" role="group">{pills}</div>' if pills else "")
            + (f'<div class="acts">{acts}</div>' if acts else "") + '</div></article>')


def render_html(rep, live=None):
    from html import escape as E
    now = rep["now"]
    cards = [card_html(r, rep, live) for r in rep["rows"]]
    if rep["unmapped_usd"] >= 1:
        cards.append(f'<article class="card" data-acct="" data-name="{E(t("u_cli_head"))}" data-heat=""><div class="sky">'
                     f'<canvas class="orb" aria-hidden="true"></canvas><div class="head"><div><div class="name">{E(t("u_cli_head"))}</div>'
                     f'<div class="plan">&nbsp;</div></div></div></div><div class="glass"><div class="hero"><div>'
                     f'<div class="big">${rep["unmapped_usd"]:,.0f}</div><div class="what">{E(t("u_7d"))}</div></div></div>'
                     f'<div class="acts"><span class="src" data-tip="{tip(t("u_unmapped"))}">{icon("info")}</span></div></div></article>')
    advice = ""
    if rep["pick"]:
        p = rep["pick"]
        pct = max([x.get("percent") or 0 for x in (p["official"] or {}).get("rows", [])], default=None)
