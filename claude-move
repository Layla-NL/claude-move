def use_lang(lang):
    global ZH
    if lang in ("zh", "en"):
        ZH = lang == "zh"


def short_clock(ts, now):
    """22:10 today, Thu 22:10 within the week, 10-30 22:10 after that."""
    lt = time.localtime(ts)
    if ts - now < 20 * 3600:
        return time.strftime("%H:%M", lt)
    if ts - now < 6 * 86400:
        return t("pp_wdfmt", d=t("pp_wd").split(",")[lt.tm_wday]) + time.strftime(" %H:%M", lt)
    return time.strftime("%m-%d %H:%M", lt)


