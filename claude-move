    p = argparse.ArgumentParser(prog="claude-move",
                                description="Move the Claude desktop app's Code session list between accounts (copy only).")
    p.add_argument("--version", action="version", version=f"claude-move {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list", help="accounts on this computer and their session counts")
    ls.add_argument("--json", action="store_true", help="as JSON, with the account the desktop app is signed into")
    ls.set_defaults(fn=cmd_list)
    s = sub.add_parser("sessions", help="live sessions of one account")
    s.add_argument("account")
    s.set_defaults(fn=cmd_sessions)
    n = sub.add_parser("name", help="give an account a short label")
    n.add_argument("account")
    n.add_argument("label")
    n.set_defaults(fn=cmd_name)
    to = sub.add_parser("to", help="copy recent live sessions into the target account")
    to.add_argument("target")
    to.add_argument("--from", dest="source", help="source account (default: the most recently used one)")
    to.add_argument("--days", type=float, default=3, help="only sessions used in the last N days (default 3)")
    to.add_argument("--all", action="store_true", help="every live session, regardless of age")
    to.add_argument("--only", action="append", metavar="TEXT",
                    help="only sessions whose title contains TEXT or whose id starts with it (repeatable)")
    to.add_argument("--dry-run", action="store_true", help="show what would be copied, change nothing")
    to.add_argument("--app", action="store_true", help="quit the desktop app first and open it again afterwards; "
                    "inside the app, a copy of claude-move on its own does it and sends a notification")
    to.add_argument("--detached", action="store_true", help=argparse.SUPPRESS)
    to.set_defaults(fn=cmd_to)
    u = sub.add_parser("undo", help="put the target account's list back the way it was before the last move")
    u.add_argument("--list", action="store_true", help="list backups")
    u.add_argument("--backup", help="undo this backup instead of the latest one")
    u.add_argument("--dry-run", action="store_true")
    u.add_argument("--app", action="store_true", help="quit the desktop app first and open it again afterwards")
    u.add_argument("--detached", action="store_true", help=argparse.SUPPRESS)
    u.set_defaults(fn=cmd_undo)
    ic = sub.add_parser("import-cli", help="copy CLI session transcripts from another config folder into ~/.claude")
    ic.add_argument("--config", required=True, help="the other config folder, e.g. ~/.claude-work")
    ic.add_argument("--project", help="project path (default: current folder) or its folder name under projects/")
    ic.add_argument("--session", action="append", help="session id or id prefix (repeatable)")
    ic.add_argument("--days", type=float, default=3, help="without --session: sessions touched in the last N days")
    ic.add_argument("--dry-run", action="store_true")
    ic.set_defaults(fn=cmd_import_cli)
    us = sub.add_parser("usage", help="quota per account: cooling/reset times, estimated use, official %% from the CLI")
    us.add_argument("--html", action="store_true", help="also write a panel page and open it")
    us.add_argument("--no-open", action="store_true", help="with --html: write the page but do not open it")
    us.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    us.add_argument("--json", action="store_true", help="print the numbers per account as JSON (for the Claude Code mod)")
    us.add_argument("--refresh", action="store_true",
                    help="first ask the official /usage of every signed-in CLI config folder (~/.claude, ~/.claude-*)")
    us.set_defaults(fn=cmd_usage)
    pn = sub.add_parser("panel", help="open the quota panel with a button that moves sessions after you switch accounts")
    pn.add_argument("--port", type=int, default=0, help="port on 127.0.0.1 (default: any free port)")
    pn.add_argument("--no-open", action="store_true")
    pn.add_argument("--here", action="store_true", help="run in this process even inside the desktop app's terminal")
    pn.add_argument("--idle", type=float, default=0, help="stop after this many seconds without the page open (default: never)")
    pn.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    pn.add_argument("--demo", action="store_true", help="sample accounts for screenshots; reads nothing here, buttons do nothing")
    pn.set_defaults(fn=cmd_panel)
    ap = sub.add_parser("app", help="install a double-clickable launcher that opens the panel: Claude Move.app on "
                                    "macOS, a Start menu shortcut on Windows")
    ap.add_argument("action", choices=["install", "uninstall"])
    ap.add_argument("--dir", help="where to put it (default ~/Applications; on Windows the Start menu)")
    ap.add_argument("--no-dock", action="store_true", help="do not add it to the Dock (Windows: no desktop shortcut)")
    ap.add_argument("--icon", help="use this image as the icon (PNG/JPEG, ideally 1024x1024; on Windows PNG or ICO)")
    ap.set_defaults(fn=cmd_app)
    tm = sub.add_parser("term", help="open a Terminal window running Claude Code with that account's CLI login")
    tm.add_argument("account", help="label or id prefix of an account signed in under ~/.claude or ~/.claude-*")
    tm.add_argument("--auto", action="store_true", help="through claude-move run: switch account at a usage limit")
    tm.add_argument("--rc", action="store_true",
                    help="start it as a Remote Control session named after the account, so the phone app can join")
    tm.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    tm.set_defaults(fn=cmd_term)
    rn = sub.add_parser("run", help="run Claude Code as an account; at a usage limit, move the session to the account "
                                    "with the most left and resume it there")
    rn.add_argument("account", help="label or id prefix of an account with a CLI login")
    rn.add_argument("--rc", action="store_true", help="as a Remote Control session named after the account")
    rn.add_argument("--resume", metavar="ID", help="resume this session id instead of starting a new one")
    rn.add_argument("--config", action="append", help="also use this CLI config folder (repeatable)")
    rn.add_argument("claude_args", nargs="*", help="more arguments for claude, after --")
    rn.set_defaults(fn=cmd_run)
    nt = sub.add_parser("notify", help="system notifications when an account's official %% passes 75/90/95%%")
    nt.add_argument("action", choices=["on", "off", "status", "test"])
    nt.add_argument("--levels", help="comma-separated levels, e.g. 80,95")
    nt.set_defaults(fn=cmd_notify)
    dr = sub.add_parser("doctor", help="check accounts, CLI logins, duplicates, the status line recorder and the app")
    dr.add_argument("--refresh", action="store_true", help="first ask each CLI login its official /usage")
    dr.add_argument("--config", action="append", help="also check this CLI config folder (repeatable)")
    dr.set_defaults(fn=cmd_doctor)
    br = sub.add_parser("bar", help="macOS menu bar ball through SwiftBar or xbar: `bar` prints it, `bar install` adds the plugin")
    br.add_argument("action", nargs="?", default="show", choices=["show", "install", "uninstall"])
    br.add_argument("--dir", help="plugin folder (default: SwiftBar's, else xbar's)")
    br.set_defaults(fn=cmd_bar)
    w = sub.add_parser("watch", help="record official CLI rate limits from the Claude Code status line")
    w.add_argument("action", choices=["install", "uninstall", "record"])
    w.set_defaults(fn=cmd_watch)
    qs = sub.add_parser("quota-snapshot", help="write one account's official %% in quota-axi's format, for firstmate "
                                               "(QUOTA_AXI_SNAPSHOT); `schedule` refreshes it every few minutes")
    qs.add_argument("action", nargs="?", default="write", choices=["write", "status", "schedule", "unschedule"])
    qs.add_argument("--account", help="label or id prefix (default: the account firstmate's crews are pinned to)")
    qs.add_argument("--out", help="snapshot file (default ~/.cache/claude-move/quota-axi-snapshot.json)")
    qs.add_argument("--refresh", action="store_true", help="first ask that login's official /usage (no quota used)")
    qs.add_argument("--every", type=float, default=10, help="with schedule: minutes between refreshes (default 10)")
    qs.add_argument("--stale-after", type=float, default=STALE_AFTER,
                    help="with --refresh: when /usage keeps failing and the numbers are this many minutes old, move the "
                         "snapshot aside so firstmate sees no quota instead of old quota (default %(default)g)")
    qs.add_argument("--config", action="append", help="also use this CLI config folder (repeatable)")
    qs.set_defaults(fn=cmd_quota_snapshot)
    fp = sub.add_parser("fm-pin", help="show, or set, which account firstmate's Claude crews use (its config/claude-account); "
                                       "the snapshot follows")
    fp.add_argument("account", nargs="?", help="label or id prefix of an account with a CLI login; none: show the accounts")
    fp.add_argument("--home", help="firstmate's folder (default ~/Developer/firstmate)")
    fp.add_argument("--force", action="store_true", help="pin it even while it is cooling")
    fp.add_argument("--config", action="append", help="also use this CLI config folder (repeatable)")
    fp.set_defaults(fn=cmd_fm_pin)
    fd = sub.add_parser("find", help="search what was said in every CLI login's terminal sessions; each hit shows how to resume it")
    fd.add_argument("words", nargs="+", help="words that must all be in the session (any case)")
    fd.add_argument("--account", help="only this account's CLI login")
    fd.add_argument("--limit", type=int, default=20, help="at most this many sessions (default 20)")
    fd.add_argument("--json", action="store_true", help="print the hits as JSON")
    fd.add_argument("--config", action="append", help="also search this CLI config folder (repeatable)")
    fd.set_defaults(fn=cmd_find)
    rs = sub.add_parser("resume", help="resume a terminal session in a new tmux window (or terminal window), in its folder, "
                                       "with its login")
    rs.add_argument("session", help="the session id, or its first characters (from find)")
    rs.add_argument("--to", help="copy it to this account's CLI login first and resume it there (copy only)")
    rs.add_argument("--here", action="store_true", help="resume it in this terminal instead")
    rs.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    rs.set_defaults(fn=cmd_resume)
    ps = sub.add_parser("ps", help="Claude Code sessions running now, every CLI login: busy or idle, and their tmux window")
    ps.add_argument("--go", metavar="TARGET", help="show that session's tmux window (a tmux target, session id prefix or pid)")
    ps.add_argument("--label", nargs=2, metavar=("TARGET", "NAME"),
                    help="call that session NAME in claude-move (\"\" takes the name off); a window claude-move "
                         "names follows it, other tools' window names stay")
    pg = ps.add_mutually_exclusive_group()
    pg.add_argument("--pin", nargs="+", metavar="TARGET", help="keep these sessions at the top of ps, the tmux menu and the panel")
    pg.add_argument("--unpin", nargs="+", metavar="TARGET", help="take these sessions off the top")
    ps.add_argument("--json", action="store_true", help="print them as JSON")
    ps.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    ps.set_defaults(fn=cmd_ps)
    tx = sub.add_parser("tmux", help="tmux and Claude: `name` names windows after their session, `line` is the status bar text, "
                                     "`menu` a session menu, `conf` the ~/.tmux.conf block that wires them up")
    tx.add_argument("action", nargs="?", default="name", choices=("name", "line", "menu", "conf"))
    g = tx.add_mutually_exclusive_group()
    g.add_argument("--install", action="store_true", help="conf: add the block to ~/.tmux.conf (backed up first) and load it")
    g.add_argument("--remove", action="store_true", help="conf: take the block out and put tmux's defaults back")
    tx.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    tx.set_defaults(fn=cmd_tmux)
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
