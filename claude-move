# ---------- run: switch account at a usage limit and go on
def transcript_files(cfg, sid):
    proj = cfg / "projects"
    return list(proj.glob(f"*/{sid}.jsonl")) + list(proj.glob(f"*/{sid}/subagents/*.jsonl"))


def new_limit_hit(cfg, sid, marks):
    """A usage-limit record written to this session's transcripts (subagents included) since the last look."""
    for f in transcript_files(cfg, sid):
        try:
            with open(f, "rb") as fh:
                fh.seek(marks.get(f, 0))
                data = fh.read()
        except OSError:
            continue
        end = data.rfind(b"\n") + 1
        marks[f] = marks.get(f, 0) + end
        for raw in data[:end].splitlines():
            if b"usage_limit_reached" not in raw:
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            info = (rec.get("apiErrorParams") or {}).get("rate_limit_info")
            if rec.get("apiError") == "usage_limit_reached" and isinstance(info, dict):
                return {"kind": info.get("rateLimitType") or "", "until": info.get("resetsAt") or 0}
    return None


def next_account(skip, extra=()):
    """The CLI login with the most quota left that is not cooling. Each candidate is asked its official /usage
    first, which also proves the folder is really signed in."""
    by = {}
    for c in cli_configs(extra):
        by.setdefault(cli_account(c), c)
    rep = usage_report([str(c) for c in by.values() if c != HOME / ".claude"])
    ranked = [r["acct"] for r in sorted(rep["rows"], key=rank_key) if not r["cool"]]
    ranked += [a for a in by if a not in ranked]
    now = time.time()
    for acct in ranked:
        if acct not in by or acct in skip:
            continue
        try:
            rows = refresh_one(by[acct])
        except (OSError, subprocess.SubprocessError):
            continue
        if rows is None or any((r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now for r in rows):
            continue
        return by[acct]
    return None


def copy_session(src_cfg, dst_cfg, sid):
    """Copy the session's transcript and side folder into the other config folder; whatever was there for this
    session is saved first. Returns the backup folder, if one was needed."""
    src = next(iter(src_cfg.glob(f"projects/*/{sid}.jsonl")), None)
    if not src:
        return False
    ddir = dst_cfg / "projects" / src.parent.name
    ddir.mkdir(parents=True, exist_ok=True)
    bk = None
    for name in (src.name, sid):
        d = ddir / name
        if d.exists():
            bk = bk or CONF / "run-backups" / f'{time.strftime("%Y%m%d-%H%M%S")}-{dst_cfg.name.lstrip(".")}'
            bk.mkdir(parents=True, exist_ok=True)
            (shutil.copytree if d.is_dir() else shutil.copy2)(d, bk / name)
    shutil.copy2(src, ddir / src.name)
    side = src.parent / sid
    if side.is_dir():
        shutil.copytree(side, ddir / sid, dirs_exist_ok=True)
    return bk


def restore_tty():
    if sys.stdin.isatty():
        if not WIN:
            subprocess.run(["stty", "sane"], check=False)
        sys.stderr.write("\033[?25h\n")


def stop_child(child):
    """End claude so its transcript can be copied. On Windows the whole tree: an npm install runs it under a .cmd."""
    if WIN:
        subprocess.run(["taskkill", "/T", "/F", "/PID", str(child.pid)], capture_output=True)
    else:
        child.terminate()
    try:
        child.wait(timeout=10)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()


def cmd_run(args):
    """Run Claude Code with one account's CLI login. When the session hits a usage limit, stop it, copy it into the
    CLI login with the most left and resume it there with a note to continue. Logins are never read or changed."""
    import signal
    import uuid
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude")
    if not exe:
        sys.exit(t("r_noclaude"))
    cfg = cli_dir(args.account.strip(), args.config or ())
    if not cfg:
        sys.exit(t("t_none", t=args.account))
    sid, resume, prompt = args.resume or str(uuid.uuid4()), bool(args.resume), None
    poll = float(os.environ.get("CLAUDE_MOVE_POLL") or 2)
    skip = {}  # accounts that hit a limit in this run -> when they are back
    runf = RUNS / f"{sid}.json"
    run = {"sid": sid, "pid": os.getpid(), "cwd": os.getcwd(), "started": time.time(), "acct": cli_account(cfg),
           "cfg": str(cfg), "switches": [], "ended": None}
    save_json(runf, run)

    def finish(code):
        run["ended"] = time.time()
        save_json(runf, run)
        sys.exit(code)

    signal.signal(signal.SIGINT, lambda *a: None)  # Ctrl-C is for claude; caught signals reset to default in the child
    while True:
        acct = cli_account(cfg)
        cmd = [exe] + (["--resume", sid] if resume else ["--session-id", sid])
        cmd += (["--remote-control", rc_name(acct)] if args.rc else []) + list(args.claude_args or [])
        cmd += [prompt] if prompt else []
        env = dict(os.environ)
        if cfg == HOME / ".claude":
            env.pop("CLAUDE_CONFIG_DIR", None)
        else:
            env["CLAUDE_CONFIG_DIR"] = str(cfg)
        print(t("run_on", a=names().get(acct, acct[:8]), c=cli_command(cfg)), file=sys.stderr)
        marks = {}
        for f in transcript_files(cfg, sid):  # only what is written from now on counts
            try:
                marks[f] = f.stat().st_size
            except OSError:
                pass
        child = subprocess.Popen(cmd, env=env)
        hit = None
        while child.poll() is None and not hit:
            time.sleep(poll)
            hit = new_limit_hit(cfg, sid, marks)
        if not hit:
            restore_tty()
            finish(child.returncode if child.returncode >= 0 else 1)
        now = time.time()
        skip[acct] = hit["until"] or now + FIVE_H
        skip = {a: u for a, u in skip.items() if u > now}
        nxt = next_account(skip, args.config or ())
        who = names().get(acct, acct[:8])
        if not nxt:  # leave claude as it is; the user can wait for the reset in it
            notify(t("n_title"), t("n_none", a=who))
            child.wait()
            restore_tty()
            print(t("run_none", a=who), file=sys.stderr)
            finish(child.returncode if child.returncode >= 0 else 1)
        stop_child(child)
        restore_tty()
        k = t("u_kind_week") if hit["kind"] == "seven_day" else t("u_kind_5h")
        print(t("run_hit", a=who, k=k, w=clock(skip[acct])), file=sys.stderr)
        nb = names().get(cli_account(nxt), cli_account(nxt)[:8])
        print(t("run_switch", b=nb), file=sys.stderr)
        bk = copy_session(cfg, nxt, sid)
        if bk is False:
            finish(t("run_lost", d=short(cfg)))
        if bk:
            print(t("run_backup", b=nb, p=bk), file=sys.stderr)
        notify(t("n_title"), t("n_switch", a=who, b=nb))
        run["switches"].append({"at": time.time(), "from": acct, "to": cli_account(nxt), "kind": hit["kind"]})
        run.update(acct=cli_account(nxt), cfg=str(nxt))
        save_json(runf, run)
        cfg, resume, prompt = nxt, True, t("run_prompt")


