def recent_cwd(cfg):
    """The project folder the account behind `cfg` used last: its newest desktop session or the newest transcript in
    the CLI folder, whichever is newer. A worktree counts as its repo. None when that folder is gone."""
    acct = cli_account(cfg)
    best = (0, None)
    for a in accounts():
        if a["acct"] == acct:
            for _, d in a["sessions"]:
                ts = (d.get("lastActivityAt") or 0) / 1000
                if ts > best[0] and (d.get("originCwd") or d.get("cwd")):
                    best = (ts, d.get("originCwd") or d.get("cwd"))
    jsonl = []
    for f in (cfg / "projects").glob("*/*.jsonl"):
        try:
            jsonl.append((f.stat().st_mtime, f))
        except OSError:
            pass
    if jsonl:
        ts, f = max(jsonl)
        if ts > best[0]:
            try:
                with f.open(encoding="utf-8", errors="replace") as fh:
                    for _, line in zip(range(50), fh):
                        try:
                            cwd = json.loads(line).get("cwd")
                        except (ValueError, AttributeError):
                            continue
                        if cwd:
                            best = (ts, cwd)
                            break
            except OSError:
                pass
    cwd = best[1]
    if cwd and os.sep + ".claude" + os.sep + "worktrees" + os.sep in cwd:
        cwd = cwd.split(os.sep + ".claude" + os.sep + "worktrees" + os.sep)[0]
    return Path(cwd) if cwd and Path(cwd).is_dir() else None


def open_terminal(cfg, rc=False, auto=False):
    """A new terminal window running `claude` with this config folder, so the CLI uses that folder's own login, in the
    account's last project folder; with rc, as a Remote Control session named after the account so the phone app
    can join it; with auto, through `claude-move run`, which changes account at a usage limit.
    It writes a small script and opens it (.command on macOS: no Automation permission; .cmd on Windows)."""
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    cwd = recent_cwd(cfg)
    if auto:
        env = {"CLAUDE_MOVE_LANG": "zh" if ZH else "en"}
        argv = [console_python(), Path(__file__).resolve(), "run", "--config", cfg, cli_account(cfg)] + (["--rc"] if rc else [])
    else:
        env = {"CLAUDE_CONFIG_DIR": None if cfg == HOME / ".claude" else cfg}
        argv = [exe] + (["--remote-control", rc_name(cli_account(cfg))] if rc else [])
    open_command(term_script(cfg.name.lstrip(".") + ("-rc" if rc else "") + ("-auto" if auto else ""), cwd, env, argv))
    return cwd


def console_python():
    """This Python, but the console one when the panel runs under Windows' windowless pythonw."""
    exe = Path(sys.executable)
    con = exe.with_name("python.exe")
    return con if WIN and exe.name.lower() == "pythonw.exe" and con.exists() else exe


def term_script(name, cwd, env, argv, before=(), after=()):
    """A script for a new terminal window: go to cwd (else home), set env (None unsets), print `before`, run argv,
    then print `after`. Returns its path under CONF/term and its text: sh on macOS, cmd on Windows."""
    if WIN:
        bare = lambda x: str(x).replace('"', "").replace("%", "%%")
        q = lambda x: f'"{bare(x)}"' if not str(x) or re.search(r"[\s&|<>^(),;=!%]", str(x)) else bare(x)
        say = lambda x: "echo(" + re.sub(r"([&|<>^()])", r"^\1", str(x)).replace("%", "%%")
        lines = ["@echo off", "chcp 65001 >nul", (f"cd /d {q(cwd)} 2>nul || " if cwd else "") + 'cd /d "%USERPROFILE%"']
        lines += [f'set "{k}={"" if v is None else bare(v)}"' for k, v in env.items()]
        run = " ".join(q(a) for a in argv)
        if str(argv[0]).lower().endswith((".cmd", ".bat")):  # an npm install's claude.cmd: come back after it
            run = "call " + run
        lines += [say(x) for x in before] + [run] + [say(x) for x in after]
        return CONF / "term" / (name + ".cmd"), "\r\n".join(lines) + "\r\n"
    from shlex import quote
    lines = ["#!/bin/sh", (f"cd {quote(str(cwd))} 2>/dev/null || " if cwd else "") + "cd ~ || exit 1"]
    lines += [f"unset {k}" if v is None else f"export {k}={quote(str(v))}" for k, v in env.items()]
    lines += [f"echo {quote(x)}" for x in before]
    lines += [("" if after else "exec ") + " ".join(quote(str(a)) for a in argv)]
    lines += [f"echo {quote(x)}" for x in after]
    return CONF / "term" / (name + ".command"), "\n".join(lines) + "\n"


def open_command(script_body):
    """Open a term_script in a new terminal window. On Windows the window stays open after it ends, as Terminal's does."""
    from shlex import quote
    script, body = script_body
    script.parent.mkdir(parents=True, exist_ok=True)
    script.write_bytes(body.encode("utf-8"))
    script.chmod(0o700)
    cmd = os.environ.get("CLAUDE_MOVE_TERM_CMD")
    if cmd:
        subprocess.run(f'{cmd} "{script}"' if WIN else f"{cmd} {quote(str(script))}", shell=True)
    elif WIN:
        subprocess.Popen(["cmd.exe", "/k", str(script)], creationflags=subprocess.CREATE_NEW_CONSOLE)
    else:
        subprocess.run(["open", str(script)], check=False)


