def find_transcript(token, extra=()):
    """The newest transcript whose session id starts with token, across every CLI login: (cfg, file) or an error."""
    if not re.fullmatch(r"[0-9a-f-]{4,64}", token):
        return None, t("rs_none", i=token)
    hits = []
    for cfg in cli_configs(extra):
        for f in cfg.glob(f"projects/*/{token}*.jsonl"):
            try:
                hits.append((f.stat().st_mtime, cfg, f))
            except OSError:
                pass
    sids = sorted({f.stem for _, _, f in hits})
    if not sids:
        return None, t("rs_none", i=token)
    if len(sids) > 1:
        return None, t("rs_many", i=token, l=", ".join(s[:12] for s in sids[:6]))
    _, cfg, f = max(hits, key=lambda h: h[0])
    return (cfg, f), None


def transcript_cwd(f):
    try:
        with open(f, encoding="utf-8", errors="replace") as fh:
            for _, line in zip(range(200), fh):
                try:
                    cwd = json.loads(line).get("cwd")
                except (ValueError, AttributeError):
                    continue
                if cwd:
                    return cwd
    except OSError:
        pass
    return None


def resume_session(cfg, f, to_cfg=None, here=False, extra=()):
    """Resume a terminal session in a new tmux window (or terminal window), in its own folder, with its login or,
    with to_cfg, another one it is first copied to. Never two claudes on one transcript."""
    sid = f.stem
    live = {r["sid"]: r for r in live_sessions(extra)}.get(sid)
    if live:
        return False, t("rs_live", w=live["tmux"] or f'pid {live["pid"]}', i=sid[:8])
    cwd = transcript_cwd(f)
    if not cwd or not Path(cwd).is_dir():
        return False, t("rs_nocwd", d=cwd or "?")
    lines = []
    if to_cfg and Path(to_cfg).resolve() != Path(cfg).resolve():
        bk = copy_session(cfg, to_cfg, sid)
        if bk is False:
            return False, t("run_lost", d=short(cfg))
        a, b = rc_name(cli_account(cfg)), rc_name(cli_account(to_cfg))
        lines.append(t("rs_copied", a=a, b=b))
        if bk:
            lines.append(t("run_backup", b=b, p=bk))
        cfg = to_cfg
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    env = {"CLAUDE_CONFIG_DIR": None if cfg == HOME / ".claude" else cfg}
    who, title = rc_name(cli_account(cfg)), first_prompt(f) or sid[:8]
    if here:
        print("\n".join(lines), file=sys.stderr)
        e = {k: v for k, v in os.environ.items() if k != "CLAUDE_CONFIG_DIR"}
        e.update({k: str(v) for k, v in env.items() if v is not None})
        os.chdir(cwd)
        if WIN:
            sys.exit(subprocess.call([exe, "--resume", sid], env=e))
        os.execvpe(exe, [exe, "--resume", sid], e)
    win = open_window(term_script(f"resume-{sid[:8]}", cwd, env, [exe, "--resume", sid]), f"{who}·{title[:16]}")
    lines.append(t("rs_open", s=title, a=who, w=f"tmux {win}" if win else t("rs_term")))
    return True, "\n".join(lines)


def cmd_resume(args):
    found, err = find_transcript(args.session.strip().lower(), args.config or ())
    if err:
