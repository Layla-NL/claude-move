def dock_has(app):
    out = subprocess.run(["defaults", "read", "com.apple.dock", "persistent-apps"], capture_output=True, text=True).stdout
    return app.as_uri() in out


def cmd_app(args):
    """A double-clickable Claude Move.app that opens the panel. It runs on its own, so quitting the desktop app
    from the panel does not stop it; the panel stops 30 minutes after its page is closed."""
    import base64
    import tempfile
    app = Path(os.path.expanduser(args.dir)) / APP_NAME
    if args.action == "uninstall":
        if app.exists():
            shutil.rmtree(app)
        print(t("a_removed", p=app))
        return
    if sys.platform != "darwin":
        sys.exit(t("a_mac"))
    tool = Path(__file__).resolve()
    claude = shutil.which("claude") or ""
    path_dirs = list(dict.fromkeys(([str(Path(claude).parent)] if claude else [])
                                   + [str(HOME / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin"]))
    python = "/usr/bin/python3" if Path("/usr/bin/python3").exists() else sys.executable
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / "launch.applescript"
        src.write_text('on run\n  do shell script quoted form of (POSIX path of (path to me) & '
                       '"Contents/Resources/launch.sh") & " > /dev/null 2>&1 &"\nend run\n')
        if app.exists():
            shutil.rmtree(app)
        app.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["osacompile", "-o", str(app), str(src)], check=True)
        launch = app / "Contents/Resources/launch.sh"
        launch.write_text("#!/bin/sh\n"
                          f"export PATH={json.dumps(':'.join(path_dirs))}:\"$PATH\"\n"
                          f"export CLAUDE_MOVE_LANG={'zh' if ZH else 'en'}\n"
                          + (f"export CLAUDE_MOVE_CLAUDE={json.dumps(claude)}\n" if claude else "")
                          + f"exec {json.dumps(python)} {json.dumps(str(tool))} panel --here --idle 1800\n")
        launch.chmod(0o755)
        iconset = Path(tmp) / "icon.iconset"
        iconset.mkdir()
        png = Path(tmp) / "icon.png"
        if args.icon:
            subprocess.run(["sips", "-s", "format", "png", os.path.expanduser(args.icon), "--out", str(png)],
                           capture_output=True, check=True)
        else:
            png.write_bytes(base64.b64decode("".join(ICON_PNG)))
        for size in (16, 32, 128, 256, 512):
            for scale in (1, 2):
                px = min(512, size * scale)
                name = f"icon_{size}x{size}{'@2x' if scale == 2 else ''}.png"
                subprocess.run(["sips", "-z", str(px), str(px), str(png), "--out", str(iconset / name)],
                               capture_output=True, check=True)
        subprocess.run(["iconutil", "-c", "icns", str(iconset), "-o", str(app / "Contents/Resources/applet.icns")], check=True)
    # osacompile adds an asset catalog whose stock icon wins over applet.icns; drop it and point the plist at ours
    car = app / "Contents/Resources/Assets.car"
    if car.exists():
        car.unlink()
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIconName", str(app / "Contents/Info.plist")],
                   capture_output=True)
    # the edits above break osacompile's ad-hoc seal; sign again so macOS does not call the app damaged
    subprocess.run(["codesign", "--force", "--deep", "--sign", "-", str(app)], capture_output=True, check=True)
    subprocess.run(["touch", str(app)], check=False)
    print(t("a_done", p=app))
    if args.no_dock:
        return
    if dock_has(app):
        print(t("a_in_dock"))
        return
    tile = ("<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key>"
            f"<string>{app.as_uri()}/</string><key>_CFURLStringType</key><integer>15</integer></dict></dict></dict>")
    subprocess.run(["defaults", "write", "com.apple.dock", "persistent-apps", "-array-add", tile], check=True)
    subprocess.run(["killall", "Dock"], check=False)  # the Dock reloads its settings on restart
    print(t("a_dock"))


def settings_path():
    cfg = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(os.path.expanduser(cfg)) / "settings.json" if cfg else DESKTOP_HOME / "settings.json"


def recorder_command():
    return f"{sys.executable} {Path(__file__).resolve()} watch record"


def cmd_watch(args):
    sp = settings_path()
    state = load(WATCH) or {}
    s = load(sp) or {}
    mine = isinstance(s.get("statusLine"), dict) and "watch record" in (s["statusLine"].get("command") or "")
    if args.action == "install":
        if mine:
            print(t("w_already", p=sp))
            return
        prev = s.get("statusLine")
        state[str(sp)] = {"previous": prev}
        CONF.mkdir(parents=True, exist_ok=True)
        WATCH.write_text(json.dumps(state, indent=2) + "\n")
        s["statusLine"] = {"type": "command", "command": recorder_command()}
        sp.parent.mkdir(parents=True, exist_ok=True)
        sp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n")
        print(t("w_on", p=sp))
        if prev:
            print(t("w_chain"))
        print(t("w_desktop"))
    elif args.action == "uninstall":
        if not mine:
            print(t("w_none", p=sp))
            return
        prev = (state.pop(str(sp), None) or {}).get("previous")
        if prev:
            s["statusLine"] = prev
        else:
            s.pop("statusLine", None)
        sp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n")
        WATCH.write_text(json.dumps(state, indent=2) + "\n")
        print(t("w_off", p=sp))
    else:
        watch_record(sp, state)


def watch_record(sp, state):
    """Status line hook: save the official rate limits for the signed-in account, then show the old status line."""
    raw = sys.stdin.read()
    shown = ""
    try:
        d = json.loads(raw)
        rl = d.get("rate_limits")
        cfg = os.environ.get("CLAUDE_CONFIG_DIR")
        acct = cli_account(Path(os.path.expanduser(cfg)) if cfg else HOME / ".claude")
        if isinstance(rl, dict) and acct:
            cur = load(LIMITS) or {}
            rows = [{"kind": kind, "percent": rl[key]["used_percentage"], "resets_at": rl[key].get("resets_at")}
                    for key, kind in (("seven_day", "weekly_all"), ("five_hour", "session"))
                    if isinstance(rl.get(key), dict) and rl[key].get("used_percentage") is not None]
            cur[acct] = {"at": time.time(), "src": "statusline", "rows": rows}
            CONF.mkdir(parents=True, exist_ok=True)
            tmp = LIMITS.with_suffix(".tmp")
            tmp.write_text(json.dumps(cur, indent=2) + "\n")
            tmp.replace(LIMITS)
            f5 = (rl.get("five_hour") or {}).get("used_percentage")
            f7 = (rl.get("seven_day") or {}).get("used_percentage")
            shown = " · ".join(x for x in (f"5h {f5:.0f}%" if f5 is not None else "", f"7d {f7:.0f}%" if f7 is not None else "") if x)
    except Exception:  # a status line must never break the CLI
        pass
    prev = (state.get(str(sp)) or {}).get("previous")
    if isinstance(prev, dict) and prev.get("command"):
        try:
            out = subprocess.run(prev["command"], shell=True, input=raw, capture_output=True, text=True, timeout=5).stdout
            print(out.rstrip("\n"))
            return
        except (OSError, subprocess.SubprocessError):
            pass
    print(shown)


def main(argv=None):
    p = argparse.ArgumentParser(prog="claude-move",
                                description="Move the Claude desktop app's Code session list between accounts (copy only).")
    p.add_argument("--version", action="version", version=f"claude-move {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="accounts on this Mac and their session counts").set_defaults(fn=cmd_list)
    s = sub.add_parser("sessions", help="live sessions of one account")
    s.add_argument("account")
    s.set_defaults(fn=cmd_sessions)
    n = sub.add_parser("name", help="give an account a short label")
    n.add_argument("account")
    n.add_argument("label")
    n.set_defaults(fn=cmd_name)
    to = sub.add_parser("to", help="copy recent live sessions into the target account")
    to.add_argument("target")
    to.add_argument("--from", dest="source", help="source account (default: the most recently used one)")
    to.add_argument("--days", type=float, default=3, help="only sessions used in the last N days (default 3)")
    to.add_argument("--all", action="store_true", help="every live session, regardless of age")
    to.add_argument("--only", action="append", metavar="TEXT",
                    help="only sessions whose title contains TEXT or whose id starts with it (repeatable)")
    to.add_argument("--dry-run", action="store_true", help="show what would be copied, change nothing")
    to.set_defaults(fn=cmd_to)
    u = sub.add_parser("undo", help="put the target account's list back the way it was before the last move")
    u.add_argument("--list", action="store_true", help="list backups")
    u.add_argument("--backup", help="undo this backup instead of the latest one")
    u.add_argument("--dry-run", action="store_true")
    u.set_defaults(fn=cmd_undo)
    ic = sub.add_parser("import-cli", help="copy CLI session transcripts from another config folder into ~/.claude")
    ic.add_argument("--config", required=True, help="the other config folder, e.g. ~/.claude-work")
    ic.add_argument("--project", help="project path (default: current folder) or its folder name under projects/")
    ic.add_argument("--session", action="append", help="session id or id prefix (repeatable)")
    ic.add_argument("--days", type=float, default=3, help="without --session: sessions touched in the last N days")
    ic.add_argument("--dry-run", action="store_true")
    ic.set_defaults(fn=cmd_import_cli)
    us = sub.add_parser("usage", help="quota per account: cooling/reset times, estimated use, official %% from the CLI")
    us.add_argument("--html", action="store_true", help="also write a panel page and open it")
    us.add_argument("--no-open", action="store_true", help="with --html: write the page but do not open it")
    us.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    us.add_argument("--refresh", action="store_true",
                    help="first ask the official /usage of every signed-in CLI config folder (~/.claude, ~/.claude-*)")
    us.set_defaults(fn=cmd_usage)
    pn = sub.add_parser("panel", help="open the quota panel with a button that moves sessions after you switch accounts")
    pn.add_argument("--port", type=int, default=0, help="port on 127.0.0.1 (default: any free port)")
    pn.add_argument("--no-open", action="store_true")
    pn.add_argument("--here", action="store_true", help="run in this process even inside the desktop app's terminal")
    pn.add_argument("--idle", type=float, default=0, help="stop after this many seconds without the page open (default: never)")
    pn.add_argument("--config", action="append", help="also read transcripts from this CLI config folder (repeatable)")
    pn.set_defaults(fn=cmd_panel)
    ap = sub.add_parser("app", help="install a double-clickable Claude Move.app that opens the panel (macOS)")
    ap.add_argument("action", choices=["install", "uninstall"])
    ap.add_argument("--dir", default="~/Applications", help="where to put Claude Move.app (default ~/Applications)")
    ap.add_argument("--no-dock", action="store_true", help="do not add it to the Dock")
    ap.add_argument("--icon", help="use this image (PNG/JPEG, ideally 1024x1024) as the app icon")
    ap.set_defaults(fn=cmd_app)
    tm = sub.add_parser("term", help="open a Terminal window running Claude Code with that account's CLI login")
    tm.add_argument("account", help="label or id prefix of an account signed in under ~/.claude or ~/.claude-*")
    tm.add_argument("--config", action="append", help="also look in this CLI config folder (repeatable)")
    tm.set_defaults(fn=cmd_term)
    w = sub.add_parser("watch", help="record official CLI rate limits from the Claude Code status line")
    w.add_argument("action", choices=["install", "uninstall", "record"])
    w.set_defaults(fn=cmd_watch)
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
