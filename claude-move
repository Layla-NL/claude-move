ROW_ORDER = {"weekly_all": 0, "weekly_scoped": 1, "session": 2}


def official_rows(off):
    """Rows of an official record. Older status line records kept five_hour/seven_day keys."""
    if not isinstance(off, dict):
        return []
    rows = off.get("rows")
    if rows is None:
        rows = []
        for key, kind in (("seven_day", "weekly_all"), ("five_hour", "session")):
            v = off.get(key)
            if isinstance(v, dict) and v.get("used_percentage") is not None:
                rows.append({"kind": kind, "percent": v["used_percentage"], "resets_at": v.get("resets_at")})
    return sorted((r for r in rows if isinstance(r, dict)), key=lambda r: ROW_ORDER.get(r.get("kind"), 9))


def row_label(r):
    if r.get("kind") == "session":
        return t("u_5h")
    base = t("u_week")
    return f"{base} · {r['scope']}" if r.get("kind") == "weekly_scoped" and r.get("scope") else base


def rows_text(rows):
    return " · ".join(t("u_pct", k=row_label(r), p=round(r.get("percent") or 0)) for r in rows)


def plan_name(oa):
    """Plan from the account profile the CLI caches in .claude.json, e.g. organizationType claude_max with
    organizationRateLimitTier default_claude_max_20x -> "Max 20x"."""
    import re
    if not isinstance(oa, dict):
        return ""
    tier = (oa.get("organizationRateLimitTier") or oa.get("userRateLimitTier") or "").lower()
    kind = (oa.get("organizationType") or "").lower()
    m = re.search(r"max_(\d+)x", tier)
    if "max" in kind or m:
        return f"Max {m.group(1)}x" if m else "Max"
    for key, label in (("pro", "Pro"), ("team", "Team"), ("enterprise", "Enterprise")):
        if key in kind or key in tier:
            return label
    return ""


def plans(extra=()):
    out = {}
    for c in cli_configs(extra):
        d = load(HOME / ".claude.json" if c == HOME / ".claude" else c / ".claude.json")
        oa = d.get("oauthAccount") if isinstance(d, dict) else None
        name = plan_name(oa)
        if name and isinstance(oa, dict) and oa.get("accountUuid"):
            out[oa["accountUuid"]] = name
    return out


def cli_command(cfg):
