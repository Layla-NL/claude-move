def captured(fn):
    """Run fn, returning (ok, what it printed); a sys.exit message counts as a failure."""
    import contextlib
    import io
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        try:
            fn()
            ok = True
        except SystemExit as e:
            print(e.code if isinstance(e.code, str) else "")
            ok = False
    return ok, buf.getvalue()


def with_app_closed(fn):
    """Run fn with the desktop app quit first when it is open, and reopen it afterwards."""
    was = app_running()
    log = ""
    if was:
        log = t("p_quitting") + "\n"
        if not quit_app():
            return False, log + t("running")
    ok, out = captured(fn)
    if was:
        out += t("p_opening") + "\n"
        open_app()
    return ok, log + out


def claim_logins():
    """Name accounts signed in through the panel's Add CLI login once their login shows up."""
    pending = load(PENDING)
    if not isinstance(pending, dict) or not pending:
        return
    nm = names()
    left = {}
    for d, p in pending.items():
        acct = cli_account(Path(d))
        if not acct:
            if time.time() - (p.get("at") or 0) < 86400:
                left[d] = p
            continue
        if p.get("label") and not nm.get(acct) and p.get("expect") in (None, acct):
            nm[acct] = p["label"]
            save_names(nm)
    save_json(PENDING, left)


