def look():
    """The panel's own settings: accent strength, light/dark/system theme, and a language that overrides the system's."""
    d = load(LOOK)
    d = d if isinstance(d, dict) else {}
    a = d.get("accent")
    return {"accent": a if isinstance(a, (int, float)) and not isinstance(a, bool) and 0 <= a <= 2 else 1.0,
            "theme": d["theme"] if d.get("theme") in ("light", "dark") else "auto",
