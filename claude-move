def load(p):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def accounts():
    out = []
    if not ROOT.is_dir():
        return out
    for acct in sorted(ROOT.iterdir()):
        if not acct.is_dir():
            continue
        for org in sorted(acct.iterdir()):
            if not org.is_dir():
                continue
            sess = []
            for f in org.glob("local_*.json"):
                d = load(f)
                if isinstance(d, dict) and d.get("sessionId"):
                    sess.append((f, d))
            last = max((d.get("lastActivityAt") or 0 for _, d in sess), default=0)
            out.append({"acct": acct.name, "org": org.name, "dir": org, "sessions": sess, "last": last})
    return out


def label(a):
    return names().get(a["acct"], "")


def show(a):
