    return Path(os.path.expanduser(d or "~/Applications")) / APP_NAME


def png_shrink(png, size=256):
    """The PNG at most size x size, keeping every n-th pixel; only 8-bit, non-interlaced PNGs are shrunk."""
    import struct
    import zlib
    chunks, i = [], 8
    while i + 8 <= len(png):
        n, kind = struct.unpack(">I4s", png[i:i + 8])
        chunks.append((kind, png[i + 8:i + 8 + n]))
        i += 12 + n
    w, h, depth, ctype, _, _, lace = struct.unpack(">IIBBBBB", chunks[0][1])
    ch = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(ctype)
    step = -(-max(w, h) // size)
    if step <= 1 or depth != 8 or lace or not ch:
        return png
    raw, stride, pos = zlib.decompress(b"".join(d for k, d in chunks if k == b"IDAT")), w * ch, 0
    rows, prev = [], bytearray(stride)
    for _ in range(h):  # undo each row's filter (PNG spec, section 9)
        f, line = raw[pos], bytearray(raw[pos + 1:pos + 1 + stride])
        pos += 1 + stride
        for x in range(stride):
            a, b, c = line[x - ch] if x >= ch else 0, prev[x], prev[x - ch] if x >= ch else 0
            if f == 1:
                line[x] = (line[x] + a) & 255
            elif f == 2:
                line[x] = (line[x] + b) & 255
            elif f == 3:
                line[x] = (line[x] + (a + b) // 2) & 255
            elif f == 4:
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append(line)
        prev = line
    out = b"".join(b"\0" + b"".join(bytes(r[x:x + ch]) for x in range(0, stride, step * ch)) for r in rows[::step])
    chunk = lambda k, d: struct.pack(">I", len(d)) + k + d + struct.pack(">I", zlib.crc32(k + d))
    head = chunk(b"IHDR", struct.pack(">IIBBBBB", -(-w // step), -(-h // step), 8, ctype, 0, 0, 0))
    keep = b"".join(chunk(k, d) for k, d in chunks if k in (b"PLTE", b"tRNS"))
    return png[:8] + head + keep + chunk(b"IDAT", zlib.compress(out, 9)) + chunk(b"IEND", b"")


def png_to_ico(png):
    """An .ico holding one PNG image, as Windows Vista and later read them."""
    import struct
    w, h = struct.unpack(">II", png[16:24])
    return (struct.pack("<HHH", 0, 1, 1)
            + struct.pack("<BBBBHHII", w % 256, h % 256, 0, 0, 1, 32, len(png), 22) + png)


def win_desktop():
    out = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command",
                          "[Environment]::GetFolderPath('Desktop')"], capture_output=True, text=True,
                         encoding="utf-8", errors="replace", creationflags=NO_WINDOW).stdout.strip()
    return Path(out) if out else HOME / "Desktop"


def app_install_win(args, lnk):
    """A Start menu shortcut (and one on the desktop) that runs the panel under pythonw, without a console."""
    import base64
    if args.icon:
        data = Path(os.path.expanduser(args.icon)).read_bytes()
        if data[:8] == b"\x89PNG\r\n\x1a\n":
            data = png_to_ico(png_shrink(data))
        elif data[:4] != b"\0\0\1\0":
            sys.exit(t("a_win_icon"))
    else:
        data = png_to_ico(png_shrink(base64.b64decode("".join(ICON_PNG))))
    ico = CONF / "claude-move.ico"
    CONF.mkdir(parents=True, exist_ok=True)
    ico.write_bytes(data)
    pyw = Path(sys.executable).with_name("pythonw.exe")
    links = [lnk] + ([] if args.no_dock else [win_desktop() / lnk.name])
    ps = ("$w = New-Object -ComObject WScript.Shell; foreach ($p in $env:CM_LINKS.Split('|')) { "
          "$s = $w.CreateShortcut($p); $s.TargetPath = $env:CM_TARGET; $s.Arguments = $env:CM_ARGS; "
          "$s.WorkingDirectory = $env:USERPROFILE; $s.IconLocation = $env:CM_ICON; "
          "$s.Description = 'claude-move panel'; $s.Save() }")
    lnk.parent.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, CM_LINKS="|".join(map(str, links)), CM_ICON=str(ico),
               CM_TARGET=str(pyw if pyw.exists() else sys.executable),
               CM_ARGS=f'"{Path(__file__).resolve()}" panel --here --idle 1800')
    subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps], env=env, check=True,
                   capture_output=True, creationflags=NO_WINDOW)
    print(t("a_done", p=lnk))
    if not args.no_dock:
        print(t("a_dock"))


def dock_has(app):
    out = subprocess.run(["defaults", "read", "com.apple.dock", "persistent-apps"], capture_output=True, text=True).stdout
    return app.as_uri() in out


def cmd_app(args):
    """A double-clickable Claude Move.app that opens the panel. It runs on its own, so quitting the desktop app
    from the panel does not stop it; the panel stops 30 minutes after its page is closed."""
    import base64
    import tempfile
    app = app_path(args.dir)
    if args.action == "uninstall":
        if WIN:
            for f in (app, win_desktop() / app.name):
                if f.exists():
                    f.unlink()
        elif app.exists():
            shutil.rmtree(app)
        print(t("a_removed", p=app))
        return
    if WIN:
        return app_install_win(args, app)
    if sys.platform != "darwin":
        sys.exit(t("a_mac"))
    tool = Path(__file__).resolve()
    claude = shutil.which("claude") or ""
    path_dirs = list(dict.fromkeys(([str(Path(claude).parent)] if claude else [])
                                   + [str(HOME / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin"]))
    python = "/usr/bin/python3" if Path("/usr/bin/python3").exists() else sys.executable
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / "launch.applescript"
        src.write_text('on run\n  do shell script quoted form of (POSIX path of (path to me) & '
                       '"Contents/Resources/launch.sh") & " > /dev/null 2>&1 &"\nend run\n')
        if app.exists():
            shutil.rmtree(app)
        app.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["osacompile", "-o", str(app), str(src)], check=True)
        launch = app / "Contents/Resources/launch.sh"
        launch.write_text("#!/bin/sh\n"
                          f"export PATH={json.dumps(':'.join(path_dirs))}:\"$PATH\"\n"
                          f"export CLAUDE_MOVE_LANG={'zh' if ZH else 'en'}\n"
                          + (f"export CLAUDE_MOVE_CLAUDE={json.dumps(claude)}\n" if claude else "")
                          + f"exec {json.dumps(python)} {json.dumps(str(tool))} panel --here --idle 1800\n")
        launch.chmod(0o755)
        iconset = Path(tmp) / "icon.iconset"
        iconset.mkdir()
        png = Path(tmp) / "icon.png"
        if args.icon:
            subprocess.run(["sips", "-s", "format", "png", os.path.expanduser(args.icon), "--out", str(png)],
                           capture_output=True, check=True)
        else:
            png.write_bytes(base64.b64decode("".join(ICON_PNG)))
        for size in (16, 32, 128, 256, 512):
            for scale in (1, 2):
                px = min(512, size * scale)
                name = f"icon_{size}x{size}{'@2x' if scale == 2 else ''}.png"
                subprocess.run(["sips", "-z", str(px), str(px), str(png), "--out", str(iconset / name)],
                               capture_output=True, check=True)
        subprocess.run(["iconutil", "-c", "icns", str(iconset), "-o", str(app / "Contents/Resources/applet.icns")], check=True)
    # osacompile adds an asset catalog whose stock icon wins over applet.icns; drop it and point the plist at ours
    car = app / "Contents/Resources/Assets.car"
    if car.exists():
        car.unlink()
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIconName", str(app / "Contents/Info.plist")],
                   capture_output=True)
    # the edits above break osacompile's ad-hoc seal; sign again so macOS does not call the app damaged
    subprocess.run(["codesign", "--force", "--deep", "--sign", "-", str(app)], capture_output=True, check=True)
    subprocess.run(["touch", str(app)], check=False)
    print(t("a_done", p=app))
    if args.no_dock:
        return
    if dock_has(app):
        print(t("a_in_dock"))
        return
    tile = ("<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key>"
            f"<string>{app.as_uri()}/</string><key>_CFURLStringType</key><integer>15</integer></dict></dict></dict>")
    subprocess.run(["defaults", "write", "com.apple.dock", "persistent-apps", "-array-add", tile], check=True)
    subprocess.run(["killall", "Dock"], check=False)  # the Dock reloads its settings on restart
    print(t("a_dock"))


