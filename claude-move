    return Path(os.path.expanduser(cfg)) / "settings.json" if cfg else DESKTOP_HOME / "settings.json"


def recorder_command():
    if WIN:  # Claude Code may run it through Git Bash, which eats backslashes; quoted forward slashes work in both
        return f'"{console_python().as_posix()}" "{Path(__file__).resolve().as_posix()}" watch record'
    return f"{sys.executable} {Path(__file__).resolve()} watch record"


def recorder_path(c):
    return (DESKTOP_HOME if c == HOME / ".claude" else c) / "settings.json"


def recorder_on(c):
    s = load(recorder_path(c))
    line = s.get("statusLine") if isinstance(s, dict) else None
    return isinstance(line, dict) and "watch record" in (line.get("command") or "")


def cmd_watch(args):
    sp = settings_path()
    if args.action == "record":
        watch_record(sp, load(WATCH) or {})
    else:
        watch_set(sp, args.action == "install")


def watch_set(sp, on):
    """Put the recorder into one settings.json, keeping the status line that was there, or take it out again."""
    state = load(WATCH) or {}
    s = load(sp) or {}
    mine = isinstance(s.get("statusLine"), dict) and "watch record" in (s["statusLine"].get("command") or "")
    if on:
        if mine:
            print(t("w_already", p=sp))
            return
        prev = s.get("statusLine")
        state[str(sp)] = {"previous": prev}
        CONF.mkdir(parents=True, exist_ok=True)
        WATCH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
        s["statusLine"] = {"type": "command", "command": recorder_command()}
        sp.parent.mkdir(parents=True, exist_ok=True)
        sp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        print(t("w_on", p=sp))
        if prev:
            print(t("w_chain"))
        print(t("w_desktop"))
    else:
        if not mine:
            print(t("w_none", p=sp))
            return
        prev = (state.pop(str(sp), None) or {}).get("previous")
        if prev:
            s["statusLine"] = prev
        else:
            s.pop("statusLine", None)
        sp.write_text(json.dumps(s, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        WATCH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
        print(t("w_off", p=sp))


def watch_record(sp, state):
    """Status line hook: save the official rate limits for the signed-in account, then show the old status line."""
    if WIN:  # Claude Code reads the status line as UTF-8, not in the console's code page
        sys.stdout.reconfigure(encoding="utf-8")
    raw = sys.stdin.read()
    shown = ""
    try:
        d = json.loads(raw)
        rl = d.get("rate_limits")
        cfg = os.environ.get("CLAUDE_CONFIG_DIR")
        acct = cli_account(Path(os.path.expanduser(cfg)) if cfg else HOME / ".claude")
        if isinstance(rl, dict) and acct:
            cur = load(LIMITS) or {}
            rows = [{"kind": kind, "percent": rl[key]["used_percentage"], "resets_at": rl[key].get("resets_at")}
                    for key, kind in (("seven_day", "weekly_all"), ("five_hour", "session"))
                    if isinstance(rl.get(key), dict) and rl[key].get("used_percentage") is not None]
            old = cur.get(acct) if isinstance(cur.get(acct), dict) else {}
            if time.time() - old.get("at", 0) < 3600:  # the status line has no per-model meters: keep those /usage gave
                rows += [r for r in official_rows(old) if r.get("kind") == "weekly_scoped" and (r.get("resets_at") or 0) > time.time()]
            cur[acct] = {"at": time.time(), "src": "statusline", "rows": rows}
            save_json(LIMITS, cur)
            check_levels(acct, rows)
            if acct == crew_acct() and time.time() - ((load(SNAP_CONF) or {}).get("at") or 0) >= 60:
                write_snapshot(Path(os.path.expanduser(cfg)) if cfg else HOME / ".claude", snapshot_out())
            f5 = (rl.get("five_hour") or {}).get("used_percentage")
            f7 = (rl.get("seven_day") or {}).get("used_percentage")
            shown = " · ".join(x for x in (f"5h {f5:.0f}%" if f5 is not None else "", f"7d {f7:.0f}%" if f7 is not None else "") if x)
    except Exception:  # a status line must never break the CLI
        pass
    prev = (state.get(str(sp)) or {}).get("previous")
    if isinstance(prev, dict) and prev.get("command"):
        try:
            bash = WIN and git_bash()
            run = [bash, "-c", prev["command"]] if bash else prev["command"]
            out = subprocess.run(run, shell=not bash, input=raw, capture_output=True, text=True, encoding="utf-8",
                                 errors="replace", timeout=5).stdout
            print(out.rstrip("\n"))
            return
        except (OSError, subprocess.SubprocessError):
            pass
    print(shown)


def git_bash():
    """Windows: the Git Bash Claude Code runs commands with (never WSL's bash.exe in System32)."""
    p = os.environ.get("CLAUDE_CODE_GIT_BASH_PATH")
    if p and Path(p).exists():
        return p
    git = shutil.which("git")
    for c in ([Path(git).parents[1] / "bin/bash.exe", Path(git).parents[1] / "usr/bin/bash.exe"] if git else []):
        if c.exists():
            return str(c)
    return None


