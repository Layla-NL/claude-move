    elif rep["first_back"]:
        f = rep["first_back"]
        advice = (f'<span class="advice" data-tip="{tip(t("u_pick_none", a=f["name"], w=clock(f["cool"]["until"])))}">'
                  f'<span class="dot" data-heat="100"></span>{E(f["name"])} {E(short_clock(f["cool"]["until"], now))}</span>')
