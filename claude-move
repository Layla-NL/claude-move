def check_update():
    import urllib.request
    url = os.environ.get("CLAUDE_MOVE_UPDATE_URL", "https://api.github.com/repos/Layla-NL/claude-move/releases/latest")
    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "claude-move"})
    with urllib.request.urlopen(req, timeout=10) as r:
        d = json.loads(r.read().decode("utf-8"))
    tag = str(d.get("tag_name") or "").lstrip("v")
    ver = lambda v: tuple(int(x) for x in re.findall(r"\d+", v)[:3])
    return tag, d.get("html_url") or "", ver(tag) > ver(__version__)


def panel_accounts(extra=()):
    nm = names()
    out = {}
    for a in accounts():
        if a["sessions"]:
            e = out.setdefault(a["acct"], {"acct": a["acct"], "desk": True, "live": 0})
            e["live"] += sum(1 for _, d in a["sessions"] if not d.get("isArchived"))
    for c in cli_configs(extra):
        e = out.setdefault(cli_account(c), {"acct": cli_account(c), "desk": False, "live": 0})
        if "cli" not in e:
            e.update(cli=short(c), cli_home=c.resolve() == DESKTOP_HOME.resolve(), recorder=recorder_on(c),
                     settings=short(recorder_path(c)))
    for e in out.values():
        e["label"] = nm.get(e["acct"], "")
        e["name"] = e["label"] or e["acct"][:8]
    return sorted(out.values(), key=lambda e: e["name"].lower())


def desk_sessions(acct):
    hits = [a for a in accounts() if a["acct"] == acct]
    if not hits:
        return None
    a = max(hits, key=lambda a: len(a["sessions"]))  # the same org `to` would pick
    rows = [{"id": d["sessionId"], "title": d.get("title") or t("untitled"), "last": d.get("lastActivityAt") or 0,
             "archived": bool(d.get("isArchived"))} for _, d in a["sessions"]]
    return sorted(rows, key=lambda r: r["last"], reverse=True)


def cli_sessions(cfg, limit=30):
    files = []
    for f in cfg.glob("projects/*/*.jsonl"):
        try:
            files.append((f.stat().st_mtime, f))
        except OSError:
            pass
    home = project_dir_name(HOME) + "-"
    return [{"id": f.stem, "project": f.parent.name[len(home):] if f.parent.name.startswith(home) else f.parent.name,
             "title": first_prompt(f) or t("untitled"), "last": int(m * 1000),
             "in_desk": (DESKTOP_HOME / "projects" / f.parent.name / f.name).exists()}
            for m, f in sorted(files, reverse=True)[:limit]]


