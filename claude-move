                return self.send(code, json.dumps(out, ensure_ascii=False))
            if path == "/refresh":
                import contextlib
                import io
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    refresh_official(args.config or ())
                return self.send(200, json.dumps({"ok": True, "log": buf.getvalue()}, ensure_ascii=False))
            self.send(404, "{}")

    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{srv.server_port}/?t={token}"
    CONF.mkdir(parents=True, exist_ok=True)
    if not args.demo:
        PANEL.write_text(json.dumps({"pid": os.getpid(), "url": url}) + "\n", encoding="utf-8")
        os.chmod(PANEL, 0o600)
    print(t("p_url", u=url), flush=True)
    if not args.no_open:
        open_path(url)

    def idle_watch():  # the open page polls every few seconds, so this only fires after the tab is gone
        while True:
            time.sleep(5)
            if args.idle and not busy["on"] and time.time() - seen["t"] > args.idle:
                srv.shutdown()
                return

    threading.Thread(target=idle_watch, daemon=True).start()
    if not args.demo:
        threading.Thread(target=index_quietly, args=(args.config or (),), daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        cur = load(PANEL)
        if isinstance(cur, dict) and cur.get("pid") == os.getpid():
            PANEL.unlink()


def pid_alive(pid):
    if WIN:  # os.kill would end the process on Windows; ask whether it is still running instead
        try:
            import ctypes
            k = kernel32()
            h = k.OpenProcess(0x1000, False, int(pid))
            if not h:
                return False
            code = ctypes.c_ulong()
            k.GetExitCodeProcess(h, ctypes.byref(code))
            k.CloseHandle(h)
            return code.value == 259  # STILL_ACTIVE
        except (OSError, TypeError, ValueError, AttributeError):
            return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


