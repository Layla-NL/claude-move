                    "switches": [{"at": x.get("at") or 0, "from": who(x.get("from")), "to": who(x.get("to"))}
                                 for x in d.get("switches") or []]})
    return out


SESSION_ID = re.compile(r"^(local_)?[0-9a-f-]{8,64}$")


def panel_api(method, path, q, body, extra=()):
    """Every button behind /api/: a fixed action, and every value from the page is checked against this Mac."""
    name = path[len("/api/"):]
    bad = (400, {"ok": False, "log": t("pt_bad")})
    accts = panel_accounts(extra)
    by = {a["acct"]: a for a in accts}
    acct = str(body.get("acct") or q.get("acct") or "")
    cfg = next((c for c in cli_configs(extra) if acct and cli_account(c) == acct), None)
    if method == "GET":
        if name == "accounts":
            claim_logins()
            return 200, {"accounts": panel_accounts(extra)}
        if name == "sessions":
            rows = desk_sessions(acct) if acct in by else None
            return (200, {"sessions": rows}) if rows is not None else bad
        if name == "backups":
            out = []
            nm = names()
            for b, m in backups()[:30]:
                if b.name.endswith("-before-undo"):
                    continue
                ok = isinstance(m, dict) and m.get("version") == 1
                who = nm.get(m.get("account", ""), m.get("account", "")[:8]) if ok else ""
                text = t("bk_line", n=b.name, w=time.strftime("%m-%d %H:%M", time.localtime(m.get("created", 0))),
                         c=len(m.get("replaced", [])) + len(m.get("added", [])), a=who) if ok else t("bk_old", n=b.name)
                out.append({"name": b.name, "ok": ok, "undone": bool(ok and m.get("undone")), "account": who, "text": text})
            return 200, {"backups": out}
        if name == "runs":
            return 200, {"runs": run_list()}
        if name == "cli-sessions":
            if not cfg or cfg.resolve() == DESKTOP_HOME.resolve():
                return bad
            return 200, {"sessions": cli_sessions(cfg)}
        if name == "doctor":
            return 200, {"items": doctor_items(extra)}
        if name == "notify":
            return 200, notify_conf()
        if name == "update":
            try:
                tag, url, newer = check_update()
            except (OSError, ValueError) as e:
                return 200, {"ok": False, "log": t("pt_update_fail", e=e)}
            log = t("pt_update_new", v=tag, c=__version__, u=url) if newer else t("pt_update_none", c=__version__, v=tag or "-")
            return 200, {"ok": True, "newer": newer, "url": url if newer else "", "log": log}
        return 404, {}
    if name == "move":
        src, dst = str(body.get("from") or ""), str(body.get("to") or "")
        rng = str(body.get("range") or "3")
        if src not in by or dst not in by or not by[src]["desk"] or not by[dst]["desk"] or rng not in ("3", "7", "all", "pick"):
            return bad
        only = None
        if rng == "pick":
            ids = {r["id"] for r in desk_sessions(src) or []}
            only = [str(x) for x in body.get("only") or [] if str(x) in ids]
            if not only:
                return 200, {"ok": False, "log": t("nothing")}
        ns = argparse.Namespace(target=dst, source=src, days=float(rng) if rng in ("3", "7") else 3, all=rng == "all",
                                only=only, dry_run=bool(body.get("dry")))
        ok, log = captured(lambda: cmd_to(ns)) if ns.dry_run else with_app_closed(lambda: cmd_to(ns))
        return 200, {"ok": ok, "log": log}
    if name == "undo":
        bk = str(body.get("name") or "")
        if bk not in {b.name for b, m in backups() if isinstance(m, dict) and m.get("version") == 1}:
            return bad
        ns = argparse.Namespace(list=False, backup=bk, dry_run=bool(body.get("dry")))
        ok, log = captured(lambda: cmd_undo(ns)) if ns.dry_run else with_app_closed(lambda: cmd_undo(ns))
        return 200, {"ok": ok, "log": log}
    if name == "name":
        label = str(body.get("label") or "").strip()
        if acct not in by:
            return bad
        if len(label) > 32 or any(ord(ch) < 32 for ch in label):
            return 200, {"ok": False, "log": t("pt_label_bad")}
        nm = names()
        if label:
            nm[acct] = label
        else:
            nm.pop(acct, None)
        save_names(nm)
        return 200, {"ok": True, "log": t("pt_saved")}
    if name == "watch":
        if not cfg:
            return bad
        ok, log = captured(lambda: watch_set(recorder_path(cfg), bool(body.get("on"))))
        return 200, {"ok": ok, "log": log}
    if name == "login":
        nm = names()
        if acct:
            if acct not in by or not by[acct]["desk"]:
                return bad
            label = nm.get(acct, "")
            folder = re.sub(r"[^A-Za-z0-9-]", "", label)[:24] or acct[:8]
            who, new_label = label or acct[:8], None
        else:
            folder = str(body.get("name") or "").strip()
            if not re.fullmatch(r"[A-Za-z0-9-]{1,24}", folder):
                return 200, {"ok": False, "log": t("pt_login_bad")}
            who, new_label = t("pt_login_any"), folder
        target = HOME / f".claude-{folder}"
        if cli_account(target):
            return 200, {"ok": False, "log": t("pt_login_exists", d=short(target))}
        target.mkdir(exist_ok=True)
        pending = load(PENDING) or {}
        pending[str(target)] = {"label": new_label, "expect": acct or None, "at": time.time()}
        save_json(PENDING, pending)
        open_login(target, who)
        return 200, {"ok": True, "log": t("pt_login_opened", d=short(target), a=who)}
    if name == "notify":
        if body.get("test"):
            notify(t("n_title"), t("n_test"))
            return 200, {"ok": True, "log": t("n_sent")}
        conf = notify_conf()
        try:
            levels = sorted({int(x) for x in str(body.get("levels") or "").split(",") if x.strip()})
        except ValueError:
            levels = []
        if not levels or not all(1 <= x <= 100 for x in levels):
            return 200, {"ok": False, "log": t("pt_levels_bad")}
        conf.update(on=bool(body.get("on")), levels=levels)
        save_json(NOTIFY, conf)
        return 200, {"ok": True, "log": t("n_on", l="/".join(map(str, levels))) if conf["on"] else t("n_off")}
    if name == "import":
        if not cfg or cfg.resolve() == DESKTOP_HOME.resolve():
            return bad
        lines, n = [], 0
        for sid in [str(x) for x in body.get("ids") or [] if SESSION_ID.match(str(x))]:
            f = next(iter(cfg.glob(f"projects/*/{sid}.jsonl")), None)
            if not f:
                continue
            w = time.strftime("%m-%d %H:%M", time.localtime(f.stat().st_mtime))
            added = import_one(f, DESKTOP_HOME)
            n += added
            lines.append(t("imp_add" if added else "imp_skip", i=sid, w=w, t=first_prompt(f)))
        return 200, {"ok": True, "log": "\n".join(lines + [t("imp_done", n=n) if lines else t("nothing")])}
    if name == "doctor":
        _, log = captured(lambda: refresh_official(extra))
        return 200, {"ok": True, "log": log, "items": doctor_items(extra)}
    return 404, {}


