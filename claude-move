def recent_cwd(cfg):
    """The project folder the account behind `cfg` used last: its newest desktop session or the newest transcript in
    the CLI folder, whichever is newer. A worktree counts as its repo. None when that folder is gone."""
    acct = cli_account(cfg)
    best = (0, None)
    for a in accounts():
        if a["acct"] == acct:
            for _, d in a["sessions"]:
                ts = (d.get("lastActivityAt") or 0) / 1000
                if ts > best[0] and (d.get("originCwd") or d.get("cwd")):
                    best = (ts, d.get("originCwd") or d.get("cwd"))
    jsonl = []
    for f in (cfg / "projects").glob("*/*.jsonl"):
        try:
            jsonl.append((f.stat().st_mtime, f))
        except OSError:
            pass
    if jsonl:
        ts, f = max(jsonl)
        if ts > best[0]:
            try:
                with f.open(encoding="utf-8", errors="replace") as fh:
                    for _, line in zip(range(50), fh):
                        try:
                            cwd = json.loads(line).get("cwd")
                        except (ValueError, AttributeError):
                            continue
                        if cwd:
                            best = (ts, cwd)
                            break
            except OSError:
                pass
    cwd = best[1]
    if cwd and os.sep + ".claude" + os.sep + "worktrees" + os.sep in cwd:
        cwd = cwd.split(os.sep + ".claude" + os.sep + "worktrees" + os.sep)[0]
    return Path(cwd) if cwd and Path(cwd).is_dir() else None


def open_terminal(cfg, rc=False, auto=False):
    """A new terminal window running `claude` with this config folder, so the CLI uses that folder's own login, in the
    account's last project folder; with rc, as a Remote Control session named after the account so the phone app
    can join it; with auto, through `claude-move run`, which changes account at a usage limit.
    It writes a small script and opens it (.command on macOS: no Automation permission; .cmd on Windows)."""
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    cwd = recent_cwd(cfg)
    if auto:
        env = {"CLAUDE_MOVE_LANG": "zh" if ZH else "en"}
        argv = [console_python(), Path(__file__).resolve(), "run", "--config", cfg, cli_account(cfg)] + (["--rc"] if rc else [])
    else:
        env = {"CLAUDE_CONFIG_DIR": None if cfg == HOME / ".claude" else cfg}
        argv = [exe] + (["--remote-control", rc_name(cli_account(cfg))] if rc else [])
    win = open_window(term_script(cfg.name.lstrip(".") + ("-rc" if rc else "") + ("-auto" if auto else ""), cwd, env, argv),
                      rc_name(cli_account(cfg)))
    return cwd, win


def console_python():
    """This Python, but the console one when the panel runs under Windows' windowless pythonw."""
    exe = Path(sys.executable)
    con = exe.with_name("python.exe")
    return con if WIN and exe.name.lower() == "pythonw.exe" and con.exists() else exe


def term_script(name, cwd, env, argv, before=(), after=()):
    """A script for a new terminal window: go to cwd (else home), set env (None unsets), print `before`, run argv,
    then print `after`. Returns its path under CONF/term and its text: sh on macOS, cmd on Windows."""
    if WIN:
        bare = lambda x: str(x).replace('"', "").replace("%", "%%")
        q = lambda x: f'"{bare(x)}"' if not str(x) or re.search(r"[\s&|<>^(),;=!%]", str(x)) else bare(x)
        say = lambda x: "echo(" + re.sub(r"([&|<>^()])", r"^\1", str(x)).replace("%", "%%")
        lines = ["@echo off", "chcp 65001 >nul", (f"cd /d {q(cwd)} 2>nul || " if cwd else "") + 'cd /d "%USERPROFILE%"']
        lines += [f'set "{k}={"" if v is None else bare(v)}"' for k, v in env.items()]
        run = " ".join(q(a) for a in argv)
        if str(argv[0]).lower().endswith((".cmd", ".bat")):  # an npm install's claude.cmd: come back after it
            run = "call " + run
        lines += [say(x) for x in before] + [run] + [say(x) for x in after]
        return CONF / "term" / (name + ".cmd"), "\r\n".join(lines) + "\r\n"
    from shlex import quote
    lines = ["#!/bin/sh", (f"cd {quote(str(cwd))} 2>/dev/null || " if cwd else "") + "cd ~ || exit 1"]
    lines += [f"unset {k}" if v is None else f"export {k}={quote(str(v))}" for k, v in env.items()]
    lines += [f"echo {quote(x)}" for x in before]
    lines += [("" if after else "exec ") + " ".join(quote(str(a)) for a in argv)]
    lines += [f"echo {quote(x)}" for x in after]
    return CONF / "term" / (name + ".command"), "\n".join(lines) + "\n"


def write_script(script_body):
    script, body = script_body
    script.parent.mkdir(parents=True, exist_ok=True)
    script.write_bytes(body.encode("utf-8"))
    script.chmod(0o700)
    return script


def open_command(script_body):
    """Open a term_script in a new terminal window. On Windows the window stays open after it ends, as Terminal's does."""
    from shlex import quote
    script = write_script(script_body)
    cmd = os.environ.get("CLAUDE_MOVE_TERM_CMD")
    if cmd:
        subprocess.run(f'{cmd} "{script}"' if WIN else f"{cmd} {quote(str(script))}", shell=True)
    elif WIN:
        subprocess.Popen(["cmd.exe", "/k", str(script)], creationflags=subprocess.CREATE_NEW_CONSOLE)
    else:
        subprocess.run(["open", str(script)], check=False)


def cmd_term(args):
    cfg = cli_dir(args.account.strip(), args.config or ())
    if not cfg:
        sys.exit(t("t_none", t=args.account))
    acct = cli_account(cfg)
    cwd, win = open_terminal(cfg, args.rc, args.auto)
    cmd = f"claude-move run {rc_name(acct)}" + (" --rc" if args.rc else "") if args.auto else (
        rc_command(cfg) if args.rc else cli_command(cfg))
    print(t("t_open_tmux" if win else "t_open", w=win, a=names().get(acct, acct[:8]), d=short(cwd) if cwd else "~", c=cmd))


def cli_configs(extra=()):
    """CLI config folders that have been signed in: ~/.claude-*, any passed with --config, then ~/.claude. A folder
    made for one account comes before ~/.claude, whose cached profile can outlive its login."""
    found = sorted(p for p in HOME.glob(".claude-*") if p.is_dir())
    found += [Path(os.path.expanduser(c)) for c in extra] + [HOME / ".claude"]
    out = []
    for c in found:
        if c not in out and cli_account(c):
            out.append(c)
    return out


def parse_reset(text, tz):
    """'Oct 27 at 10am', '3pm', '3:30pm' in the given IANA zone -> epoch seconds (next occurrence)."""
    try:
        from zoneinfo import ZoneInfo
        zone = timezone.utc if tz and tz.upper() in ("UTC", "GMT", "ETC/UTC") else ZoneInfo(tz) if tz else None
    except Exception:  # Windows has no zone database without the tzdata package; the CLI names the local zone
        zone = None
    m = re.match(r"(?:([A-Z][a-z]{2}) (\d{1,2})(?: at )?)?\s*(\d{1,2})(?::(\d\d))?\s*([ap]m)$", text.strip(), re.I)
    if not m:
        return None
    mon, day, hour, minute, ap = m.groups()
    hour = int(hour) % 12 + (12 if ap.lower() == "pm" else 0)
    now = datetime.now(zone) if zone else datetime.now()
    try:
        if mon:
            month = datetime.strptime(mon, "%b").month
            when = now.replace(month=month, day=int(day), hour=hour, minute=int(minute or 0), second=0, microsecond=0)
            if when.timestamp() < now.timestamp() - 86400 * 180:
                when = when.replace(year=when.year + 1)
        else:
            when = now.replace(hour=hour, minute=int(minute or 0), second=0, microsecond=0)
            if when.timestamp() < now.timestamp():
                when = datetime.fromtimestamp(when.timestamp() + 86400, when.tzinfo)
    except ValueError:
        return None
    return when.timestamp()


def parse_usage_text(text):
    """Fallback when the structured report has no rows: the /usage text says the same thing, e.g.
    'Current week (all models): 96% used · resets Oct 27 at 10am (Asia/Singapore)'."""
    rows = []
    for line in text.splitlines():
        m = re.match(r"\s*Current (session|week)(?: \((.+?)\))?:\s*(\d+(?:\.\d+)?)% used(?:\s*·\s*resets (.+?)(?: \(([^)]+)\))?)?\s*$", line)
        if not m:
            continue
        kind, scope, pct, when, tz = m.groups()
        if kind == "session":
            k = "session"
        else:
            k = "weekly_all" if (scope or "").lower() in ("", "all models") else "weekly_scoped"
        rows.append({"kind": k, "percent": float(pct), "resets_at": parse_reset(when, tz) if when else None,
                     "scope": scope if k == "weekly_scoped" else None})
    return rows


def parse_usage_report(stdout):
    """Rows of the `usage_report` that `claude -p /usage --output-format stream-json` attaches to its reply."""
    for line in stdout.splitlines():
        try:
            m = json.loads(line)
        except ValueError:
            continue
        rep_ = m.get("usage_report") if isinstance(m, dict) else None
        if rep_ is None and isinstance(m, dict) and isinstance(m.get("message"), dict):
            rep_ = m["message"].get("usage_report")
        if not isinstance(rep_, dict):
            continue
        limits = ((rep_.get("rate_limits") or {}).get("limits")) or []
        if not limits:
            text = " ".join(c.get("text", "") for c in ((m.get("message") or {}).get("content") or []) if isinstance(c, dict))
            return parse_usage_text(text) or None
        rows = []
        for r in limits:
            if not isinstance(r, dict) or r.get("percent") is None:
                continue
            model = (r.get("scope") or {}).get("model") if isinstance(r.get("scope"), dict) else None
            model = model if isinstance(model, dict) else {}
            row = {"kind": r.get("kind") or "", "percent": r["percent"],
                   "resets_at": iso_ts(r["resets_at"]) if r.get("resets_at") else None, "scope": model.get("display_name")}
            if model.get("id"):
                row["model"] = model["id"]
            rows.append(row)
        return rows
    return None


def refresh_official(extra=()):
    """Run the official `/usage` command once per signed-in CLI config folder. It is a local command: no model call,
    no quota used. claude-move only runs the CLI; the CLI uses its own login."""
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude")
    if not exe:
        print(t("r_noclaude"))
        return
    cfgs = cli_configs(extra)
    if not cfgs:
        print(t("r_none"))
        return
    print(t("r_scan"))
    for c in cfgs:
        shown = short(c)
        try:
            rows = refresh_one(c, exe)
        except (OSError, subprocess.SubprocessError) as e:
            print(t("r_fail", d=shown, e=e))
            continue
        if rows is None:  # signed out, or signed in with an API key: /usage then reports cost only
            print(t("r_fail", d=shown, e=t("r_nologin", d=shown, p=c)))
            continue
        acct = cli_account(c)
        print(t("r_ok", d=shown, a=names().get(acct, acct[:8]), rows=rows_text(rows)))


def short(p):
    return "~/" + str(p.relative_to(HOME)) if str(p).startswith(str(HOME) + os.sep) else str(p)


def save_json(path, d):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(path)


def refresh_one(c, exe=None):
    """The official /usage of one CLI config folder, saved to limits.json. None when it reports no plan usage.
    Each folder's last answer is kept in logins.json for doctor."""
    exe = exe or os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude") or "claude"
    env = dict(os.environ)
    if c == HOME / ".claude":
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = str(c)
    r = subprocess.run([exe, "-p", "/usage", "--output-format", "stream-json", "--verbose", "--no-session-persistence"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace", env=env, timeout=90,
                       stdin=subprocess.DEVNULL)
    rows = parse_usage_report(r.stdout)
    logins = load(LOGINS) or {}
    logins[str(c)] = {"at": time.time(), "ok": bool(rows)}
    save_json(LOGINS, logins)
    if not rows:
        return None
    acct = cli_account(c)
    rows = official_rows({"rows": rows})
    cur = load(LIMITS) or {}
    cur[acct] = {"at": time.time(), "src": "usage", "rows": rows}
    save_json(LIMITS, cur)
    check_levels(acct, rows)
    return rows


def usage_report(extra_cfgs=(), now=None):
    now = now or time.time()
    accts = accounts()
    idx = owner_index(accts)
    # every CLI login's own folder too: its replies count for its account
    roots = list(dict.fromkeys([DESKTOP_HOME] + [Path(os.path.expanduser(c)) for c in extra_cfgs]
                               + [c for c in cli_configs(extra_cfgs) if c != DESKTOP_HOME]))
    fallback = {str(DESKTOP_HOME): None}
    for c in roots[1:]:
        fallback[str(c)] = cli_account(c)
    recs, hits = scan(roots)
    timeline = signin_timeline()

    def who(ts, sid, ep, root):
        # desktop replies run as whoever is signed into the app; CLI replies as the config folder's account
        if ep == "d":
            return signed_in(timeline, ts) or owner(idx, sid, ts, None)
        if ep == "c":
            return fallback.get(root)
        return owner(idx, sid, ts, fallback.get(root))

    by = {}
    for r in recs:
        by.setdefault(who(r[0], r[1], r[4], r[6]), {"recs": [], "hits": []})["recs"].append(r)
    for h in hits:
        by.setdefault(who(h[0], h[1], h[4], h[5]), {"recs": [], "hits": []})["hits"].append(h)
    official = load(LIMITS) or {}
    plan_of = plans(extra_cfgs)
    cli_of = {}
    for c in cli_configs(extra_cfgs):
        cli_of.setdefault(cli_account(c), c)
    ids = {a["acct"] for a in accts if a["sessions"]} | {k for k in by if k} | set(official)
    rows = []
    for acct in ids:
        b = by.get(acct, {"recs": [], "hits": []})
        h7 = [h for h in b["hits"] if h[2] == "seven_day"]
        w0, w1 = week_window(h7, now)
        spent_week = sum(r[3] for r in b["recs"] if r[0] >= (w0 if w0 else now - WEEK))
        spent_5h = sum(r[3] for r in b["recs"] if r[0] >= now - FIVE_H)
        off = official.get(acct)
        off = off if isinstance(off, dict) and now - off.get("at", 0) < 3 * 86400 else None
        rows_off = official_rows(off)
        cool = [h for h in b["hits"] if h[3] > now]
        cool = max(cool, key=lambda h: h[3]) if cool else None
        full = [r for r in rows_off if (r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now]
        if full and not cool:
            r0 = max(full, key=lambda r: r["resets_at"])
            cool = [0, "", "five_hour" if r0["kind"] == "session" else "seven_day", r0["resets_at"]]
        wk = next((r for r in rows_off if r.get("kind") == "weekly_all" and r.get("resets_at")), None)
        if wk:
            w1 = wk["resets_at"]
        daily = [round(sum(r[3] for r in b["recs"] if now - (i + 1) * 86400 <= r[0] < now - i * 86400), 2)
                 for i in range(6, -1, -1)]
        rows.append({
            "acct": acct, "name": names().get(acct, "") or acct[:8], "plan": plan_of.get(acct, ""),
            "cli": cli_command(cli_of[acct]) if acct in cli_of else "",
            "cli_rc": rc_command(cli_of[acct]) if acct in cli_of else "",
            "cfg": str(cli_of[acct]) if acct in cli_of else "",
            "cool": {"kind": cool[2], "until": cool[3]} if cool else None,
            "week_usd": spent_week, "five_usd": spent_5h, "week_reset": w1, "daily": daily,
            "official": {"at": off["at"], "rows": rows_off} if off and rows_off else None,
            "last": max((r[0] for r in b["recs"]), default=0)})
    unmapped = by.get(None)
    rows.sort(key=lambda r: r["last"], reverse=True)
    free = [r for r in rows if not r["cool"]]
    pick = min(free, key=rank_key) if free else None
    first_back = min(rows, key=lambda r: r["cool"]["until"]) if rows and not free else None
    return {"now": now, "rows": rows, "pick": pick, "first_back": first_back, "heat": heat_data(by, rows, now),
            "unmapped_usd": sum(r[3] for r in unmapped["recs"] if r[0] >= now - WEEK) if unmapped else 0}


def demo_report(now=None):
    """Sample accounts for `panel --demo`, the same every time; nothing is read from this computer."""
    import math
    import random
    now = now or time.time()
    rnd, h, d = random.Random(7), 3600, 86400
    week = [{"kind": "weekly_all", "percent": 41, "resets_at": now + 4.4 * d}]
    samples = [("work", "Max 20x", week + [{"kind": "weekly_scoped", "scope": "Opus", "percent": 12, "resets_at": now + 4.4 * d},
                                           {"kind": "session", "percent": 100, "resets_at": now + 2.2 * h}], [6, 9, 4, 12, 8, 14, 11], .5),
               ("personal", "Max 5x", [{"kind": "weekly_all", "percent": 23, "resets_at": now + 1.6 * d},
                                       {"kind": "session", "percent": 8, "resets_at": now + 3.1 * h}], [2, 3, 1, 0, 4, 2, 1], .15),
               ("team", "Pro", [{"kind": "weekly_all", "percent": 86, "resets_at": now + 0.7 * d},
                                {"kind": "session", "percent": 34, "resets_at": now + 1.4 * h}], [3, 5, 7, 6, 8, 9, 7], .3),
               ("side", "Max 5x", [], [0, 1, 0, 2, 1, 0, 3], .05)]
    rows = []
    for name, plan, off, daily, _ in samples:
        cfg = HOME / f".claude-{name}"
        rows.append({"acct": "demo-" + name, "name": name, "plan": plan, "cli": cli_command(cfg), "cli_rc": env_cmd(cfg, "claude --remote-control " + name), "cfg": "",
                     "cool": {"kind": "five_hour", "until": now + 2.2 * h} if name == "work" else None,
                     "week_usd": float(sum(daily)), "five_usd": float(daily[-1]) / 3, "week_reset": now + 4.4 * d,
                     "daily": [float(x) for x in daily], "official": {"at": now - 180, "rows": off} if off else None, "last": now})
    start = datetime.fromtimestamp(now).date().toordinal() - HEAT_DAYS + 1
    cal, hours, proj = {r["acct"]: [] for r in rows}, {r["acct"]: [0.0] * 168 for r in rows}, []
    for i in range(HEAT_DAYS):
        wd = datetime.fromordinal(start + i).weekday()
        base = 0 if rnd.random() < (.45 if wd >= 5 else .12) else (7 if wd >= 5 else 19) * (.5 + i / HEAT_DAYS) * math.exp(rnd.random() - .5)
        day = {}
        for r, (_, _, _, _, share) in zip(rows, samples):
            v = round(base * share * (.6 + rnd.random() * .8), 2)
            cal[r["acct"]].append(v)
            for pname, cut in (("shop", .55), ("blog", .3), ("notes", .15)):
                if v:
                    day.setdefault(pname, {})[r["acct"]] = round(v * cut, 2)
        proj.append(day)
    for r, (_, _, _, _, share) in zip(rows, samples):
        for i in range(168):
            wd, hr = divmod(i, 24)
            busy = 1.2 if 14 <= hr < 19 else 1 if 10 <= hr < 12 else .9 if hr >= 21 or hr < 1 else .5 if 9 <= hr < 21 else .05
            hours[r["acct"]][i] = round(busy * (.4 if wd >= 5 else 1) * share * 2.2 * (.6 + rnd.random() * .8), 3)
    heat = {"start": datetime.fromordinal(start).strftime("%Y-%m-%d"), "accts": [{"k": r["acct"], "name": r["name"]} for r in rows],
            "cal": cal, "hours": hours, "proj": proj}
    return {"now": now, "rows": rows, "pick": rows[1], "first_back": None, "heat": heat, "unmapped_usd": 0}


def heat_data(by, rows, now):
    """The heatmap: use per account per day over HEAT_DAYS, the average use per hour of the week, and the projects
    behind each day. Accounts are keyed by id; '' holds CLI use no account could be matched to."""
    end = datetime.fromtimestamp(now).date().toordinal()
    start = end - HEAT_DAYS + 1
    keys = [r["acct"] for r in rows] + ([""] if by.get(None) else [])
    cal = {k: [0.0] * HEAT_DAYS for k in keys}
    hours = {k: [0.0] * 168 for k in keys}
    proj = [{} for _ in range(HEAT_DAYS)]
    first = HEAT_DAYS
    for acct, b in by.items():
        k = acct or ""
        for r in b["recs"] if k in cal else ():
            lt = datetime.fromtimestamp(r[0])
            i = lt.date().toordinal() - start
            if not 0 <= i < HEAT_DAYS:
                continue
            first = min(first, i)
            cal[k][i] += r[3]
            hours[k][lt.weekday() * 24 + lt.hour] += r[3]
            p = proj[i].setdefault(r[5] or "?", {})
            p[k] = p.get(k, 0) + r[3]
    weeks = max(1, (HEAT_DAYS - first) / 7)  # average over the weeks that have data, not the whole window
    top = lambda d: dict(sorted(d.items(), key=lambda x: -sum(x[1].values()))[:8])
    nm = {r["acct"]: r["name"] for r in rows}
    return {"start": datetime.fromordinal(start).strftime("%Y-%m-%d"),
            "accts": [{"k": k, "name": nm.get(k) or t("u_cli_head")} for k in keys],
            "cal": {k: [round(v, 2) for v in vs] for k, vs in cal.items()},
            "hours": {k: [round(v / weeks, 3) for v in vs] for k, vs in hours.items()},
            "proj": [{p: {k: round(v, 2) for k, v in d.items()} for p, d in top(day).items()} for day in proj]}


def rank_key(r):
    """Most quota left this week: (100 - weekly %) x plan size (Pro = 1, Max 5x / 20x scale the same plan);
    accounts without an official % come after, least used first."""
    pct = next((x["percent"] for x in (r["official"] or {}).get("rows", []) if x.get("kind") == "weekly_all"), None)
    m = re.search(r"(\d+)x", r["plan"])
    return (pct is None, -(100 - (pct or 0)) * (int(m.group(1)) if m else 1), r["week_usd"])


def row_text(r, now):
    parts = []
    off = r["official"]
    if off:
        parts.append(t("u_official", rows=rows_text(off["rows"]), a=ago(now - off["at"])))
    parts.append(t("u_spent", k=t("u_week") if r["week_reset"] else t("u_7d"), d=r["week_usd"]))
    parts.append(t("u_spent", k=t("u_5h"), d=r["five_usd"]))
    if r["week_reset"]:
        parts.append(t("u_reset", w=clock(r["week_reset"])))
    if r["cool"]:
        k = t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h")
        return t("u_cool", k=k, w=clock(r["cool"]["until"])) + " · " + " · ".join(parts)
    return t("u_ok") + "  " + " · ".join(parts)


