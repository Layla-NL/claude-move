def cli_configs(extra=()):
    """CLI config folders that have been signed in: ~/.claude-*, any passed with --config, then ~/.claude. A folder
    made for one account comes before ~/.claude, whose cached profile can outlive its login."""
    found = sorted(p for p in HOME.glob(".claude-*") if p.is_dir())
    found += [Path(os.path.expanduser(c)) for c in extra] + [HOME / ".claude"]
    out = []
    for c in found:
        if c not in out and cli_account(c):
            out.append(c)
    return out


def parse_reset(text, tz):
    """'Oct 27 at 10am', '3pm', '3:30pm' in the given IANA zone -> epoch seconds (next occurrence)."""
    try:
        from zoneinfo import ZoneInfo
        zone = ZoneInfo(tz) if tz else None
    except Exception:
        zone = None
    m = re.match(r"(?:([A-Z][a-z]{2}) (\d{1,2})(?: at )?)?\s*(\d{1,2})(?::(\d\d))?\s*([ap]m)$", text.strip(), re.I)
    if not m:
        return None
    mon, day, hour, minute, ap = m.groups()
    hour = int(hour) % 12 + (12 if ap.lower() == "pm" else 0)
    now = datetime.now(zone) if zone else datetime.now()
    try:
        if mon:
            month = datetime.strptime(mon, "%b").month
            when = now.replace(month=month, day=int(day), hour=hour, minute=int(minute or 0), second=0, microsecond=0)
            if when.timestamp() < now.timestamp() - 86400 * 180:
                when = when.replace(year=when.year + 1)
        else:
            when = now.replace(hour=hour, minute=int(minute or 0), second=0, microsecond=0)
            if when.timestamp() < now.timestamp():
                when = datetime.fromtimestamp(when.timestamp() + 86400, when.tzinfo)
    except ValueError:
        return None
    return when.timestamp()


def parse_usage_text(text):
    """Fallback when the structured report has no rows: the /usage text says the same thing, e.g.
    'Current week (all models): 96% used · resets Oct 27 at 10am (Asia/Singapore)'."""
    rows = []
    for line in text.splitlines():
        m = re.match(r"\s*Current (session|week)(?: \((.+?)\))?:\s*(\d+(?:\.\d+)?)% used(?:\s*·\s*resets (.+?)(?: \(([^)]+)\))?)?\s*$", line)
        if not m:
            continue
        kind, scope, pct, when, tz = m.groups()
        if kind == "session":
            k = "session"
        else:
            k = "weekly_all" if (scope or "").lower() in ("", "all models") else "weekly_scoped"
        rows.append({"kind": k, "percent": float(pct), "resets_at": parse_reset(when, tz) if when else None,
                     "scope": scope if k == "weekly_scoped" else None})
    return rows


def parse_usage_report(stdout):
    """Rows of the `usage_report` that `claude -p /usage --output-format stream-json` attaches to its reply."""
    for line in stdout.splitlines():
        try:
            m = json.loads(line)
        except ValueError:
            continue
        rep_ = m.get("usage_report") if isinstance(m, dict) else None
        if rep_ is None and isinstance(m, dict) and isinstance(m.get("message"), dict):
            rep_ = m["message"].get("usage_report")
        if not isinstance(rep_, dict):
            continue
        limits = ((rep_.get("rate_limits") or {}).get("limits")) or []
        if not limits:
            text = " ".join(c.get("text", "") for c in ((m.get("message") or {}).get("content") or []) if isinstance(c, dict))
            return parse_usage_text(text) or None
        rows = []
        for r in limits:
            if not isinstance(r, dict) or r.get("percent") is None:
                continue
            scope = ((r.get("scope") or {}).get("model") or {}).get("display_name") if isinstance(r.get("scope"), dict) else None
            rows.append({"kind": r.get("kind") or "", "percent": r["percent"],
                         "resets_at": iso_ts(r["resets_at"]) if r.get("resets_at") else None, "scope": scope})
        return rows
    return None


def refresh_official(extra=()):
    """Run the official `/usage` command once per signed-in CLI config folder. It is a local command: no model call,
    no quota used. claude-move only runs the CLI; the CLI uses its own login."""
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude")
    if not exe:
        print(t("r_noclaude"))
        return
    cfgs = cli_configs(extra)
    if not cfgs:
        print(t("r_none"))
        return
    print(t("r_scan"))
    cur = load(LIMITS) or {}
    for c in cfgs:
        env = dict(os.environ)
        if c == HOME / ".claude":
            env.pop("CLAUDE_CONFIG_DIR", None)
        else:
            env["CLAUDE_CONFIG_DIR"] = str(c)
        shown = "~/" + str(c.relative_to(HOME)) if str(c).startswith(str(HOME)) else str(c)
        try:
            r = subprocess.run([exe, "-p", "/usage", "--output-format", "stream-json", "--verbose", "--no-session-persistence"],
                               capture_output=True, text=True, env=env, timeout=90, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as e:
            print(t("r_fail", d=shown, e=e))
            continue
        rows = parse_usage_report(r.stdout)
        if not rows:  # signed out, or signed in with an API key: /usage then reports cost only
            print(t("r_fail", d=shown, e=t("r_nologin", d=shown)))
            continue
        acct = cli_account(c)
        rows = official_rows({"rows": rows})
        cur[acct] = {"at": time.time(), "src": "usage", "rows": rows}
        print(t("r_ok", d=shown, a=names().get(acct, acct[:8]), rows=rows_text(rows)))
    CONF.mkdir(parents=True, exist_ok=True)
    LIMITS.write_text(json.dumps(cur, indent=2) + "\n")


def usage_report(extra_cfgs=(), now=None):
    now = now or time.time()
    accts = accounts()
    idx = owner_index(accts)
    roots = [DESKTOP_HOME] + [Path(os.path.expanduser(c)) for c in extra_cfgs]
    fallback = {str(DESKTOP_HOME): None}
    for c in roots[1:]:
        fallback[str(c)] = cli_account(c)
    recs, hits = scan(roots)
    timeline = signin_timeline()

    def who(ts, sid, ep, root):
        # desktop replies run as whoever is signed into the app; CLI replies as the config folder's account
        if ep == "d":
            return signed_in(timeline, ts) or owner(idx, sid, ts, None)
        if ep == "c":
            return fallback.get(root)
        return owner(idx, sid, ts, fallback.get(root))

    by = {}
    for r in recs:
        by.setdefault(who(r[0], r[1], r[4], r[5]), {"recs": [], "hits": []})["recs"].append(r)
    for h in hits:
        by.setdefault(who(h[0], h[1], h[4], h[5]), {"recs": [], "hits": []})["hits"].append(h)
    official = load(LIMITS) or {}
    plan_of = plans(extra_cfgs)
    cli_of = {}
    for c in cli_configs(extra_cfgs):
        cli_of.setdefault(cli_account(c), c)
    ids = {a["acct"] for a in accts if a["sessions"]} | {k for k in by if k} | set(official)
    rows = []
    for acct in ids:
        b = by.get(acct, {"recs": [], "hits": []})
        h7 = [h for h in b["hits"] if h[2] == "seven_day"]
        w0, w1 = week_window(h7, now)
        spent_week = sum(r[3] for r in b["recs"] if r[0] >= (w0 if w0 else now - WEEK))
        spent_5h = sum(r[3] for r in b["recs"] if r[0] >= now - FIVE_H)
        off = official.get(acct)
        off = off if isinstance(off, dict) and now - off.get("at", 0) < 3 * 86400 else None
        rows_off = official_rows(off)
        cool = [h for h in b["hits"] if h[3] > now]
        cool = max(cool, key=lambda h: h[3]) if cool else None
        full = [r for r in rows_off if (r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now]
        if full and not cool:
            r0 = max(full, key=lambda r: r["resets_at"])
            cool = [0, "", "five_hour" if r0["kind"] == "session" else "seven_day", r0["resets_at"]]
        wk = next((r for r in rows_off if r.get("kind") == "weekly_all" and r.get("resets_at")), None)
        if wk:
            w1 = wk["resets_at"]
        daily = [round(sum(r[3] for r in b["recs"] if now - (i + 1) * 86400 <= r[0] < now - i * 86400), 2)
                 for i in range(6, -1, -1)]
        rows.append({
            "acct": acct, "name": names().get(acct, "") or acct[:8], "plan": plan_of.get(acct, ""),
            "cli": cli_command(cli_of[acct]) if acct in cli_of else "",
            "cool": {"kind": cool[2], "until": cool[3]} if cool else None,
            "week_usd": spent_week, "five_usd": spent_5h, "week_reset": w1, "daily": daily,
            "official": {"at": off["at"], "rows": rows_off} if off and rows_off else None,
            "last": max((r[0] for r in b["recs"]), default=0)})
    unmapped = by.get(None)
    rows.sort(key=lambda r: r["last"], reverse=True)
    free = [r for r in rows if not r["cool"]]
    pct = lambda r: next((x["percent"] for x in (r["official"] or {}).get("rows", []) if x.get("kind") == "weekly_all"), None)
    def mult(r):  # Pro = 1; Max 5x / 20x scale the same plan
        m = re.search(r"(\d+)x", r["plan"])
        return int(m.group(1)) if m else 1

    # most quota left this week: (100 - weekly %) x plan size; accounts without official % fall back to least used
    pick = min(free, key=lambda r: (pct(r) is None, -(100 - (pct(r) or 0)) * mult(r), r["week_usd"])) if free else None
    first_back = min(rows, key=lambda r: r["cool"]["until"]) if rows and not free else None
    return {"now": now, "rows": rows, "pick": pick, "first_back": first_back,
            "unmapped_usd": sum(r[3] for r in unmapped["recs"] if r[0] >= now - WEEK) if unmapped else 0}


def row_text(r, now):
    parts = []
    off = r["official"]
    if off:
        parts.append(t("u_official", rows=rows_text(off["rows"]), a=ago(now - off["at"])))
    parts.append(t("u_spent", k=t("u_week") if r["week_reset"] else t("u_7d"), d=r["week_usd"]))
    parts.append(t("u_spent", k=t("u_5h"), d=r["five_usd"]))
    if r["week_reset"]:
        parts.append(t("u_reset", w=clock(r["week_reset"])))
    if r["cool"]:
        k = t("u_kind_week") if r["cool"]["kind"] == "seven_day" else t("u_kind_5h")
        return t("u_cool", k=k, w=clock(r["cool"]["until"])) + " · " + " · ".join(parts)
    return t("u_ok") + "  " + " · ".join(parts)


def cmd_usage(args):
    if args.refresh:
        refresh_official(args.config or ())
        print()
    print(t("u_scan"), file=sys.stderr)
    rep = usage_report(args.config or ())
    print(t("u_title"))
    for r in rep["rows"]:
        print(f"{r['name']:10} {r['plan'] or '-':8} {row_text(r, rep['now'])}")
    if rep["unmapped_usd"] >= 1:
        print(f"{'-':10} {t('u_unmapped')}: " + t("u_spent", k=t("u_7d"), d=rep["unmapped_usd"]))
    if rep["pick"]:
        print(t("u_pick", a=rep["pick"]["name"]))
    elif rep["first_back"]:
        print(t("u_pick_none", a=rep["first_back"]["name"], w=clock(rep["first_back"]["cool"]["until"])))
