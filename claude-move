SNAP_CONF = CONF / "snapshot.json"
AGENT = "com.github.layla-nl.claude-move.quota-snapshot"
AGENTS = Path(os.environ.get("CLAUDE_MOVE_AGENTS") or str(HOME / "Library/LaunchAgents"))
WIN_TASK = "claude-move quota snapshot"
STALE_AFTER = 60  # minutes without new official numbers, /usage failing, before firstmate stops getting the old ones
OTHERS_EVERY = 3600  # the other logins' /usage, for the switch hint, at most this often


def is_firstmate(home):
    return (home / "bin" / "fm-spawn.sh").is_file()


def fm_pin_file(home=None):
    return (home or FM_HOME) / "config" / "claude-account"


def fm_pin(home=None):
    """firstmate's Claude worker pin as (CLI config folder, None); (None, None) when there is none; (None, error)."""
    f = fm_pin_file(home)
    try:
        body = f.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None, None
    except (OSError, UnicodeDecodeError):
        return None, t("qs_badpin", f=short(f))
    m = re.fullmatch(r"(ordinary|[^\x00-\x1f\x7f]+)\n?", body)  # firstmate's own rule, with this system's absolute paths
    if not m or (m.group(1) != "ordinary" and not os.path.isabs(m.group(1))):
        return None, t("qs_badpin", f=short(f))
    return (HOME / ".claude" if m.group(1) == "ordinary" else Path(m.group(1))), None


def crew_acct():
    cfg, _ = fm_pin()
    return cli_account(cfg) if cfg else None


def iso_utc(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def quota_windows(rows):
    """Official rows as quota-axi's Claude windows, with the ids its own Claude reader gives them."""
    out = []
    for r in rows:
        if r.get("percent") is None:
            continue
        kind = r.get("kind")
        if kind == "session":
            w, secs = {"id": "five_hour", "label": "session", "kind": "session"}, FIVE_H
        elif kind == "weekly_all":
            w, secs = {"id": "seven_day", "label": "week", "kind": "weekly"}, WEEK
        elif kind == "weekly_scoped" and r.get("scope"):
            key = r.get("model") or re.sub(r"[^a-z0-9]+", "_", r["scope"].strip().lower()).strip("_")
            w, secs = {"id": f"model:{key}", "label": f'{r["scope"]} week', "kind": "model"}, WEEK
        else:
            continue
        num = lambda x: int(x) if x == int(x) else round(x, 2)
        p = max(0.0, min(100.0, float(r["percent"])))
        w.update(percentUsed=num(p), percentRemaining=num(100 - p))
        if r.get("resets_at"):
            w["resetsAt"] = iso_utc(r["resets_at"])
        w["windowSeconds"] = secs
        out.append(w)
    order = {"five_hour": 0, "seven_day": 1}
    return sorted(out, key=lambda w: order.get(w["id"], 2))


def snapshot_payload(rows, at):
    """quota-axi's cache format (schema 3): one keyless Claude row, the one firstmate binds its Claude crews to."""
    return {"schemaVersion": 3, "providers": [{
        "provider": "claude", "label": "Claude", "source": "cli", "windows": quota_windows(rows),
        "state": {"status": "fresh", "stale": False, "sourcesTried": ["cli"], "refreshedAt": iso_utc(at)}}]}


def read_snapshot(path):
    """(refreshedAt as epoch seconds, windows) of a snapshot file, or (None, [])."""
    try:
        p = load(path)["providers"][0]
        return iso_ts(p["state"]["refreshedAt"]), p.get("windows") or []
    except (TypeError, KeyError, IndexError):
        return None, []


def windows_text(ws):
    lab = lambda w: {"five_hour": t("u_5h"), "seven_day": t("u_week")}.get(w["id"]) or row_label(
        {"kind": "weekly_scoped", "scope": re.sub(r" week$", "", w.get("label", ""))})
    return " · ".join(t("u_pct", k=lab(w), p=round(w.get("percentUsed") or 0)) for w in ws)


def write_private(path, text):
    """Write to a temporary file readable only by this user, then rename it over path."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(str(tmp), 0o600)
    os.replace(str(tmp), str(path))


def snap_log(line):
    """One line in ~/.cache/claude-move/quota-snapshot.log, which keeps its last 1000 lines."""
    try:
        old = SNAP_LOG.read_text(encoding="utf-8").splitlines()[-999:] if SNAP_LOG.exists() else []
        SNAP_LOG.parent.mkdir(parents=True, exist_ok=True)
        SNAP_LOG.write_text("\n".join(old + [time.strftime("%Y-%m-%d %H:%M:%S ") + line]) + "\n", encoding="utf-8")
    except OSError:
        pass


def snapshot_out():
    return Path((load(SNAP_CONF) or {}).get("out") or SNAPSHOT)


def write_snapshot(cfg, out, refresh=False, stale_after=STALE_AFTER):
    """Write one CLI login's official numbers where quota-axi reads them (QUOTA_AXI_SNAPSHOT); (ok, message).
    Nothing is made up: without official numbers the old file stays. When they are stale_after minutes old and
    /usage keeps failing, the file is moved aside, so firstmate sees no Claude quota rather than old quota."""
    acct = cli_account(cfg)
    if not acct:
        return False, t("qs_nologin", d=short(cfg))
    who = names().get(acct, acct[:8])
    err = None
    if refresh:
        try:
            if refresh_one(cfg) is None:
                err = t("qs_noreply", d=short(cfg))
        except (OSError, subprocess.SubprocessError) as e:
            err = t("qs_fail", d=short(cfg), e=e)
    rec = (load(LIMITS) or {}).get(acct)
    rows = official_rows(rec)
    at = rec.get("at", 0) if isinstance(rec, dict) else 0
    ws = quota_windows(rows)
    old_at, _ = read_snapshot(out)
    conf = load(SNAP_CONF) or {}
    # after a failed /usage, numbers the status line saved since the file was written still count, if they are recent
    if ws and (not err or (at > (old_at or 0) + 1 and time.time() - at < stale_after * 60)):
        write_private(out, json.dumps(snapshot_payload(rows, at), indent=2) + "\n")
        conf.update(acct=acct, out=str(out), at=at)
        save_json(SNAP_CONF, conf)
        pct = {w["id"]: w["percentUsed"] for w in ws}
        snap_log(f'{who} ({acct[:8]}) five_hour={pct.get("five_hour", "-")}% seven_day={pct.get("seven_day", "-")}% '
                 f'refreshedAt={iso_utc(at)}' + (f" · {err}" if err else ""))
        msg = t("qs_wrote", p=short(out), a=who, w=windows_text(ws), t=clock(at))
        return True, (err + "\n" + msg) if err else msg
    msg = t("qs_kept", p=short(out)) if ws else t("qs_none", a=who, p=short(out))
    msg = (err + "\n" + msg) if err else msg
    newest = max(at, old_at or 0)
    if refresh and err and out.exists() and newest and time.time() - newest > stale_after * 60:
        aside = out.with_name(out.name + ".stale")
        os.replace(str(out), str(aside))
        gone = t("qs_retired", a=who, m=round((time.time() - newest) / 60), p=short(aside))
        notify(t("n_title"), gone)
        msg += "\n" + gone
    snap_log("not written: " + msg.replace("\n", " · "))
    return False, msg


def refresh_others(skip, extra=()):
    """Ask the other CLI logins' /usage, each at most once an hour, so the switch hint has numbers to go on."""
    lim = load(LIMITS) or {}
    seen = {skip}
    for c in cli_configs(extra):
        a = cli_account(c)
        if a in seen:
            continue
        seen.add(a)
        rec = lim.get(a)
        if isinstance(rec, dict) and time.time() - rec.get("at", 0) < OTHERS_EVERY:
            continue
        try:
            refresh_one(c)
        except (OSError, subprocess.SubprocessError):
            pass


def switch_hint(acct):
    """For the account firstmate's crews use: the CLI login with the most of this week left, from saved numbers."""
    lim = load(LIMITS) or {}
    now = time.time()
    best = None
    for c in cli_configs():
        a = cli_account(c)
        rec = lim.get(a)
        if a == acct or not isinstance(rec, dict) or now - rec.get("at", 0) > 6 * 3600:
            continue
        rows = official_rows(rec)
        if any((r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now for r in rows):
            continue
        wk = next((r["percent"] for r in rows if r.get("kind") == "weekly_all" and r.get("percent") is not None), None)
        if wk is not None and wk < 90 and (best is None or wk < best[1]):
            best = (a, wk)
    return t("n_crew_switch", b=names().get(best[0], best[0][:8]), p=round(100 - best[1])) if best else ""


def launchctl(*a):
    cmd = os.environ.get("CLAUDE_MOVE_LAUNCHCTL")  # tests
    if cmd:
        return subprocess.run(f"{cmd} {' '.join(a)}", shell=True, capture_output=True, text=True)
    return subprocess.run(["launchctl", *a], capture_output=True, text=True)


def snapshot_schedule(on, every=10, out=None):
    """Run `quota-snapshot --refresh` every few minutes: a launchd agent on macOS, a scheduled task on Windows."""
    conf = load(SNAP_CONF) or {}
    script = str(Path(__file__).resolve())
    if sys.platform == "darwin":
        import plistlib
        plist = AGENTS / f"{AGENT}.plist"
        launchctl("bootout", f"gui/{os.getuid()}", str(plist))  # the copy loaded before, if any
        if on:
            env = {"PATH": f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin", "CLAUDE_MOVE_LANG": "zh" if ZH else "en"}
            exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude")
            if exe:
                env["CLAUDE_MOVE_CLAUDE"] = exe
            for k in ("CLAUDE_MOVE_HOME", "CLAUDE_MOVE_FM_HOME", "CLAUDE_MOVE_SNAPSHOT"):
                if os.environ.get(k):
                    env[k] = os.environ[k]
            AGENTS.mkdir(parents=True, exist_ok=True)
            plist.write_bytes(plistlib.dumps({
                "Label": AGENT, "ProgramArguments": ["/usr/bin/python3" if Path("/usr/bin/python3").exists() else sys.executable,
                                                     script, "quota-snapshot", "--refresh"]
                + (["--out", str(out)] if out else []),
                "StartInterval": int(every * 60), "RunAtLoad": True, "ProcessType": "Background", "LowPriorityIO": True,
                "EnvironmentVariables": env, "StandardOutPath": str(SNAP_LOG.with_suffix(".out")),
                "StandardErrorPath": str(SNAP_LOG.with_suffix(".out"))}))
            r = launchctl("bootstrap", f"gui/{os.getuid()}", str(plist))
            if r.returncode:
                return False, t("qs_sched_fail", e=(r.stderr or r.stdout).strip())
        elif plist.exists():
            plist.unlink()
    elif WIN:
        if on:
            pyw = Path(sys.executable).with_name("pythonw.exe")
            run = f'"{pyw if pyw.exists() else sys.executable}" "{script}" quota-snapshot --refresh' + (f' --out "{out}"' if out else "")
            r = subprocess.run(["schtasks", "/Create", "/F", "/SC", "MINUTE", "/MO", str(int(every)), "/TN", WIN_TASK, "/TR", run],
                               capture_output=True, text=True, creationflags=NO_WINDOW)
            if r.returncode:
                return False, t("qs_sched_fail", e=(r.stderr or r.stdout).strip())
        else:
            subprocess.run(["schtasks", "/Delete", "/F", "/TN", WIN_TASK], capture_output=True, creationflags=NO_WINDOW)
    else:
        return False, t("qs_sched_none")
    conf.update(sched=on, every=int(every))
    if out:
        conf["out"] = str(out)
    save_json(SNAP_CONF, conf)
    if not on:
        return True, t("qs_sched_off")
    return True, t("qs_sched_on_win" if WIN else "qs_sched_on", n=int(every), p=short(SNAP_LOG))


def crew_lines(home=None):
    """What firstmate's crews use, the snapshot, its refresh and the recorder, one line each."""
    home = home or FM_HOME
    out = [] if is_firstmate(home) else [t("qs_st_nofm", d=short(home))]
    cfg, err = fm_pin(home)
    f = short(fm_pin_file(home))
    if err:
        out.append(err)
    elif cfg:
        a = cli_account(cfg) or "?"
        out.append(t("qs_st_pin", a=names().get(a, a[:8]), d=short(cfg), f=f))
    else:
        out.append(t("qs_st_nopin", f=f))
    conf = load(SNAP_CONF) or {}
    p = snapshot_out()
    at, ws = read_snapshot(p)
    if at:
        a = conf.get("acct") or "?"
        out.append(t("qs_st_file", p=short(p), a=names().get(a, a[:8]), w=windows_text(ws), t=ago(time.time() - at)))
    else:
        out.append(t("qs_st_nofile", p=short(p)))
    out.append(t("qs_st_sched", n=conf.get("every", 10)) if conf.get("sched") else t("qs_st_nosched"))
    if cfg:
        out.append(t("qs_st_rec", d=short(recorder_path(cfg)), s=t("qs_on") if recorder_on(cfg) else t("qs_off")))
    return out


def crew_accounts(extra=()):
    """Every CLI login with its saved official numbers, for choosing which one firstmate's crews use."""
    lim = load(LIMITS) or {}
    pinned = crew_acct()
    now = time.time()
    out, seen = [], set()
    for c in cli_configs(extra):
        a = cli_account(c)
        if a in seen:
            continue
        seen.add(a)
        rec = lim.get(a)
        rows = official_rows(rec)
        cool = any((r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now for r in rows)
        wk = next((r["percent"] for r in rows if r.get("kind") == "weekly_all" and r.get("percent") is not None), None)
        text = (rows_text(rows) + " · " + t("u_off_head", a=ago(now - rec["at"]))) if rows else t("fp_noff")
        out.append({"acct": a, "name": names().get(a, a[:8]), "dir": short(c), "text": text, "cool": cool,
                    "left": None if wk is None else round(100 - wk), "pinned": a == pinned})
    return out


def fm_pin_set(cfg, force=False, home=None):
    """Pin firstmate's Claude crews to one CLI login (config/claude-account), then point the snapshot at it."""
    home = home or FM_HOME
    acct = cli_account(cfg)
    who = names().get(acct, acct[:8])
    try:
        rows = refresh_one(cfg)  # proves the folder is signed in, and brings its numbers up to date
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit(t("qs_fail", d=short(cfg), e=e))
    if rows is None:
        sys.exit(t("qs_noreply", d=short(cfg)))
    now = time.time()
    cool = [r.get("resets_at") or 0 for r in rows if (r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now]
    if cool and not force:
        sys.exit(t("fp_cool", a=who, w=clock(max(cool))))
    value = "ordinary" if cfg == HOME / ".claude" else str(cfg)
    cur, _ = fm_pin(home)
    f = fm_pin_file(home)
    if cur is not None and str(cur) == str(cfg):
        print(t("fp_same", a=who))
    else:
        write_private(f, value + "\n")
        snap_log(f"pin {cur if cur is not None else '-'} -> {value}")
        print(t("fp_done", a=who, f=short(f), v=value))
        print(t("fp_note"))
    print(write_snapshot(cfg, snapshot_out())[1])


def cmd_fm_pin(args):
    home = Path(os.path.expanduser(args.home)) if args.home else FM_HOME
    if not is_firstmate(home):
        sys.exit(t("fp_nofm", d=short(home)))
    if not args.account:
        print("\n".join(crew_lines(home)))
        print()
        for a in crew_accounts(args.config or ()):
            print(t("fp_line", m="*" if a["pinned"] else " ", a=a["name"], w=a["text"]))
        print(t("fp_hint"))
        return
    cfg = cli_dir(args.account, args.config or ())
    if not cfg:
        sys.exit(t("fp_noacct", a=args.account, l=", ".join(a["name"] for a in crew_accounts(args.config or ())) or "-"))
    fm_pin_set(cfg, args.force, home)


def cmd_quota_snapshot(args):
    out = Path(os.path.expanduser(args.out)) if args.out else None
    if args.action in ("schedule", "unschedule"):
        ok, msg = snapshot_schedule(args.action == "schedule", args.every, out)
        print(msg)
        if not ok:
            sys.exit(1)
        return
    if args.action == "status":
        print("\n".join(crew_lines()))
        return
    if args.account:
        cfg = cli_dir(args.account, args.config or ())
        err = None if cfg else t("fp_noacct", a=args.account, l=", ".join(a["name"] for a in crew_accounts(args.config or ())) or "-")
    else:
        cfg, err = fm_pin()
        err = err or (None if cfg else t("qs_noacct"))
    if err:
        sys.exit(err)
    ok, msg = write_snapshot(cfg, out or snapshot_out(), args.refresh, args.stale_after)
    if args.refresh:
        refresh_others(cli_account(cfg), args.config or ())
    print(msg)
    if not ok:
        sys.exit(1)


# ---------- run: switch account at a usage limit and go on
def transcript_files(cfg, sid):
    proj = cfg / "projects"
    return list(proj.glob(f"*/{sid}.jsonl")) + list(proj.glob(f"*/{sid}/subagents/*.jsonl"))


def new_limit_hit(cfg, sid, marks):
    """A usage-limit record written to this session's transcripts (subagents included) since the last look."""
    for f in transcript_files(cfg, sid):
        try:
            with open(f, "rb") as fh:
                fh.seek(marks.get(f, 0))
                data = fh.read()
        except OSError:
            continue
        end = data.rfind(b"\n") + 1
        marks[f] = marks.get(f, 0) + end
        for raw in data[:end].splitlines():
            if b"usage_limit_reached" not in raw:
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            info = (rec.get("apiErrorParams") or {}).get("rate_limit_info")
            if rec.get("apiError") == "usage_limit_reached" and isinstance(info, dict):
                return {"kind": info.get("rateLimitType") or "", "until": info.get("resetsAt") or 0}
    return None


def next_account(skip, extra=()):
    """The CLI login with the most quota left that is not cooling. Each candidate is asked its official /usage
    first, which also proves the folder is really signed in."""
    by = {}
    for c in cli_configs(extra):
        by.setdefault(cli_account(c), c)
    rep = usage_report([str(c) for c in by.values() if c != HOME / ".claude"])
    ranked = [r["acct"] for r in sorted(rep["rows"], key=rank_key) if not r["cool"]]
    ranked += [a for a in by if a not in ranked]
    now = time.time()
    for acct in ranked:
        if acct not in by or acct in skip:
            continue
        try:
            rows = refresh_one(by[acct])
        except (OSError, subprocess.SubprocessError):
            continue
        if rows is None or any((r.get("percent") or 0) >= 100 and (r.get("resets_at") or 0) > now for r in rows):
            continue
        return by[acct]
    return None


def copy_session(src_cfg, dst_cfg, sid):
    """Copy the session's transcript and side folder into the other config folder; whatever was there for this
    session is saved first. Returns the backup folder, if one was needed."""
    src = next(iter(src_cfg.glob(f"projects/*/{sid}.jsonl")), None)
    if not src:
        return False
    ddir = dst_cfg / "projects" / src.parent.name
    ddir.mkdir(parents=True, exist_ok=True)
    bk = None
    for name in (src.name, sid):
        d = ddir / name
        if d.exists():
            bk = bk or CONF / "run-backups" / f'{time.strftime("%Y%m%d-%H%M%S")}-{dst_cfg.name.lstrip(".")}'
            bk.mkdir(parents=True, exist_ok=True)
            (shutil.copytree if d.is_dir() else shutil.copy2)(d, bk / name)
    shutil.copy2(src, ddir / src.name)
    side = src.parent / sid
    if side.is_dir():
        shutil.copytree(side, ddir / sid, dirs_exist_ok=True)
    return bk


def restore_tty():
    if sys.stdin.isatty():
        if not WIN:
            subprocess.run(["stty", "sane"], check=False)
        sys.stderr.write("\033[?25h\n")


def stop_child(child):
    """End claude so its transcript can be copied. On Windows the whole tree: an npm install runs it under a .cmd."""
    if WIN:
        subprocess.run(["taskkill", "/T", "/F", "/PID", str(child.pid)], capture_output=True)
    else:
        child.terminate()
    try:
        child.wait(timeout=10)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()


def cmd_run(args):
    """Run Claude Code with one account's CLI login. When the session hits a usage limit, stop it, copy it into the
    CLI login with the most left and resume it there with a note to continue. Logins are never read or changed."""
    import signal
    import uuid
    exe = os.environ.get("CLAUDE_MOVE_CLAUDE") or shutil.which("claude")
    if not exe:
        sys.exit(t("r_noclaude"))
    cfg = cli_dir(args.account.strip(), args.config or ())
    if not cfg:
        sys.exit(t("t_none", t=args.account))
    sid, resume, prompt = args.resume or str(uuid.uuid4()), bool(args.resume), None
    poll = float(os.environ.get("CLAUDE_MOVE_POLL") or 2)
    skip = {}  # accounts that hit a limit in this run -> when they are back
    runf = RUNS / f"{sid}.json"
    run = {"sid": sid, "pid": os.getpid(), "cwd": os.getcwd(), "started": time.time(), "acct": cli_account(cfg),
           "cfg": str(cfg), "switches": [], "ended": None}
    save_json(runf, run)

    def finish(code):
        run["ended"] = time.time()
        save_json(runf, run)
        sys.exit(code)

    signal.signal(signal.SIGINT, lambda *a: None)  # Ctrl-C is for claude; caught signals reset to default in the child
    while True:
        acct = cli_account(cfg)
        cmd = [exe] + (["--resume", sid] if resume else ["--session-id", sid])
        cmd += (["--remote-control", rc_name(acct)] if args.rc else []) + list(args.claude_args or [])
        cmd += [prompt] if prompt else []
        env = dict(os.environ)
        if cfg == HOME / ".claude":
            env.pop("CLAUDE_CONFIG_DIR", None)
        else:
            env["CLAUDE_CONFIG_DIR"] = str(cfg)
        print(t("run_on", a=names().get(acct, acct[:8]), c=cli_command(cfg)), file=sys.stderr)
        marks = {}
        for f in transcript_files(cfg, sid):  # only what is written from now on counts
            try:
                marks[f] = f.stat().st_size
            except OSError:
                pass
        child = subprocess.Popen(cmd, env=env)
        hit = None
        while child.poll() is None and not hit:
            time.sleep(poll)
            hit = new_limit_hit(cfg, sid, marks)
        if not hit:
            restore_tty()
            finish(child.returncode if child.returncode >= 0 else 1)
        now = time.time()
        skip[acct] = hit["until"] or now + FIVE_H
        skip = {a: u for a, u in skip.items() if u > now}
        nxt = next_account(skip, args.config or ())
        who = names().get(acct, acct[:8])
        if not nxt:  # leave claude as it is; the user can wait for the reset in it
            notify(t("n_title"), t("n_none", a=who))
            child.wait()
            restore_tty()
            print(t("run_none", a=who), file=sys.stderr)
            finish(child.returncode if child.returncode >= 0 else 1)
        stop_child(child)
        restore_tty()
        k = t("u_kind_week") if hit["kind"] == "seven_day" else t("u_kind_5h")
        print(t("run_hit", a=who, k=k, w=clock(skip[acct])), file=sys.stderr)
        nb = names().get(cli_account(nxt), cli_account(nxt)[:8])
        print(t("run_switch", b=nb), file=sys.stderr)
        bk = copy_session(cfg, nxt, sid)
        if bk is False:
            finish(t("run_lost", d=short(cfg)))
        if bk:
            print(t("run_backup", b=nb, p=bk), file=sys.stderr)
        notify(t("n_title"), t("n_switch", a=who, b=nb))
        run["switches"].append({"at": time.time(), "from": acct, "to": cli_account(nxt), "kind": hit["kind"]})
        run.update(acct=cli_account(nxt), cfg=str(nxt))
        save_json(runf, run)
        cfg, resume, prompt = nxt, True, t("run_prompt")


# ---------- terminal sessions: search every CLI login's transcripts, the running ones, tmux
INDEX = Path(os.environ.get("CLAUDE_MOVE_INDEX") or str(HOME / ".cache/claude-move/search.db"))
INDEX_VERSION = 1
WANTED = re.compile(rb'"type": ?"(?:user|assistant|custom-title|ai-title)"')
TMUX_CONF = HOME / ".tmux.conf"
TMUX_MARK = ("# >>> claude-move", "# <<< claude-move")
LABELS = CONF / "labels.json"
PINS = CONF / "pins.json"
LAST_MOVE = CONF / "last-move.json"


def labels():
    """session id -> the name the user gave it in claude-move. Kept by claude-move only: transcripts, Claude Code's
    own session names and tmux windows other tools named stay as they are."""
    d = load(LABELS)
    return {k: v for k, v in d.items() if isinstance(v, str) and v} if isinstance(d, dict) else {}


def save_labels(d):
    LABELS.parent.mkdir(parents=True, exist_ok=True)
    LABELS.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def pins():
    """Session ids the user pinned to the top of the running list, oldest pin first."""
    d = load(PINS)
    return [x for x in d if isinstance(x, str) and x] if isinstance(d, list) else []


def set_pin(sid, on):
    p = [x for x in pins() if x != sid] + [sid] * bool(on)
    PINS.parent.mkdir(parents=True, exist_ok=True)
    PINS.write_text(json.dumps(p, indent=2) + "\n", encoding="utf-8")


def said(rec):
    """What a person typed or read in one transcript record: prompts and Claude's replies, not tool output,
    attachments or the CLI's own <wrapped> notes."""
    c = (rec.get("message") or {}).get("content")
    if rec.get("type") == "user" and isinstance(c, str):
        parts = [c]
    elif isinstance(c, list):
        parts = [x.get("text") or "" for x in c if isinstance(x, dict) and x.get("type") == "text"]
    else:
        parts = []
    if rec.get("type") == "user":
        parts = [] if rec.get("isMeta") else [p for p in parts if not p.lstrip().startswith("<")]
    return "\n".join(p.strip() for p in parts if p.strip())


def index_db():
    """The search index: the said() text of every CLI transcript, kept beside the cache, readable by this user only."""
    import sqlite3
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(str(INDEX), timeout=60)
    try:
        os.chmod(INDEX, 0o600)
    except OSError:
        pass
    db.execute("PRAGMA busy_timeout=10000")
    db.execute("PRAGMA journal_mode=WAL")  # searches read while the panel's first build writes
    if db.execute("PRAGMA user_version").fetchone()[0] != INDEX_VERSION:
        db.execute("BEGIN IMMEDIATE")
        if db.execute("PRAGMA user_version").fetchone()[0] != INDEX_VERSION:  # nobody else made it meanwhile
            for sql in ("DROP TABLE IF EXISTS files", "DROP TABLE IF EXISTS msgs",
                        "CREATE TABLE files(path TEXT PRIMARY KEY, cfg TEXT, sid TEXT, cwd TEXT, title TEXT, ai TEXT, "
                        "first TEXT, off INTEGER, ino INTEGER, mtime REAL)",
                        "CREATE TABLE msgs(path TEXT, ts REAL, role TEXT, text TEXT)", "CREATE INDEX msgs_path ON msgs(path)",
                        f"PRAGMA user_version = {INDEX_VERSION}"):
                db.execute(sql)
        db.commit()
    return db


def index_file(db, cfg, f, st, row):
    """Read a transcript from where the index stopped (transcripts only grow) to its last whole line."""
    p = str(f)
    off = row[1] if row and row[2] == st.st_ino and st.st_size >= row[1] else 0
    if row and not off:
        db.execute("DELETE FROM msgs WHERE path=?", (p,))
    cwd, title, ai, first = row[3:7] if row and off else (None, None, None, None)
    rows = []
    with open(f, "rb") as fh:
        fh.seek(off)
        for raw in fh:
            if not raw.endswith(b"\n"):  # still being written
                break
            off += len(raw)
            if not WANTED.search(raw):
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            kind = rec.get("type") if isinstance(rec, dict) else None
            if kind == "custom-title":
                title = rec.get("customTitle") or title
            elif kind == "ai-title":
                ai = rec.get("aiTitle") or ai
            elif kind in ("user", "assistant") and not rec.get("isSidechain"):
                cwd = cwd or rec.get("cwd")
                text = said(rec)
                if text:
                    first = first or (" ".join(text.split())[:80] if kind == "user" else None)
                    rows.append((p, iso_ts(rec.get("timestamp")) or 0, kind, text))
    db.executemany("INSERT INTO msgs VALUES (?,?,?,?)", rows)
    db.execute("INSERT OR REPLACE INTO files VALUES (?,?,?,?,?,?,?,?,?,?)",
               (p, str(cfg), f.stem, cwd, title, ai, first, off, st.st_ino, st.st_mtime))


def index_update(db, extra=()):
    """Bring the index up to date. It holds the write lock a few files at a time, so searches see a first build fill
    in; while another process is writing, this one leaves it to that one."""
    import sqlite3

    def lock():
        try:
            db.execute("PRAGMA busy_timeout=3000")
            db.execute("BEGIN IMMEDIATE")
            return True
        except sqlite3.OperationalError:
            return False
    if not lock():
        return
    seen, done = set(), 0
    for cfg in cli_configs(extra):
        for f in cfg.glob("projects/*/*.jsonl"):
            try:
                st = f.stat()
            except OSError:
                continue
            seen.add(str(f))
            row = db.execute("SELECT path, off, ino, cwd, title, ai, first FROM files WHERE path=?", (str(f),)).fetchone()
            if not row or row[1] != st.st_size or row[2] != st.st_ino:
                try:
                    index_file(db, cfg, f, st, row)
                except OSError:
                    continue
                done += 1
                if done % 10 == 0:
                    db.commit()
                    if not lock():
                        return
    for (p,) in db.execute("SELECT path FROM files").fetchall():
        if p not in seen:
            db.execute("DELETE FROM msgs WHERE path=?", (p,))
            db.execute("DELETE FROM files WHERE path=?", (p,))
    db.commit()


def snippet(text, word, width=90):
    flat = " ".join(text.split())
    i = flat.casefold().find(word.casefold())
    if i < 0:
        return flat[:width]
    a = max(0, i - width // 3)
    return ("…" if a else "") + flat[a:a + width] + ("…" if a + width < len(flat) else "")


def find_sessions(words, extra=(), limit=20, acct=None, live=None):
    """Terminal sessions where every word was said (or is in the title), newest first, one row per session id."""
    db = index_db()
    try:
        if not db.execute("SELECT 1 FROM files LIMIT 1").fetchone():
            print(t("f_indexing"), file=sys.stderr, flush=True)
        index_update(db, extra)
        like = ["%" + w.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%" for w in words]
        hit = None
        for p in like:
            s = {r[0] for r in db.execute("SELECT DISTINCT path FROM msgs WHERE text LIKE ? ESCAPE '\\'", (p,))}
            s |= {r[0] for r in db.execute("SELECT path FROM files WHERE title LIKE ? ESCAPE '\\' OR ai LIKE ? ESCAPE '\\'", (p, p))}
            hit = s if hit is None else hit & s
        files = [db.execute("SELECT path, cfg, sid, cwd, title, ai, first, mtime FROM files WHERE path=?", (p,)).fetchone()
                 for p in hit or ()]
        files.sort(key=lambda r: r[7], reverse=True)
        nm, who, by_sid, lb = names(), {}, {}, labels()
        for path, cfg, sid, cwd, title, ai, first, mtime in files:
            if cfg not in who:
                a = cli_account(Path(cfg)) or ""
                who[cfg] = (a, nm.get(a, a[:8]))
            if acct and who[cfg][0] != acct:
                continue
            if sid in by_sid:
                if who[cfg][1] not in by_sid[sid]["also"] and who[cfg][1] != by_sid[sid]["name"]:
                    by_sid[sid]["also"].append(who[cfg][1])
                continue
            if len(by_sid) >= limit:
                continue
            m = db.execute("SELECT ts, role, text FROM msgs WHERE path=? AND text LIKE ? ESCAPE '\\' ORDER BY ts DESC LIMIT 1",
                           (path, like[0])).fetchone()
            by_sid[sid] = {"sid": sid, "acct": who[cfg][0], "name": who[cfg][1], "cfg": cfg, "cwd": cwd or "",
                           "project": short(Path(cwd)) if cwd else "", "title": lb.get(sid) or title or ai or first or t("untitled"),
                           "last": int(mtime * 1000), "said": m[1] if m else "", "snippet": snippet(m[2], words[0]) if m else "",
                           "also": [], "live": ""}
    finally:
        db.close()
    running = {r["sid"]: r for r in (live_sessions(extra) if live is None else live)}
    for r in by_sid.values():
        x = running.get(r["sid"])
        r["live"] = (x["tmux"] or f"pid {x['pid']}") if x else ""
    return list(by_sid.values())


def resume_text(cfg, cwd, sid):
    """The command that resumes a session by hand: its folder, its login."""
    from shlex import quote
    if WIN:
        return f"cd {ps_quote(cwd)}; " + env_cmd(Path(cfg), f"claude --resume {sid}")
    shown = short(Path(cwd))
    shown = "~/" + quote(shown[2:]) if shown.startswith("~/") else quote(shown)
    return f"cd {shown} && " + env_cmd(Path(cfg), f"claude --resume {sid}")


def index_quietly(extra=()):
    try:
        db = index_db()
        try:
            index_update(db, extra)
        finally:
            db.close()
    except Exception:
        pass


