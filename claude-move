KEEP_DAYS = 35
WEEK, FIVE_H = 7 * 86400, 5 * 3600
# $ per million input tokens; output, cache writes and cache reads scale from it as in the public price list
PRICE_IN = {"opus": 5.0, "fable": 5.0, "sonnet": 3.0, "haiku": 1.0}


def iso_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def api_dollars(model, u):
    fam = next((k for k in PRICE_IN if k in (model or "")), "opus")
    tokens = ((u.get("input_tokens") or 0) + 1.25 * (u.get("cache_creation_input_tokens") or 0)
              + 0.1 * (u.get("cache_read_input_tokens") or 0) + 5 * (u.get("output_tokens") or 0))
    return tokens * PRICE_IN[fam] / 1e6


def scan_file(path, start):
    """Usage and limit-hit records appended to one transcript since byte offset `start`."""
    recs, hits = [], []
    with open(path, "rb") as fh:
        fh.seek(start)
        data = fh.read()
    end = data.rfind(b"\n") + 1  # leave a half-written last line for the next run
    for raw in data[:end].splitlines():
        if b'"usage"' not in raw and b"usage_limit_reached" not in raw:
            continue
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        ts = iso_ts(rec.get("timestamp") or "")
        sid = rec.get("sessionId")
        if ts is None or not sid:
            continue
        ep = {"claude-desktop": "d", "cli": "c"}.get(rec.get("entrypoint"), "")
        info = (rec.get("apiErrorParams") or {}).get("rate_limit_info")
        if rec.get("apiError") == "usage_limit_reached" and isinstance(info, dict) and info.get("resetsAt"):
            hits.append([ts, sid, info.get("rateLimitType") or "", info["resetsAt"], ep])
            continue
        msg = rec.get("message") or {}
        u = msg.get("usage")
        if rec.get("type") == "assistant" and isinstance(u, dict) and msg.get("id") and msg.get("model") != "<synthetic>":
            recs.append([ts, sid, msg["id"], round(api_dollars(msg.get("model"), u), 6), ep])
    return recs, hits, start + end


def scan(roots):
    """Incrementally read transcripts under each root's projects/; cache per file by offset."""
    cache = load(CACHE) or {}
    if cache.get("v") != 2:
        cache = {"v": 2, "files": {}}
    files, cutoff, seen = cache["files"], time.time() - KEEP_DAYS * 86400, set()
    for root in roots:
        for p in (root / "projects").rglob("*.jsonl") if (root / "projects").is_dir() else []:
            try:
                st = p.stat()
            except OSError:
                continue
            if st.st_mtime < cutoff:
                continue
            key = str(p)
            seen.add(key)
            c = files.get(key)
            if not c or c["size"] > st.st_size or c.get("ino") != st.st_ino:
                c = files[key] = {"size": 0, "off": 0, "ino": st.st_ino, "recs": [], "hits": [], "root": str(root)}
            if st.st_size > c["off"]:
                recs, hits, off = scan_file(p, c["off"])
                c["recs"] += recs
                c["hits"] += hits
                c["off"], c["size"] = off, st.st_size
            c["recs"] = [r for r in c["recs"] if r[0] >= cutoff]
    for key in [k for k in files if k not in seen]:
        del files[key]
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(cache, separators=(",", ":")), encoding="utf-8")
    recs, hits, dedup = [], [], set()
    for c in files.values():
        for r in c["recs"]:
            if r[2] not in dedup:  # a reply is written once per content block, and resumed sessions copy history
                dedup.add(r[2])
                recs.append(r + [c["root"]])
        hits += [h + [c["root"]] for h in c["hits"]]
    return recs, hits


def cli_account(cfg):
    """Account id the CLI config folder is signed into (from its .claude.json; no tokens are read)."""
    p = HOME / ".claude.json" if cfg == HOME / ".claude" else cfg / ".claude.json"
    d = load(p)
    oa = d.get("oauthAccount") if isinstance(d, dict) else None
    return oa.get("accountUuid") if isinstance(oa, dict) else None


def signin_timeline():
    """When each account was signed into the desktop app, from the app's log lines that name the account it is
    looking up (`cacheKey=acct:<id>`). Only ids and times are read. Returns [(epoch, account id)] at each change."""
    import re
    pat = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) .*?cacheKey=acct:([0-9a-f-]{36})")
    points = []
    for f in sorted(LOGS.glob("main*.log")) if LOGS.is_dir() else []:
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if "cacheKey=acct:" in line:
                        m = pat.match(line)
                        if m:
                            points.append((time.mktime(time.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")), m.group(2)))
        except OSError:
            continue
    points.sort()
    out = []
    for ts, acct in points:
        if not out or out[-1][1] != acct:
            out.append((ts, acct))
    return out


def signed_in(timeline, ts):
    if not timeline or ts < timeline[0][0] - 3600:
        return None
    acct = None
    for start, a in timeline:
        if start > ts:
            break
        acct = a
    return acct or timeline[0][1]


def owner_index(accts):
    """cliSessionId -> [(lastActivityAt seconds, account id)], one entry per account list holding the session."""
    idx = {}
    for a in accts:
        for _, d in a["sessions"]:
            if d.get("cliSessionId"):
                idx.setdefault(d["cliSessionId"], []).append(((d.get("lastActivityAt") or 0) / 1000, a["acct"]))
    for v in idx.values():
        v.sort()
    return idx


def owner(idx, sid, ts, fallback):
    """A session copied between accounts sits in several lists. The desktop app only bumps lastActivityAt in the
    account that is signed in, so a reply belongs to the first account whose entry was last active at or after it."""
    cands = idx.get(sid)
    if not cands:
        return fallback
    for last, acct in cands:
        if last >= ts - 60:
            return acct
    return cands[-1][1]


def week_window(hits7, now):
    """Weekly windows reset at a fixed time; step the last known reset forward to find the current one."""
    if not hits7:
        return None, None
    r = max(h[3] for h in hits7)
    if now < r:
        return r - WEEK, r
    n = int((now - r) // WEEK)
    return r + n * WEEK, r + (n + 1) * WEEK


