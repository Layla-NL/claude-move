NO_WINDOW = 0x08000000  # Windows: CREATE_NO_WINDOW, so helper commands do not flash a console
APP_EXE = []  # Windows: where the desktop app ran from, to start it again


def quit_app():
    cmd = os.environ.get("CLAUDE_MOVE_QUIT_CMD")
    if cmd:
        subprocess.run(cmd, shell=True)
    elif WIN:
        # nothing outside it can ask it to quit: its close button and a plain taskkill only hide it in the
        # notification area (tried on Windows 11, Store build), so end its process tree as its tray Quit would
        mains, procs = app_pids()
        APP_EXE[:] = [procs[pid][1] for pid in mains][:1]
        for pid in mains:
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], capture_output=True, creationflags=NO_WINDOW)
    else:
        subprocess.run(["osascript", "-e", 'tell application "Claude" to quit'], check=False)
    for _ in range(60):
        if not app_running():
            return True
        time.sleep(0.5)
    return False


def open_app():
    cmd = os.environ.get("CLAUDE_MOVE_OPEN_CMD")
    if cmd:
        subprocess.run(cmd, shell=True)
    elif WIN:
        stub = Path(os.environ.get("LOCALAPPDATA") or HOME / "AppData/Local") / "AnthropicClaude" / "claude.exe"
        if stub.exists():  # the installer build's launcher, which starts its newest version
            spawn([str(stub)])
            return
        # the Store build has no launcher on disk to run; start it the way the Start menu does
        ps = ("$a = (Get-StartApps | Where-Object { $_.Name -eq 'Claude' } | Select-Object -First 1).AppID; "
              "if ($a) { Start-Process ('shell:AppsFolder\\' + $a); exit 0 }; exit 1")
        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                           capture_output=True, creationflags=NO_WINDOW)
        if r.returncode != 0 and APP_EXE:
            spawn(APP_EXE[:1])
    else:
        subprocess.run(["open", "-a", "Claude"], check=False)


def spawn(cmd):
    """Start cmd on its own, so it outlives this process and the desktop app."""
    kw = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not WIN:
        return subprocess.Popen(cmd, start_new_session=True, **kw)
    flags = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    try:
        return subprocess.Popen(cmd, creationflags=flags | 0x01000000, **kw)  # and out of the app's job
    except OSError:
        return subprocess.Popen(cmd, creationflags=flags, **kw)


def open_path(x):
    """Open a file, folder or URL the way a double-click would."""
    if WIN:
        os.startfile(str(x))
    elif sys.platform == "darwin":
        subprocess.run(["open", str(x)], check=False)


